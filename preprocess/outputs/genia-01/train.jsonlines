{"tokens": ["Both", "compounds", "modulate", "the", "growth", "of", "purified", "FL", "HPCs", ",", "which", "show", "a", "dose-dependent", "shift", "from", "mixed", "/", "erythroid", "/", "monocytic", "to", "granulocytic", "colony", "formation", "."], "doc_id": "MEDLINE:97028169", "sent_id": "MEDLINE:97028169-5", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "cell_type", "text": "HPCs"}, {"start": 6, "end": 9, "entity_type": "cell_line", "text": "purified FL HPCs"}]}
