{"tokens": ["Constitutive", "expression", "of", "human", "colony-stimulating", "factor-1", "receptor", "(", "CSF-1R", ")", "confers", "long-lasting", "CSF-1", "-dependent", "proliferation", "to", "mouse", "myeloid", "cell", "lines", "."], "doc_id": "MEDLINE:99120322", "sent_id": "MEDLINE:99120322-1", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "protein", "text": "human colony-stimulating factor-1 receptor"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "CSF-1R"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "CSF-1"}, {"start": 16, "end": 20, "entity_type": "cell_line", "text": "mouse myeloid cell lines"}]}
