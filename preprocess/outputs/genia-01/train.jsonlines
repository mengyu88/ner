{"tokens": ["In", "order", "to", "delineate", "the", "tissue-specific", "mechanisms", "governing", "the", "control", "of", "nonpituitary", "PRL", "gene", "expression", ",", "we", "have", "cloned", "and", "sequenced", "3", "kb", "5'-flanking", "DNA", "of", "the", "upstream", "decidual/lymphoid", "(", "dPRL", ")", "promoter", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-2", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "DNA", "text": "PRL gene"}, {"start": 21, "end": 25, "entity_type": "DNA", "text": "3 kb 5'-flanking DNA"}, {"start": 28, "end": 33, "entity_type": "DNA", "text": "decidual/lymphoid ( dPRL ) promoter"}]}
{"tokens": ["Based", "on", "sequence", "homology", "we", "identified", "two", "binding", "motifs", "for", "Pit-1", "and", "seven", "half-sites", "for", "glucocorticoid", "receptor/progesterone", "receptor", "(", "PR", ")", "binding", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-3", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "DNA", "text": "binding motifs"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "Pit-1"}, {"start": 13, "end": 14, "entity_type": "DNA", "text": "half-sites"}, {"start": 15, "end": 18, "entity_type": "protein", "text": "glucocorticoid receptor/progesterone receptor"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "PR"}]}
{"tokens": ["We", "focused", "our", "studies", "on", "the", "role", "of", "Pit-1", "and", "of", "PR", "as", "potential", "transcriptional", "regulators", ",", "since", "the", "POU", "domain", "protein", "Pit-1", "is", "essential", "in", "the", "control", "of", "pituitary", "PRL", "expression", ",", "and", "progesterone", "induces", "decidual", "transformation", "of", "the", "endometrial", "stroma", ",", "a", "differentiation", "process", "during", "which", "the", "decidual", "PRL", "gene", "is", "activated", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-4", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "DNA", "text": "Pit-1"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "Pit-1"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "PR"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "transcriptional regulators"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "POU domain protein"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "Pit-1"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "PRL"}, {"start": 50, "end": 52, "entity_type": "DNA", "text": "PRL gene"}]}
{"tokens": ["We", "demonstrate", "in", "a", "variety", "of", "cell", "types", ",", "including", "lymphocytes", "and", "endometrial", "stroma", ",", "that", "Pit-1", "is", "not", "involved", "in", "the", "regulation", "of", "dPRL", "promoter/reporter", "gene", "constructs", "carrying", "3", "kb", "5'-flanking", "DNA", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-5", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "cell_type", "text": "lymphocytes"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "Pit-1"}, {"start": 24, "end": 28, "entity_type": "DNA", "text": "dPRL promoter/reporter gene constructs"}, {"start": 29, "end": 33, "entity_type": "DNA", "text": "3 kb 5'-flanking DNA"}]}
{"tokens": ["Our", "experiments", "also", "show", "that", "activated", "PR", "does", "not", "confer", "direct", "transcriptional", "control", "on", "the", "dPRL", "promoter", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-6", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "PR"}, {"start": 15, "end": 17, "entity_type": "DNA", "text": "dPRL promoter"}]}
{"tokens": ["When", "we", "compared", "the", "activity", "of", "the", "transfected", "dPRL", "promoter", "in", "PRL-", "secreting", "and", "nonsecreting", "lymphoid", "cells", ",", "we", "found", "that", "the", "3", "kb", "5'-flanking", "region", "of", "the", "dPRL", "promoter", "did", "not", "contain", "elements", "restricting", "expression", "to", "only", "those", "lymphocytes", "that", "produce", "PRL", "but", "allowed", "expression", "of", "fusion", "reporter", "genes", "irrespective", "of", "the", "status", "of", "the", "endogenous", "PRL", "gene", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-7", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "DNA", "text": "dPRL promoter"}, {"start": 22, "end": 26, "entity_type": "DNA", "text": "3 kb 5'-flanking region"}, {"start": 28, "end": 30, "entity_type": "DNA", "text": "dPRL promoter"}, {"start": 39, "end": 40, "entity_type": "cell_type", "text": "lymphocytes"}, {"start": 57, "end": 58, "entity_type": "protein", "text": "PRL"}, {"start": 57, "end": 59, "entity_type": "DNA", "text": "PRL gene"}]}
{"tokens": ["This", "was", "in", "sharp", "contrast", "to", "endometrial", "cells", "where", "3", "kb", "5'-flanking", "DNA", "conferred", "strong", "transcriptional", "activation", "on", "the", "dPRL", "promoter", "in", "decidualized", "endometrial", "stromal", "cells", "actively", "secreting", "PRL", ",", "but", "did", "not", "allow", "transcription", "in", "undifferentiated", "non-PRL-secreting", "endometrial", "stromal", "cells", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-8", "entity_mentions": [{"start": 19, "end": 21, "entity_type": "DNA", "text": "dPRL promoter"}, {"start": 23, "end": 26, "entity_type": "cell_type", "text": "endometrial stromal cells"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "PRL"}, {"start": 37, "end": 41, "entity_type": "cell_type", "text": "non-PRL-secreting endometrial stromal cells"}]}
{"tokens": ["Activation", "of", "the", "dPRL", "promoter", "construct", "in", "these", "undifferentiated", "cells", "could", "however", "be", "induced", "by", "the", "addition", "of", "cAMP", ",", "in", "the", "absence", "of", "progesterone", ",", "suggesting", "that", "a", "signal", "transduced", "through", "the", "cAMP", "signaling", "pathway", "is", "a", "primary", "inducer", "of", "decidual", "PRL", "gene", "expression", "."], "doc_id": "MEDLINE:94285937", "sent_id": "MEDLINE:94285937-9", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "DNA", "text": "dPRL promoter"}, {"start": 42, "end": 44, "entity_type": "DNA", "text": "PRL gene"}]}
