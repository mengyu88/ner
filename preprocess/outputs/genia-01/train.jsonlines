{"tokens": ["In", "fact", ",", "the", "offspring", "of", "alcoholics", "have", "higher", "levels", "of", "G(S)alpha", "expression", "in", "certain", "tissues", "compared", "with", "the", "offspring", "of", "nonalcoholics", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-2", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "G(S)alpha"}]}
{"tokens": ["The", "aim", "of", "this", "research", "was", "to", "test", "the", "hypothesis", "that", "a", "causal", "relationship", "exists", "between", "the", "level", "of", "expression", "of", "G(S)alpha", "and", "induction", "of", "the", "adenylyl", "cyclase", "(", "AC", ")", "cascade", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-3", "entity_mentions": [{"start": 21, "end": 22, "entity_type": "protein", "text": "G(S)alpha"}, {"start": 26, "end": 28, "entity_type": "protein", "text": "adenylyl cyclase"}]}
{"tokens": ["The", "methodology", "employed", "transient", "transfection", "of", "HEK", "293", "cells", "with", "a", "cDNA", "for", "the", "52-kDa", "form", "of", "G(S)alpha", "under", "regulation", "by", "inducible", "metallothionein", "promoters", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-4", "entity_mentions": [{"start": 6, "end": 9, "entity_type": "cell_line", "text": "HEK 293 cells"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "G(S)alpha"}, {"start": 21, "end": 24, "entity_type": "DNA", "text": "inducible metallothionein promoters"}]}
{"tokens": ["Transfectants", "were", "exposed", "to", "varying", "concentrations", "(", "0-125", "microM", ")", "of", "zinc", "sulfate", "that", "produced", "a", "3-fold", "range", "of", "membrane", "G(S)alpha", "expression", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-5", "entity_mentions": [{"start": 20, "end": 21, "entity_type": "protein", "text": "G(S)alpha"}]}
{"tokens": ["The", "range", "of", "G(S)alpha", "expression", "produced", "was", "found", "to", "mimic", "a", "physiologically", "relevant", "spectrum", "of", "G(S)alpha", "expression", "in", "membranes", "derived", "from", "human", "tissues", "and", "rat", "brain", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-6", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "G(S)alpha"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "G(S)alpha"}]}
{"tokens": ["It", "was", "observed", "that", "induction", "of", "G(S)alpha", "expression", "increased", "constitutive", "as", "well", "as", "stimulated", "cAMP", "accumulation", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-7", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "G(S)alpha"}]}
{"tokens": ["Moreover", ",", "induction", "of", "G(S)alpha", "expression", "increased", "events", "distal", "to", "the", "accumulation", "of", "cAMP", "including", "the", "phosphorylation", "of", "the", "transcription", "factor", ",", "cAMP", "response", "element", "binding", "protein", "and", "transcriptional", "activation", "of", "cAMP-dependent", "reporter", "genes", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-8", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "G(S)alpha"}, {"start": 22, "end": 27, "entity_type": "protein", "text": "cAMP response element binding protein"}, {"start": 31, "end": 34, "entity_type": "DNA", "text": "cAMP-dependent reporter genes"}]}
{"tokens": ["In", "summary", ",", "these", "studies", "show", "that", "the", "amount", "of", "G(S)alpha", "expression", "has", "a", "marked", "impact", "on", "the", "level", "of", "activity", "of", "the", "AC", "cascade", "from", "the", "membrane", "through", "to", "the", "nucleus", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-9", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "G(S)alpha"}]}
{"tokens": ["It", "is", "hypothesized", "that", "individuals", "who", "differ", "in", "G(S)alpha", "expression", "may", "also", "differ", "in", "the", "expression", "of", "certain", "cAMP", "-dependent", "genes", "."], "doc_id": "MEDLINE:97355572", "sent_id": "MEDLINE:97355572-10", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "G(S)alpha"}, {"start": 18, "end": 21, "entity_type": "DNA", "text": "cAMP -dependent genes"}]}
