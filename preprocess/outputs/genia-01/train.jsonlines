{"tokens": ["Early", "studies", "in", "murine", "T", "cell", "lines", "indicated", "that", "transcriptional", "transactivation", "functions", "encoded", "in", "the", "glucocorticoid", "receptor", "(", "GR", ")", "N-terminal", "domain", "are", "required", "for", "glucocorticoid", "-mediated", "apoptosis", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-1", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "cell_line", "text": "T cell lines"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "GR"}, {"start": 15, "end": 22, "entity_type": "protein", "text": "glucocorticoid receptor ( GR ) N-terminal domain"}]}
{"tokens": ["However", ",", "more", "recent", "studies", "in", "human", "T", "cell", "lines", "have", "suggested", "that", "the", "N-terminal", "domain", "is", "not", "necessary", "for", "steroid-regulated", "apoptosis", "and", "that", "GR", "-mediated", "transrepression", "may", "be", "the", "more", "critical", "mechanism", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-2", "entity_mentions": [{"start": 7, "end": 10, "entity_type": "cell_line", "text": "T cell lines"}, {"start": 6, "end": 10, "entity_type": "cell_line", "text": "human T cell lines"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "N-terminal domain"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "GR"}]}
{"tokens": ["To", "better", "understand", "the", "contribution", "of", "the", "GR", "N-terminal", "transactivation", "domain", "in", "mediating", "murine", "thymocyte", "apoptosis", ",", "we", "stably", "transfected", "GR", ",", "GR", "variants", ",", "and", "the", "androgen", "receptor", "(", "AR", ")", "into", "receptor-negative", "S49", "murine", "thymoma", "cells", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-3", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "GR"}, {"start": 7, "end": 11, "entity_type": "protein", "text": "GR N-terminal transactivation domain"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "GR"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "GR"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "GR variants"}, {"start": 27, "end": 29, "entity_type": "protein", "text": "androgen receptor"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "AR"}, {"start": 35, "end": 38, "entity_type": "cell_type", "text": "murine thymoma cells"}, {"start": 33, "end": 38, "entity_type": "cell_line", "text": "receptor-negative S49 murine thymoma cells"}]}
{"tokens": ["GR", "expression", "levels", "were", "shown", "to", "be", "rate-limiting", "for", "initiating", "the", "apoptotic", "pathway", ",", "and", "a", "positive", "correlation", "between", "steroid", "sensitivity", "and", "GR", "-mediated", "induction", "of", "an", "integrated", "mouse", "mammary", "tumor", "virus", "(", "MMTV", ")", "LTR", "reporter", "gene", "was", "observed", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "GR"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "GR"}, {"start": 28, "end": 38, "entity_type": "DNA", "text": "mouse mammary tumor virus ( MMTV ) LTR reporter gene"}]}
{"tokens": ["Analysis", "of", "GR", "chimeric", "receptors", "containing", "the", "potent", "VP16", "and", "E1A", "viral", "transactivation", "domains", "in", "place", "of", "the", "GR", "N", "terminus", "revealed", "that", "even", "low", "level", "expression", "of", "these", "receptors", "resulted", "in", "both", "enhanced", "steroid", "sensitivity", "and", "MMTV", "induction", ",", "thus", "supporting", "a", "role", "for", "transactivation", "in", "apoptosis", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "GR"}, {"start": 2, "end": 5, "entity_type": "protein", "text": "GR chimeric receptors"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "GR"}, {"start": 18, "end": 21, "entity_type": "protein", "text": "GR N terminus"}]}
