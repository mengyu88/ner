{"tokens": ["Upon", "activation", "of", "Jurkat", "T", "cells", "and", "primary", "murine", "thymocytes", "with", "phorbol", "esters", "and", "ionomycin", ",", "BOB.1/OBF.1", "expression", "and", "transactivation", "function", "were", "induced", "."], "doc_id": "MEDLINE:97362321", "sent_id": "MEDLINE:97362321-2", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "cell_line", "text": "Jurkat T cells"}, {"start": 7, "end": 10, "entity_type": "cell_type", "text": "primary murine thymocytes"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "BOB.1/OBF.1"}]}
{"tokens": ["BOB.1/OBF.1", "was", "phosphorylated", "at", "Ser184", "both", "in", "vivo", "and", "in", "vitro", ",", "and", "this", "modification", "was", "required", "for", "inducible", "activation", "."], "doc_id": "MEDLINE:97362321", "sent_id": "MEDLINE:97362321-3", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "BOB.1/OBF.1"}]}
