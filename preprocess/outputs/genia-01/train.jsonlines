{"tokens": ["In", "this", "study", ",", "therefore", ",", "the", "human", "monoblastic", "leukemia", "cell", "line", "U937", "has", "been", "used", "as", "a", "model", "system", "to", "investigate", "the", "role", "of", "one", "of", "the", "RXRs", ",", "RXR-alpha", ",", "in", "monoblast", "differentiation", "."], "doc_id": "MEDLINE:98005040", "sent_id": "MEDLINE:98005040-3", "entity_mentions": [{"start": 7, "end": 13, "entity_type": "cell_line", "text": "human monoblastic leukemia cell line U937"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "RXRs"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "RXR-alpha"}]}
