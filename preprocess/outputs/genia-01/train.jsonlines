{"tokens": ["Using", "Scatchard", "analysis", ",", "we", "have", "determined", "the", "dissociation", "constants", "of", "homodimeric", "p49", "and", "heterodimeric", "p49/p65", "for", "binding", "to", "the", "HIV", "kappa", "B", "site", "."], "doc_id": "MEDLINE:93180775", "sent_id": "MEDLINE:93180775-5", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "protein", "text": "homodimeric p49"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "heterodimeric p49/p65"}, {"start": 21, "end": 24, "entity_type": "DNA", "text": "kappa B site"}, {"start": 20, "end": 24, "entity_type": "DNA", "text": "HIV kappa B site"}]}
{"tokens": ["p49", "has", "a", "approximately", "18-fold-lower", "affinity", "for", "the", "HIV", "kappa", "B", "site", "(", "KD", "=", "69.1", "pM", ")", "than", "does", "the", "approximately", "50-kDa", "protein", "NFKB1", "(", "p50", ")", "derived", "from", "p105", "(", "KD", "=", "3.9", "pM", ")", "."], "doc_id": "MEDLINE:93180775", "sent_id": "MEDLINE:93180775-6", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "p49"}, {"start": 9, "end": 12, "entity_type": "DNA", "text": "kappa B site"}, {"start": 24, "end": 28, "entity_type": "protein", "text": "NFKB1 ( p50 )"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "p105"}]}
{"tokens": ["In", "contrast", ",", "the", "affinity", "of", "heterodimeric", "NFKB2", "(", "p49", ")", "/", "RelA", "(", "p65", ")", "for", "this", "site", "is", "approximately", "6-fold", "higher", "(", "KD", "=", "11.8", "pM", ")", "than", "that", "of", "p49", "alone", "."], "doc_id": "MEDLINE:93180775", "sent_id": "MEDLINE:93180775-7", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "NFKB2"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "p49"}, {"start": 12, "end": 16, "entity_type": "protein", "text": "RelA ( p65 )"}, {"start": 6, "end": 16, "entity_type": "protein", "text": "heterodimeric NFKB2 ( p49 ) / RelA ( p65 )"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "p49"}]}
{"tokens": ["Consistent", "with", "these", "findings", ",", "in", "vitro", "transcription", "was", "stimulated", "18-fold", "by", "the", "addition", "of", "preformed", ",", "heterodimeric", "NFKB2", "(", "p49", ")", "/", "RelA", "(", "p65", ")", "protein", "."], "doc_id": "MEDLINE:93180775", "sent_id": "MEDLINE:93180775-8", "entity_mentions": [{"start": 18, "end": 19, "entity_type": "protein", "text": "NFKB2"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "p49"}, {"start": 23, "end": 27, "entity_type": "protein", "text": "RelA ( p65 )"}, {"start": 17, "end": 28, "entity_type": "protein", "text": "heterodimeric NFKB2 ( p49 ) / RelA ( p65 ) protein"}]}
{"tokens": ["Transcriptional", "activation", "of", "the", "HIV", "enhancer", "was", "also", "subject", "to", "regulation", "by", "recently", "cloned", "I", "kappa", "B-alpha", "(", "MAD-3", ")", "."], "doc_id": "MEDLINE:93180775", "sent_id": "MEDLINE:93180775-9", "entity_mentions": [{"start": 14, "end": 17, "entity_type": "protein", "text": "I kappa B-alpha"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "MAD-3"}]}
