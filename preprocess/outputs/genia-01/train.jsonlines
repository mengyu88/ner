{"tokens": ["Using", "these", "drugs", "as", "probes", ",", "chemists", "and", "biologists", "have", "uncovered", "several", "intracellular", "signalling", "molecules", "bridging", "the", "generation", "of", "second-messenger", "Ca2+", "ions", "and", "the", "transcriptional", "activation", "of", "IL-2", ",", "among", "which", "are", "calmodulin", ",", "calcineurin", "and", "the", "nuclear", "factor", "of", "activated", "T", "cells", "(", "NF-AT", ")", "."], "doc_id": "MEDLINE:94025289", "sent_id": "MEDLINE:94025289-2", "entity_mentions": [{"start": 27, "end": 28, "entity_type": "protein", "text": "IL-2"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "calmodulin"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "calcineurin"}, {"start": 41, "end": 43, "entity_type": "cell_type", "text": "T cells"}, {"start": 40, "end": 43, "entity_type": "cell_type", "text": "activated T cells"}, {"start": 37, "end": 43, "entity_type": "protein", "text": "nuclear factor of activated T cells"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "NF-AT"}]}
