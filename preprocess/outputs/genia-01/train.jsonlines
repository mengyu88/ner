{"tokens": ["While", "Jurkat", "cells", "both", "secrete", "and", "respond", "to", "IFN-gamma", "in", "an", "autocrine", "loop", ",", "it", "seems", "likely", "that", "the", "responding", "cells", "may", "differ", "from", "those", "synthesizing", "this", "cytokine", "in", "the", "mononuclear", "cell", "cultures", "in", "the", "light", "of", "the", "recent", "report", "that", "Th1", "cells", "lack", "the", "IFN-gamma", "receptor", "chain", "necessary", "for", "activation", "of", "STAT1", "(", "Pernis", ",", "A.", ",", "Gupta", ",", "S.", ",", "Gollob", ",", "K.J.", ",", "Garfein", ",", "E.", ",", "Coffman", ",", "R.L.", ",", "Schindler", ",", "C.", ",", "and", "Rothman", ",", "P.", ",", "Science", "1995", ".", "269", ":", "245", ")", "."], "doc_id": "MEDLINE:96182305", "sent_id": "MEDLINE:96182305-8", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "cytokine"}, {"start": 30, "end": 33, "entity_type": "cell_line", "text": "mononuclear cell cultures"}, {"start": 41, "end": 43, "entity_type": "cell_line", "text": "Th1 cells"}, {"start": 45, "end": 46, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 52, "end": 53, "entity_type": "protein", "text": "STAT1"}]}
