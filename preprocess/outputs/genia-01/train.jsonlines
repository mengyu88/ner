{"tokens": ["Cytosols", "were", "prepared", "from", "lymphocytes", "of", "24", "healthy", "pregnant", "women", "(", "11", "first", ",", "10", "second", "and", "three", "third", "trimester", ")", ",", "seven", "healthy", "non-pregnant", "women", ",", "nine", "women", "with", "recurrent", "spontaneous", "abortion", ",", "and", "six", "healthy", "men", "."], "doc_id": "MEDLINE:95081342", "sent_id": "MEDLINE:95081342-2", "entity_mentions": []}
{"tokens": ["In", "addition", ",", "a", "human", "breast", "carcinoma", "cell", "line", "(", "ZR-75-1", ")", ",", "which", "expresses", "the", "progesterone", "receptor", ",", "was", "analysed", "throughout", "."], "doc_id": "MEDLINE:95081342", "sent_id": "MEDLINE:95081342-3", "entity_mentions": [{"start": 4, "end": 9, "entity_type": "cell_line", "text": "human breast carcinoma cell line"}, {"start": 10, "end": 11, "entity_type": "cell_line", "text": "ZR-75-1"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "progesterone receptor"}]}
{"tokens": ["The", "ZR-75-1", "cell", "line", "showed", "an", "expression", "of", "642", "fmol/mg", "whereas", "lymphocytes", "of", "pregnant", "women", "showed", "an", "expression", "<", "or", "=", "4", "fmol/mg", "."], "doc_id": "MEDLINE:95081342", "sent_id": "MEDLINE:95081342-4", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "cell_line", "text": "ZR-75-1 cell line"}]}
{"tokens": ["Lymphocytes", "of", "non-pregnant", "women", ",", "women", "with", "threatened", "pre-term", "delivery", ",", "and", "men", "showed", "equivalent", "levels", ":", "3", "+/-", "1", ",", "3", "+/-", "2", "and", "5", "+/-", "4", "fmol/mg", "respectively", "."], "doc_id": "MEDLINE:95081342", "sent_id": "MEDLINE:95081342-5", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "cell_type", "text": "Lymphocytes"}]}
