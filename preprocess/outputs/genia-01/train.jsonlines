{"tokens": ["Clinical", "CR", "was", "achieved", "in", "nine", "of", "10", "(", "90", "%", ")", "patients", "treated", "with", "As2O3", "alone", "and", "in", "the", "remaining", "five", "patients", "treated", "by", "the", "combination", "of", "As2O3", "and", "low-dose", "chemotherapeutic", "drugs", "or", "ATRA", "."], "doc_id": "MEDLINE:97275148", "sent_id": "MEDLINE:97275148-4", "entity_mentions": []}
