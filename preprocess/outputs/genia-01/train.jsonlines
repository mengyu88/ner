{"tokens": ["We", "have", "isolated", "NFATx", ",", "which", "is", "one", "of", "four", "members", "of", "the", "NFAT", "family", "of", "transcription", "factors", "and", "is", "preferentially", "expressed", "in", "the", "thymus", "and", "peripheral", "blood", "leukocytes", ",", "and", "an", "isoform", "of", "NFATx", ",", "NFATx1", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-2", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "NFATx"}, {"start": 13, "end": 15, "entity_type": "protein", "text": "NFAT family"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "transcription factors"}, {"start": 26, "end": 29, "entity_type": "cell_type", "text": "peripheral blood leukocytes"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "NFATx"}, {"start": 36, "end": 37, "entity_type": "protein", "text": "NFATx1"}]}
