{"tokens": ["In", "this", "report", ",", "we", "demonstrate", "that", "engagement", "of", "the", "TCR", "results", "in", "tyrosine", "phosphorylation", "of", "SLP-76", "in", "its", "amino-terminal", "acidic", "region", "."], "doc_id": "MEDLINE:97047763", "sent_id": "MEDLINE:97047763-2", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "TCR"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "SLP-76"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "amino-terminal acidic region"}]}
