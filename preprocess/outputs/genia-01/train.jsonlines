{"tokens": ["Although", "mutation", "of", "either", "Y113", "and", "Y128", "has", "a", "minimal", "effect", "on", "SLP-76", "function", ",", "mutation", "of", "both", "residues", "decreases", "significantly", "the", "ability", "of", "SLP-76", "to", "promote", "T", "cell", "activation", "."], "doc_id": "MEDLINE:97047763", "sent_id": "MEDLINE:97047763-4", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "SLP-76"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "SLP-76"}]}
