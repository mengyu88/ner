{"tokens": ["The", "first", "early-induced", "peak", "was", "transient", "and", "likely", "corresponds", "to", "the", "well", "documented", "typical", "junB", "mRNA", ",", "stimulated", "in", "response", "to", "numerous", "growth", "factors", ",", "including", "IL-6", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-3", "entity_mentions": [{"start": 14, "end": 16, "entity_type": "RNA", "text": "junB mRNA"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "growth factors"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "IL-6"}]}
{"tokens": ["At", "variance", ",", "the", "second", "peak", "which", "has", "never", "been", "reported", "previously", ",", "lasted", "several", "hours", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-4", "entity_mentions": []}
{"tokens": ["As", "a", "consequence", "of", "its", "effect", "on", "junB", "mRNA", ",", "IL-6", "stimulated", ",", "in", "a", "biphasic", "fashion", ",", "the", "nuclear", "accumulation", "of", "the", "JunB", "protein", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-5", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "RNA", "text": "junB mRNA"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-6"}, {"start": 23, "end": 25, "entity_type": "protein", "text": "JunB protein"}]}
{"tokens": ["In", "this", "study", ",", "we", "demonstrated", "that", "IL-6", "regulation", "occurred", "exclusively", "at", "the", "transcriptional", "level", "and", "that", "the", "bimodal", "increase", "of", "junB", "mRNA", "and", "JunB", "protein", "can", "be", "accounted", "for", "by", "a", "biphasic", "stimulation", "of", "junB", "transcription", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-6", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "IL-6"}, {"start": 21, "end": 23, "entity_type": "RNA", "text": "junB mRNA"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "JunB protein"}, {"start": 35, "end": 36, "entity_type": "DNA", "text": "junB"}]}
{"tokens": ["Furthermore", ",", "our", "data", "point", "to", "two", "major", "differences", "between", "the", "mechanism", "of", "control", "of", "the", "early", "and", "the", "late", "IL-6", "-induced", "junB", "transcription", "waves", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-7", "entity_mentions": [{"start": 20, "end": 21, "entity_type": "protein", "text": "IL-6"}, {"start": 22, "end": 23, "entity_type": "DNA", "text": "junB"}]}
{"tokens": ["First", ",", "cycloheximide", "strongly", "potentiated", "the", "transcription", "of", "the", "second", "wave", ",", "whereas", "it", "failed", "to", "affect", "the", "early-induced", "burst", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-8", "entity_mentions": []}
