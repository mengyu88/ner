{"tokens": ["The", "hydrophobic", "domain", "is", "homologous", "to", "three", "yeast", "polypeptides", ",", "suggesting", "that", "this", "higher", "eukaryotic", "gene", "could", "have", "evolved", "from", "recombination", "between", "a", "gene", "that", "encoded", "a", "soluble", "nuclear", "protein", "and", "a", "membrane", "protein", "gene", "similar", "to", "those", "in", "yeast", "."], "doc_id": "MEDLINE:94209308", "sent_id": "MEDLINE:94209308-7", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "protein", "text": "hydrophobic domain"}, {"start": 13, "end": 16, "entity_type": "DNA", "text": "higher eukaryotic gene"}, {"start": 27, "end": 30, "entity_type": "protein", "text": "soluble nuclear protein"}, {"start": 32, "end": 34, "entity_type": "protein", "text": "membrane protein"}, {"start": 32, "end": 35, "entity_type": "DNA", "text": "membrane protein gene"}]}
