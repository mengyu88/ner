{"tokens": ["Previous", "reports", "have", "suggested", "the", "CD28", "stimulation", "contributes", "to", "the", "activation", "of", "the", "IL-2", "promoter", "by", "up-regulating", "the", "activity", "of", "several", "transcription", "factors", ",", "including", "AP-1", "and", "nuclear", "factor-kappaB", "(", "NF-kappaB", ")", "/", "Rel", "family", "members", "as", "well", "as", "an", "uncharacterized", "transcription", "factor", "called", "CD28", "response", "complex", "."], "doc_id": "MEDLINE:97376857", "sent_id": "MEDLINE:97376857-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "CD28"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IL-2"}, {"start": 13, "end": 15, "entity_type": "DNA", "text": "IL-2 promoter"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "transcription factors"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "AP-1"}, {"start": 27, "end": 29, "entity_type": "protein", "text": "nuclear factor-kappaB"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "Rel"}, {"start": 27, "end": 36, "entity_type": "protein", "text": "nuclear factor-kappaB ( NF-kappaB ) / Rel family members"}, {"start": 40, "end": 43, "entity_type": "protein", "text": "uncharacterized transcription factor"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "CD28"}]}
