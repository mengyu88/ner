{"tokens": ["With", "these", "clones", ",", "we", "demonstrated", "that", "NFAT", "activation", "induced", "by", "phorbol", "12-myristate", "13-acetate", "and", "ionomycin", "was", "inhibited", "by", "both", "cyclosporin", "A", "(", "CsA", ")", "(", "IC50", "=", "8", "nM", ")", "and", "FK506", "(", "IC50", "=", "160", "pM", ")", ",", "presumably", "by", "inhibition", "of", "calcineurin", "activity", "."], "doc_id": "MEDLINE:96190675", "sent_id": "MEDLINE:96190675-3", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "NFAT"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "calcineurin"}]}
{"tokens": ["Selective", "phosphatase", "inhibitors", "for", "protein", "phosphatase", "1", "(", "PP1", ")", "and", "2A", "(", "PP2A", ")", "that", "do", "not", "inhibit", "calcineurin", ",", "such", "as", "okadaic", "acid", "and", "calyculin", "A", ",", "also", "inhibited", "NFAT", "activation", "with", "IC50s", "of", "87", "nM", "and", "4", "nM", ",", "respectively", ",", "suggesting", "that", "okadaic", "acid", "and", "related", "inhibitors", "may", "block", "NFAT", "activation", "through", "the", "inhibition", "of", "PP1", ",", "instead", "of", "PP2A", "."], "doc_id": "MEDLINE:96190675", "sent_id": "MEDLINE:96190675-4", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "protein", "text": "protein phosphatase 1"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "PP1"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "2A"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "PP2A"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "calcineurin"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "NFAT"}, {"start": 53, "end": 54, "entity_type": "protein", "text": "NFAT"}, {"start": 59, "end": 60, "entity_type": "protein", "text": "PP1"}, {"start": 63, "end": 64, "entity_type": "protein", "text": "PP2A"}]}
