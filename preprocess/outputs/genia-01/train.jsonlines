{"tokens": ["Analyses", "of", "the", "primary", "amino", "acid", "sequence", "of", "the", "activation", "domain", "predict", "the", "presence", "of", "three", "alpha-helices", ",", "each", "with", "a", "high", "proportion", "of", "acidic", "residues", "."], "doc_id": "MEDLINE:97315348", "sent_id": "MEDLINE:97315348-3", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "protein", "text": "primary amino acid sequence"}, {"start": 9, "end": 11, "entity_type": "protein", "text": "activation domain"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "alpha-helices"}]}
