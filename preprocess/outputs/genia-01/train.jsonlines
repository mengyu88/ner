{"tokens": ["To", "find", "genes", "that", "protect", "cells", "from", "apoptosis", ",", "we", "used", "an", "expression", "cloning", "strategy", "and", "identified", "BHRF1", ",", "an", "Epstein-Barr", "virus", "(", "EBV", ")", "early-lytic-cycle", "protein", "with", "distant", "homology", "to", "Bcl-2", ",", "as", "an", "anti-", "apoptosis", "protein", "."], "doc_id": "MEDLINE:97456516", "sent_id": "MEDLINE:97456516-2", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "BHRF1"}, {"start": 20, "end": 27, "entity_type": "protein", "text": "Epstein-Barr virus ( EBV ) early-lytic-cycle protein"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "Bcl-2"}, {"start": 35, "end": 38, "entity_type": "protein", "text": "anti- apoptosis protein"}]}
