{"tokens": ["We", "found", "that", "the", "adenylate", "cyclase", "activator", ",", "forskolin", ",", "inhibits", "anti-CD3", "-induced", "shift", "in", "Lck", "electrophoretic", "mobility", ",", "suggesting", "an", "intervention", "at", "the", "TCR", "-coupled", "phosphoinositide", "turnover", "that", "precedes", "the", "activation", "of", "PKC", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-3", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "protein", "text": "adenylate cyclase"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "anti-CD3"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "Lck"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "TCR"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "PKC"}]}
{"tokens": ["The", "shift", "of", "Lck", "following", "direct", "PKC", "activation", "by", "12-O-tetradecanoyl", "phorbol", "13-acetate", ",", "which", "bypasses", "early", "receptor-triggered", "biochemical", "events", ",", "is", "insensitive", "to", "forskolin", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "Lck"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "PKC"}]}
{"tokens": ["Nevertheless", ",", "forskolin", "also", "inhibits", "PKC", "downstream", "events", ",", "such", "as", "c-jun", "expression", ",", "which", "is", "critical", "for", "the", "activation", "process", "of", "T", "cells", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "PKC"}, {"start": 11, "end": 12, "entity_type": "DNA", "text": "c-jun"}, {"start": 22, "end": 24, "entity_type": "cell_type", "text": "T cells"}]}
{"tokens": ["To", "further", "analyze", "potential", "cross", "points", "between", "positively", "and", "negatively", "regulating", "signaling", "pathways", "in", "T", "cells", ",", "we", "tested", "the", "effects", "of", "activators", "of", "the", "adenylate", "cyclase", "or", "PKA", "on", "two", "parallel", "mitogen-activated", "protein", "kinase", "signaling", "pathways", "mediated", "by", "extracellular", "signal-regulated", "kinase", "(", "ERK", ")", "and", "c-Jun", "N-terminal", "kinase", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-6", "entity_mentions": [{"start": 14, "end": 16, "entity_type": "cell_type", "text": "T cells"}, {"start": 25, "end": 27, "entity_type": "protein", "text": "adenylate cyclase"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "PKA"}, {"start": 39, "end": 42, "entity_type": "protein", "text": "extracellular signal-regulated kinase"}, {"start": 43, "end": 44, "entity_type": "protein", "text": "ERK"}, {"start": 46, "end": 49, "entity_type": "protein", "text": "c-Jun N-terminal kinase"}]}
{"tokens": ["Using", "a", "PKC", "-specific", "inhibitor", ",", "GF109203X", ",", "or", "PKC", "-depleted", "T", "cells", ",", "we", "found", "that", "a", "large", "part", "of", "the", "anti-CD3", "-induced", "ERK", "activation", "is", "PKC", "dependent", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-7", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "PKC"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "PKC"}, {"start": 9, "end": 13, "entity_type": "cell_line", "text": "PKC -depleted T cells"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "anti-CD3"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "ERK"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "PKC"}]}
