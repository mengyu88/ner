{"tokens": ["In", "the", "present", "study", ",", "we", "examined", "the", "relationship", "between", "ras", "transformation", "and", "differentiation", "of", "human", "B", "lymphocytes", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-2", "entity_mentions": [{"start": 15, "end": 18, "entity_type": "cell_type", "text": "human B lymphocytes"}]}
{"tokens": ["We", "show", "that", "the", "constitutive", "expression", "of", "the", "T24", "Ha-ras", "oncogene", "in", "EBV-immortalized", "B", "lymphoblasts", "was", "associated", "with", "the", "induction", "of", "the", "interleukin", "2", "receptor", "alpha", "subunit", ",", "with", "an", "impaired", "immunoglobulin", "gene", "expression", ",", "altered", "adhesion", "properties", "and", "increased", "survival", "in", "serum-free", "medium", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-3", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "DNA", "text": "T24 Ha-ras oncogene"}, {"start": 12, "end": 15, "entity_type": "cell_line", "text": "EBV-immortalized B lymphoblasts"}, {"start": 22, "end": 27, "entity_type": "protein", "text": "interleukin 2 receptor alpha subunit"}, {"start": 31, "end": 33, "entity_type": "DNA", "text": "immunoglobulin gene"}]}
{"tokens": ["Since", "induction", "of", "the", "IL-2", "receptor", "alpha", "subunit", "is", "a", "hallmark", "of", "lymphocyte", "activation", ",", "we", "suggest", "that", "p21ras", "naturally", "triggers", "B", "cell", "activation", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-4", "entity_mentions": [{"start": 4, "end": 8, "entity_type": "protein", "text": "IL-2 receptor alpha subunit"}, {"start": 12, "end": 13, "entity_type": "cell_type", "text": "lymphocyte"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "p21ras"}, {"start": 21, "end": 23, "entity_type": "cell_type", "text": "B cell"}]}
{"tokens": ["The", "ras-transformed", "lymphocytes", "displayed", "a", "fully", "functional", "IL-2r", ",", "as", "assessed", "by", "c-fos", "induction", "following", "treatment", "with", "IL-2", ";", "nevertheless", ",", "they", "were", "not", "growth", "stimulated", "by", "this", "lymphokine", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-5", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "ras-transformed lymphocytes"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "IL-2r"}, {"start": 12, "end": 13, "entity_type": "DNA", "text": "c-fos"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "IL-2"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "lymphokine"}]}
{"tokens": ["The", "decreased", "expression", "of", "immunoglobulin", "genes", "indicates", "that", "the", "ras", "oncogene", "blocks", "terminal", "differentiation", "to", "plasma", "cells", ",", "possibly", "by", "inhibiting", "the", "activity", "of", "lymphocyte-specific", "transcription", "factors", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-6", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "DNA", "text": "immunoglobulin genes"}, {"start": 9, "end": 11, "entity_type": "DNA", "text": "ras oncogene"}, {"start": 15, "end": 17, "entity_type": "cell_type", "text": "plasma cells"}, {"start": 24, "end": 27, "entity_type": "protein", "text": "lymphocyte-specific transcription factors"}]}
{"tokens": ["Somewhat", "unexpectedly", ",", "the", "constitutive", "p21ras", "activity", "did", "not", "cause", "an", "increased", "DNA", "binding", "of", "transcription", "factors", "PEA1", "(", "AP1", ")", ",", "PEA3", ",", "Oct-2", "or", "NF-kB"], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-7", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "p21ras"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "transcription factors"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "PEA1"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "AP1"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "PEA3"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "Oct-2"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "NF-kB"}]}
