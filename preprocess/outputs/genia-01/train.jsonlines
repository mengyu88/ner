{"tokens": ["Although", "their", "precise", "mechanism", "of", "action", "remains", "to", "be", "elucidated", ",", "glucocorticoids", "represent", "the", "most", "effective", "therapy", "in", "the", "treatment", "of", "asthma", "."], "doc_id": "MEDLINE:96152682", "sent_id": "MEDLINE:96152682-1", "entity_mentions": []}
