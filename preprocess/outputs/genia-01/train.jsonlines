{"tokens": ["The", "zinc", "finger", "transcription", "factor", "GATA-1", "is", "a", "major", "regulator", "of", "gene", "expression", "in", "erythroid", ",", "megakaryocyte", ",", "and", "mast", "cell", "lineages", "."], "doc_id": "MEDLINE:94217708", "sent_id": "MEDLINE:94217708-1", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "transcription factor"}, {"start": 1, "end": 5, "entity_type": "protein", "text": "zinc finger transcription factor"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "GATA-1"}]}
{"tokens": ["GATA-1", "binds", "to", "WGATAR", "consensus", "motifs", "in", "the", "regulatory", "regions", "of", "virtually", "all", "erythroid", "cell-specific", "genes", "."], "doc_id": "MEDLINE:94217708", "sent_id": "MEDLINE:94217708-2", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "GATA-1"}, {"start": 3, "end": 6, "entity_type": "DNA", "text": "WGATAR consensus motifs"}, {"start": 8, "end": 10, "entity_type": "DNA", "text": "regulatory regions"}, {"start": 13, "end": 16, "entity_type": "DNA", "text": "erythroid cell-specific genes"}]}
{"tokens": ["Analyses", "with", "cultured", "cells", "and", "cell-free", "systems", "have", "provided", "strong", "evidence", "that", "GATA-1", "is", "involved", "in", "control", "of", "globin", "gene", "expression", "during", "erythroid", "differentiation", "."], "doc_id": "MEDLINE:94217708", "sent_id": "MEDLINE:94217708-3", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "cultured cells"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "GATA-1"}, {"start": 18, "end": 20, "entity_type": "DNA", "text": "globin gene"}]}
{"tokens": ["Targeted", "mutagenesis", "of", "the", "GATA-1", "gene", "in", "embryonic", "stem", "cells", "has", "demonstrated", "its", "requirement", "in", "normal", "erythroid", "development", "."], "doc_id": "MEDLINE:94217708", "sent_id": "MEDLINE:94217708-4", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "GATA-1"}, {"start": 4, "end": 6, "entity_type": "DNA", "text": "GATA-1 gene"}, {"start": 7, "end": 10, "entity_type": "cell_type", "text": "embryonic stem cells"}]}
{"tokens": ["Efficient", "rescue", "of", "the", "defect", "requires", "an", "intact", "GATA", "element", "in", "the", "distal", "promoter", ",", "suggesting", "autoregulatory", "control", "of", "GATA-1", "transcription", "."], "doc_id": "MEDLINE:94217708", "sent_id": "MEDLINE:94217708-5", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "DNA", "text": "GATA element"}, {"start": 12, "end": 14, "entity_type": "DNA", "text": "distal promoter"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "GATA-1"}]}
