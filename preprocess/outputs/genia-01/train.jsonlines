{"tokens": ["Pretreatment", "of", "HL-60", "cells", "or", "thymocytes", "with", "100-500", "microM", "OP", "for", "2", "hr", ",", "but", "not", "10-60", "mM", "NAC", ",", "suppressed", "subsequent", "occurrence", "of", "apoptosis", "induced", "by", "etoposide", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-7", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "cell_type", "text": "thymocytes"}]}
