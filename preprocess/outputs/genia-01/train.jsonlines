{"tokens": ["However", ",", "Rta", "has", "recently", "been", "reported", "to", "disrupt", "latency", "in", "an", "epithelial", "specific", "manner", "(", "S.", "Zalani", ",", "E.", "Holley-Guthrie", ",", "and", "S.", "Kenney", ",", "Proc.", "Natl.", "Acad.", "Sci.", "USA", "93", ":", "9194-9199", ",", "1996", ")", "."], "doc_id": "MEDLINE:98406200", "sent_id": "MEDLINE:98406200-4", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "Rta"}]}
