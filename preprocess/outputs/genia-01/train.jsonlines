{"tokens": ["We", "examined", "the", "contribution", "of", "the", "two", "isoforms", "of", "STAT5", ",", "STAT5A", "and", "STAT5B", ",", "to", "IL-2-", "and", "IL-7-", "induced", "activation", "of", "human", "peripheral", "blood", "T", "lymphoblasts", "."], "doc_id": "MEDLINE:98063340", "sent_id": "MEDLINE:98063340-2", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "STAT5"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "STAT5A"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "STAT5B"}, {"start": 22, "end": 27, "entity_type": "cell_type", "text": "human peripheral blood T lymphoblasts"}]}
