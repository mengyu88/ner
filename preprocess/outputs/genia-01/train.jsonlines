{"tokens": ["Initiation", "of", "proliferation", "but", "not", "of", "differentiation", "was", "followed", "by", "a", "20-", "to", "25-fold", "increase", "in", "the", "nuclear", "level", "of", "the", "DNA", "polymerase-associated", "processivity", "factor", "PCNA", "and", "of", "the", "proliferation-specific", "transcription", "factor", "E2F1", "."], "doc_id": "MEDLINE:98438043", "sent_id": "MEDLINE:98438043-4", "entity_mentions": [{"start": 25, "end": 26, "entity_type": "protein", "text": "PCNA"}, {"start": 21, "end": 26, "entity_type": "protein", "text": "DNA polymerase-associated processivity factor PCNA"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "E2F1"}, {"start": 29, "end": 33, "entity_type": "protein", "text": "proliferation-specific transcription factor E2F1"}]}
{"tokens": ["In", "contrast", ",", "induction", "of", "differentiation", "but", "not", "of", "proliferation", "was", "followed", "by", "a", "25-", "to", "30-fold", "increase", "in", "the", "nuclear", "level", "of", "the", "tumor", "suppressor", "proteins", "p53", "(", "wild", "type", ")", ",", "pRb", ",", "and", "p130/Rb2", "and", "of", "the", "p53-dependent", "cyclin", "kinase", "inhibitor", "p21/Cip1", "."], "doc_id": "MEDLINE:98438043", "sent_id": "MEDLINE:98438043-5", "entity_mentions": [{"start": 24, "end": 28, "entity_type": "protein", "text": "tumor suppressor proteins p53"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "pRb"}, {"start": 36, "end": 37, "entity_type": "protein", "text": "p130/Rb2"}, {"start": 40, "end": 44, "entity_type": "protein", "text": "p53-dependent cyclin kinase inhibitor"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "p21/Cip1"}]}
