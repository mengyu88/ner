{"tokens": ["High-level", "replication", "of", "human", "immunodeficiency", "virus", "in", "thymocytes", "requires", "NF-kappaB", "activation", "through", "interaction", "with", "thymic", "epithelial", "cells", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-0", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 14, "end": 17, "entity_type": "cell_type", "text": "thymic epithelial cells"}]}
{"tokens": ["We", "have", "previously", "demonstrated", "that", "interaction", "of", "infected", "thymocytes", "with", "autologous", "thymic", "epithelial", "cells", "(", "TEC", ")", "is", "a", "prerequisite", "for", "a", "high", "level", "of", "human", "immunodeficiency", "virus", "type", "1", "(", "HIV-1", ")", "replication", "in", "thymocytes", "(", "M.Rothe", ",", "L.Chene", ",", "M.Nugeyre", ",", "F.Barre-Sinoussi", ",", "and", "N.Israel", ",", "J.Virol.72", ":", "5852-5861", ",", "1998", ")", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-1", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 11, "end": 14, "entity_type": "cell_type", "text": "thymic epithelial cells"}, {"start": 15, "end": 16, "entity_type": "cell_type", "text": "TEC"}, {"start": 35, "end": 36, "entity_type": "cell_type", "text": "thymocytes"}]}
{"tokens": ["We", "report", "here", "that", "this", "activation", "of", "HIV", "replication", "takes", "place", "at", "the", "transcriptional", "level", "through", "activation", "of", "the", "Rel/", "NF-kappaB", "transcription", "factors", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-2", "entity_mentions": [{"start": 20, "end": 21, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "Rel/ NF-kappaB"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "transcription factors"}]}
{"tokens": ["We", "first", "demonstrate", "that", "an", "HIV-1", "provirus", "(", "SF-2", "strain", ")", "very", "effectively", "replicates", "in", "thymocytes", "cocultured", "with", "TEC", "whereas", "this", "provirus", ",", "with", "kappaB", "sites", "deleted", ",", "fails", "to", "replicate", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-3", "entity_mentions": [{"start": 15, "end": 16, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 18, "end": 19, "entity_type": "cell_type", "text": "TEC"}, {"start": 24, "end": 26, "entity_type": "DNA", "text": "kappaB sites"}]}
{"tokens": ["We", "provide", "evidence", "that", "several", "NF-kappaB", "complexes", "are", "constitutively", "found", "in", "the", "nuclei", "of", "thymocytes", "either", "freshly", "isolated", "from", "the", "thymus", "or", "maintained", "in", "coculture", "with", "autologous", "or", "heterologous", "TEC", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-4", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "NF-kappaB complexes"}, {"start": 14, "end": 15, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 29, "end": 30, "entity_type": "cell_type", "text": "TEC"}]}
{"tokens": ["The", "prevalent", "complex", "is", "the", "heterodimer", "p50-p65", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-5", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "heterodimer p50-p65"}]}
{"tokens": ["NF-kappaB", "activity", "is", "tightly", "correlated", "with", "the", "transcriptional", "activity", "of", "a", "long", "terminal", "repeat", "(", "LTR", ")", "of", "HIV-1", "transfected", "in", "thymocytes", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-6", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 11, "end": 14, "entity_type": "DNA", "text": "long terminal repeat"}, {"start": 15, "end": 16, "entity_type": "DNA", "text": "LTR"}, {"start": 21, "end": 22, "entity_type": "cell_type", "text": "thymocytes"}]}
{"tokens": ["The", "cotransfection", "of", "this", "LTR", "with", "a", "mutated", "IkappaBalpha", "molecule", "formally", "demonstrates", "that", "LTR", "transactivation", "is", "regulated", "by", "members", "of", "the", "Rel/", "NF-kappaB", "family", "in", "thymocytes", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-7", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "DNA", "text": "LTR"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "IkappaBalpha molecule"}, {"start": 13, "end": 14, "entity_type": "DNA", "text": "LTR"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 21, "end": 24, "entity_type": "protein", "text": "Rel/ NF-kappaB family"}, {"start": 25, "end": 26, "entity_type": "cell_type", "text": "thymocytes"}]}
{"tokens": ["We", "also", "showed", "that", "tumor", "necrosis", "factor", "(", "TNF", ")", "and", "to", "a", "lesser", "extent", "interleukin-1", "(", "IL-1", ")", ",", "secreted", "within", "the", "coculture", ",", "induce", "NF-kappaB", "activity", "and", "a", "correlative", "LTR", "transactivation", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-8", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "protein", "text": "tumor necrosis factor"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "TNF"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "interleukin-1"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "IL-1"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 31, "end": 32, "entity_type": "DNA", "text": "LTR"}]}
{"tokens": ["However", "IL-7", ",", "a", "crucial", "factor", "for", "thymopoiesis", "that", "is", "secreted", "mainly", "by", "TEC", ",", "is", "a", "necessary", "cofactor", "for", "NF-kappaB", "activation", "elicited", "by", "TNF", "or", "IL-1", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-9", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "IL-7"}, {"start": 13, "end": 14, "entity_type": "cell_type", "text": "TEC"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "TNF"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "IL-1"}]}
{"tokens": ["Together", ",", "these", "data", "indicate", "that", "NF-kappaB", "activation", ",", "required", "for", "a", "high", "level", "of", "HIV", "replication", "in", "thymocytes", ",", "is", "regulated", "in", "a", "specific", "manner", "in", "the", "thymic", "microenvironment", "which", "provides", "the", "necessary", "cytokines", ":", "TNF", ",", "IL-1", ",", "and", "IL-7", "."], "doc_id": "MEDLINE:99138988", "sent_id": "MEDLINE:99138988-10", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 18, "end": 19, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 36, "end": 37, "entity_type": "protein", "text": "TNF"}, {"start": 38, "end": 39, "entity_type": "protein", "text": "IL-1"}, {"start": 41, "end": 42, "entity_type": "protein", "text": "IL-7"}]}
