{"tokens": ["However", ",", "this", "anti-CD3", "-mediated", "response", "was", "not", "inhibited", "by", "neomycin", ",", "an", "inhibitor", "of", "phosphoinositide", "hydrolysis", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-8", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "anti-CD3"}]}
{"tokens": ["The", "increases", "in", "AP-1", "enhancer", "activity", "induced", "by", "PA", "or", "anti-CD3", "mAb", "were", "efficiently", "abrogated", "by", "the", "presence", "of", "propranolol", ",", "an", "inhibitor", "of", "PA", "phosphohydrolase", "and", "protein", "kinase", "C", "(", "PKC", ")", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-9", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "DNA", "text": "AP-1 enhancer"}, {"start": 10, "end": 12, "entity_type": "protein", "text": "anti-CD3 mAb"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "phosphohydrolase"}, {"start": 27, "end": 30, "entity_type": "protein", "text": "protein kinase C"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "PKC"}]}
{"tokens": ["Furthermore", ",", "the", "PA", "-", "and", "the", "anti-CD3", "-induced", "increases", "in", "AP-1", "enhancer", "activity", "were", "blocked", "by", "the", "presence", "of", "PKC", "inhibitors", "or", "by", "PKC", "down-regulation", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-10", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "anti-CD3"}, {"start": 11, "end": 13, "entity_type": "DNA", "text": "AP-1 enhancer"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "PKC"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "PKC"}]}
{"tokens": ["These", "data", "indicate", "that", "PLD", "stimulation", "can", "activate", "the", "transcription", "factor", "AP-1", "in", "T", "lymphocytes", ",", "and", "suggest", "that", "the", "induction", "of", "AP-1", "enhancer", "factor", "activity", "by", "PA", "is", "mediated", "via", "PKC", "stimulation", ",", "either", "through", "a", "direct", "activating", "effect", "of", "PA", "or", "through", "PA", "-derived", "diacylglycerol", "formation", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-11", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "PLD"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "AP-1"}, {"start": 9, "end": 12, "entity_type": "protein", "text": "transcription factor AP-1"}, {"start": 13, "end": 15, "entity_type": "cell_type", "text": "T lymphocytes"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "AP-1 enhancer"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "PKC"}]}
{"tokens": ["These", "data", "also", "provide", "evidence", "for", "a", "role", "of", "PLD", "-derived", "lipids", "in", "the", "induction", "of", "AP-1", "enhancer", "activity", "resulting", "from", "stimulation", "of", "the", "TCR/CD3", "complex", ",", "suggesting", "that", "increased", "PLD", "activity", "can", "play", "an", "important", "role", "in", "T", "lymphocyte", "activation", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-12", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "PLD"}, {"start": 16, "end": 18, "entity_type": "DNA", "text": "AP-1 enhancer"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "TCR/CD3 complex"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "PLD"}, {"start": 38, "end": 40, "entity_type": "cell_type", "text": "T lymphocyte"}]}
{"tokens": ["Upregulation", "of", "bcl-2", "by", "the", "Epstein-Barr", "virus", "latent", "membrane", "protein", "LMP1", ":", "a", "B-cell-specific", "response", "that", "is", "delayed", "relative", "to", "NF-kappa", "B", "activation", "and", "to", "induction", "of", "cell", "surface", "markers", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-0", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "DNA", "text": "bcl-2"}, {"start": 5, "end": 10, "entity_type": "protein", "text": "Epstein-Barr virus latent membrane protein"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "LMP1"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 27, "end": 30, "entity_type": "protein", "text": "cell surface markers"}]}
{"tokens": ["An", "ability", "of", "the", "Epstein-Barr", "virus", "latent", "membrane", "protein", "LMP1", "to", "enhance", "the", "survival", "of", "infected", "B", "cells", "through", "upregulation", "of", "the", "bcl-2", "oncogene", "was", "first", "suggested", "by", "experiments", "involving", "gene", "transfection", "and", "the", "selection", "of", "stable", "LMP1", "+", "clones", "(", "S.Henderson", ",", "M.", "Rowe", ",", "C.Gregory", ",", "F.Wang", ",", "E.Kieff", ",", "and", "A.Rickinson", ",", "Cell", "65", ":", "1107-1115", ",", "1991", ")", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-1", "entity_mentions": [{"start": 4, "end": 9, "entity_type": "protein", "text": "Epstein-Barr virus latent membrane protein"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "LMP1"}, {"start": 15, "end": 18, "entity_type": "cell_type", "text": "infected B cells"}, {"start": 22, "end": 23, "entity_type": "DNA", "text": "bcl-2"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "bcl-2 oncogene"}, {"start": 37, "end": 38, "entity_type": "protein", "text": "LMP1"}, {"start": 37, "end": 40, "entity_type": "cell_line", "text": "LMP1 + clones"}]}
{"tokens": ["However", ",", "it", "was", "not", "possible", "to", "ascertain", "whether", "Bcl-2", "upregulation", "was", "a", "specific", "consequence", "of", "LMP1", "expression", "or", "an", "artifact", "of", "the", "selection", "procedure", "whereby", "rare", "Bcl-2", "+", "cells", "already", "present", "in", "the", "starting", "population", "might", "best", "be", "able", "to", "tolerate", "the", "potentially", "toxic", "effects", "of", "LMP1", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-2", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "Bcl-2"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "LMP1"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "Bcl-2"}, {"start": 27, "end": 30, "entity_type": "cell_line", "text": "Bcl-2 + cells"}, {"start": 47, "end": 48, "entity_type": "protein", "text": "LMP1"}]}
{"tokens": ["We", "therefore", "reexamined", "this", "issue", "by", "using", "two", "different", "experimental", "approaches", "that", "allowed", "LMP1", "-induced", "effects", "to", "be", "monitored", "immediately", "following", "expression", "of", "the", "viral", "protein", "and", "in", "the", "absence", "of", "selective", "pressures", ";", "activation", "of", "the", "NF-kappa", "B", "transcription", "factor", "and", "upregulation", "of", "the", "cell", "adhesion", "molecule", "ICAM-1", "were", "used", "as", "early", "indices", "of", "LMP1", "function", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-3", "entity_mentions": [{"start": 13, "end": 14, "entity_type": "protein", "text": "LMP1"}, {"start": 37, "end": 39, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 39, "end": 41, "entity_type": "protein", "text": "transcription factor"}, {"start": 45, "end": 48, "entity_type": "protein", "text": "cell adhesion molecule"}, {"start": 48, "end": 49, "entity_type": "protein", "text": "ICAM-1"}, {"start": 55, "end": 56, "entity_type": "protein", "text": "LMP1"}]}
{"tokens": ["In", "the", "first", "approach", ",", "stable", "clones", "of", "two", "B-cell", "lines", "carrying", "an", "LMP1", "gene", "under", "the", "control", "of", "an", "inducible", "metallothionein", "promoter", "were", "induced", "to", "express", "LMP1", "in", "all", "cells", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-4", "entity_mentions": [{"start": 9, "end": 11, "entity_type": "cell_line", "text": "B-cell lines"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "LMP1"}, {"start": 21, "end": 23, "entity_type": "DNA", "text": "metallothionein promoter"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "LMP1"}]}
{"tokens": ["Activation", "of", "NK-kappa", "B", "and", "upregulation", "of", "ICAM-1", "occurred", "within", "24", "h", "and", "were", "followed", "at", "48", "to", "72", "h", "by", "upregulation", "of", "Bcl-2", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-5", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "protein", "text": "NK-kappa B"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "ICAM-1"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "Bcl-2"}]}
{"tokens": ["In", "the", "second", "approach", ",", "we", "tested", "the", "generality", "of", "this", "phenomenon", "by", "transiently", "expressing", "LMP1", "from", "a", "strong", "constitutively", "active", "promoter", "in", "a", "range", "of", "different", "cell", "types", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-6", "entity_mentions": [{"start": 15, "end": 16, "entity_type": "protein", "text": "LMP1"}]}
{"tokens": ["All", "six", "B-cell", "lines", "tested", "showed", "NF-kappa", "B", "activation", "in", "response", "to", "LMP1", "expression", ",", "and", "this", "was", "followed", "in", "five", "of", "six", "lines", "by", "expression", "of", "ICAM-1", "and", "Bcl-2", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-7", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "B-cell lines"}, {"start": 6, "end": 8, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "LMP1"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "ICAM-1"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "Bcl-2"}]}
{"tokens": ["In", "the", "same", "experiments", ",", "all", "three", "non-", "B-cell", "lines", "showed", "NF-kappa", "B", "activation", "and", "ICAM-1", "upregulation", "but", "never", "any", "effect", "upon", "Bcl-2", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-8", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "cell_line", "text": "B-cell lines"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "ICAM-1"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "Bcl-2"}]}
{"tokens": ["We", "therefore", "conclude", "that", "Bcl-2", "upregulation", "is", "part", "of", "the", "panoply", "of", "cellular", "changes", "induced", "by", "LMP1", "but", "that", "the", "effect", "is", "cell", "type", "specific", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-9", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "Bcl-2"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "LMP1"}]}
{"tokens": ["Our", "data", "also", "suggest", "that", "whilst", "NF-kappa", "B", "may", "be", "an", "essential", "component", "of", "LMP1", "signal", "transduction", ",", "other", "cell-specific", "factors", "may", "be", "required", "to", "effect", "some", "functions", "of", "the", "viral", "protein", "."], "doc_id": "MEDLINE:94335073", "sent_id": "MEDLINE:94335073-10", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "LMP1"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "cell-specific factors"}, {"start": 30, "end": 32, "entity_type": "protein", "text": "viral protein"}]}
{"tokens": ["Long-term", "inositol", "phosphate", "release", ",", "but", "not", "tyrosine", "kinase", "activity", ",", "correlates", "with", "IL-2", "secretion", "and", "NF-AT", "induction", "in", "anti-CD3-activated", "peripheral", "human", "T", "lymphocytes", "."], "doc_id": "MEDLINE:94313679", "sent_id": "MEDLINE:94313679-0", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "protein", "text": "tyrosine kinase"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IL-2"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "NF-AT"}, {"start": 19, "end": 24, "entity_type": "cell_line", "text": "anti-CD3-activated peripheral human T lymphocytes"}]}
{"tokens": ["The", "cascade", "of", "events", "within", "the", "first", "few", "minutes", "of", "T", "cell", "stimulation", "has", "been", "well", "characterized", "."], "doc_id": "MEDLINE:94313679", "sent_id": "MEDLINE:94313679-1", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "cell_type", "text": "T cell"}]}
{"tokens": ["Although", "many", "second", "messengers", "have", "been", "shown", "to", "be", "necessary", "and", "sufficient", "for", "T", "cell", "activation", "in", "a", "number", "of", "model", "systems", ",", "the", "rate-limiting", "step", "in", "peripheral", "T", "cells", "has", "not", "been", "demonstrated", "."], "doc_id": "MEDLINE:94313679", "sent_id": "MEDLINE:94313679-2", "entity_mentions": [{"start": 13, "end": 15, "entity_type": "cell_type", "text": "T cell"}, {"start": 27, "end": 30, "entity_type": "cell_type", "text": "peripheral T cells"}]}
{"tokens": ["To", "model", "effective", "versus", "ineffective", "CD3", "-mediated", "stimulation", "in", "peripheral", "T", "cells", ",", "we", "used", "two", "anti-CD3", "mAbs", "that", "differ", "in", "their", "ability", "to", "stimulate", "purified", "T", "cells", ":", "OKT3", ",", "which", "causes", "early", "second", "messenger", "generation", "but", "is", "unable", "to", "activate", "T", "cells", "without", "a", "second", "signal", ",", "and", "64.1", ",", "which", "stimulates", "T", "cell", "proliferation", "on", "its", "own", "."], "doc_id": "MEDLINE:94313679", "sent_id": "MEDLINE:94313679-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "CD3"}, {"start": 9, "end": 12, "entity_type": "cell_type", "text": "peripheral T cells"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "anti-CD3 mAbs"}, {"start": 25, "end": 28, "entity_type": "cell_type", "text": "purified T cells"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "OKT3"}, {"start": 42, "end": 44, "entity_type": "cell_type", "text": "T cells"}, {"start": 50, "end": 51, "entity_type": "protein", "text": "64.1"}, {"start": 54, "end": 56, "entity_type": "cell_type", "text": "T cell"}]}
