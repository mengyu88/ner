{"tokens": ["RESULTS", ":", "Dose-dependent", "inhibition", "was", "demonstrated", "for", "all", "glucocorticoids", "in", "both", "patient", "groups", ",", "with", "the", "steroid-resistant", "group", "requiring", "approximately", "2", "log-fold", "more", "glucocorticoids", "for", "an", "equivalent", "degree", "of", "inhibition", "."], "doc_id": "MEDLINE:97132051", "sent_id": "MEDLINE:97132051-5", "entity_mentions": []}
{"tokens": ["The", "mean", "concentrations", "necessary", "to", "cause", "50", "%", "inhibition", "of", "lymphocyte", "proliferation", "(", "IC50s", ")", "for", "the", "steroid-sensitive", "group", "ranged", "from", "2", "x", "10(-10)", "mol/L", "for", "budesonide", "to", "7", "x", "10(-8)", "mol/L", "for", "hydrocortisone", ",", "whereas", "the", "mean", "IC50s", "for", "the", "steroid-resistant", "group", "ranged", "from", "approximately", "2", "x", "10(-8)", "mol/L", "for", "budesonide", "to", "greater", "than", "10(-6)", "mol/L", "for", "hydrocortisone", "."], "doc_id": "MEDLINE:97132051", "sent_id": "MEDLINE:97132051-6", "entity_mentions": []}
{"tokens": ["In", "addition", ",", "a", "significant", "correlation", "was", "noted", "between", "the", "degree", "of", "inhibition", "of", "lymphocyte", "proliferation", "(", "IC50", ")", "and", "the", "binding", "affinity", "of", "dexamethasone", "to", "the", "GCR", "."], "doc_id": "MEDLINE:97132051", "sent_id": "MEDLINE:97132051-7", "entity_mentions": [{"start": 27, "end": 28, "entity_type": "protein", "text": "GCR"}]}
