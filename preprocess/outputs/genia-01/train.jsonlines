{"tokens": ["We", "have", "previously", "shown", "that", "anionic", "phosphatidylserine", "is", "exposed", "by", "rat", "vascular", "smooth", "muscle", "cells", "(", "VSMCs", ")", "undergoing", "apoptosis", "after", "serum", "withdrawal", "."], "doc_id": "MEDLINE:97335966", "sent_id": "MEDLINE:97335966-2", "entity_mentions": [{"start": 10, "end": 15, "entity_type": "cell_type", "text": "rat vascular smooth muscle cells"}, {"start": 16, "end": 17, "entity_type": "cell_type", "text": "VSMCs"}]}
