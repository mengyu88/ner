{"tokens": ["In", "this", "study", "we", "investigated", "recognition", "by", "ovarian", "tumor", "associated", "lymphocyte", "(", "OVTAL", ")", ",", "and", "breast", "tumor", "associated", "lymphocytes", "(", "BRTAL", ")", ",", "of", "peptides", "corresponding", "to", "the", "sequence", "125-135", "of", "the", "Aminoenhancer", "of", "split", "(", "AES", ")", "protein", "."], "doc_id": "MEDLINE:99321124", "sent_id": "MEDLINE:99321124-1", "entity_mentions": [{"start": 7, "end": 11, "entity_type": "cell_type", "text": "ovarian tumor associated lymphocyte"}, {"start": 12, "end": 13, "entity_type": "cell_type", "text": "OVTAL"}, {"start": 16, "end": 20, "entity_type": "cell_type", "text": "breast tumor associated lymphocytes"}, {"start": 21, "end": 22, "entity_type": "cell_type", "text": "BRTAL"}, {"start": 30, "end": 40, "entity_type": "protein", "text": "125-135 of the Aminoenhancer of split ( AES ) protein"}]}
