{"tokens": ["Structure/function", "analysis", "of", "various", "Oct-2a", "effector", "regions", "in", "the", "context", "of", "the", "GAL4", "DNA-binding", "domain", "revealed", "that", "Oct-2a", "contains", "two", "functionally", "different", "activation", "domains", "at", "the", "N", "and", "the", "C", "termini", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-2", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "Oct-2a"}, {"start": 4, "end": 7, "entity_type": "protein", "text": "Oct-2a effector regions"}, {"start": 12, "end": 15, "entity_type": "protein", "text": "GAL4 DNA-binding domain"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "Oct-2a"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "activation domains"}]}
{"tokens": ["The", "transcriptional", "activity", "of", "both", "domains", "is", "strongly", "potentiated", "by", "interactions", "with", "distinct", "B", "cell-specific", "coactivators", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-3", "entity_mentions": [{"start": 13, "end": 16, "entity_type": "protein", "text": "B cell-specific coactivators"}]}
{"tokens": ["Recently", ",", "we", "have", "identified", "a", "repression", "domain", "located", "within", "the", "N", "terminus", "of", "Oct-2a", "(", "amino", "acids", "2-99", ")", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-4", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "repression domain"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "N terminus"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "Oct-2a"}, {"start": 16, "end": 19, "entity_type": "protein", "text": "amino acids 2-99"}]}
{"tokens": ["When", "this", "domain", "was", "transferred", "to", "a", "potent", "activator", ",", "transcription", "was", "strongly", "inhibited", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-5", "entity_mentions": []}
{"tokens": ["In", "this", "study", "we", "present", "a", "deletion", "analysis", "of", "the", "N-terminal", "region", "of", "Oct-2a", "to", "determine", "the", "minimal", "repression", "domain", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-6", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "N-terminal region"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "Oct-2a"}, {"start": 17, "end": 20, "entity_type": "protein", "text": "minimal repression domain"}]}
{"tokens": ["We", "identified", "a", "stretch", "of", "23", "amino", "acids", ",", "rich", "in", "serine", "and", "threonine", "residues", ",", "which", "was", "responsible", "for", "most", "of", "the", "repression", "activity", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-7", "entity_mentions": []}
{"tokens": ["We", "show", "that", "repression", "is", "strongly", "dependent", "on", "the", "type", "of", "enhancer", "present", "in", "the", "reporter", "plasmid", "as", "well", "as", "on", "the", "cell", "line", "tested", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-8", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "DNA", "text": "enhancer"}, {"start": 15, "end": 17, "entity_type": "DNA", "text": "reporter plasmid"}, {"start": 22, "end": 24, "entity_type": "cell_line", "text": "cell line"}]}
{"tokens": ["The", "possibility", "that", "Oct-2a", "can", "act", "as", "an", "activator", "and/or", "a", "repressor", "may", "have", "important", "consequences", "for", "the", "function", "of", "Oct-2a", "in", "B", "cell", "differentiation", "and", "other", "developmental", "processes", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-9", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "Oct-2a"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "Oct-2a"}]}
{"tokens": ["Opposing", "effects", "of", "glucocorticoids", "on", "the", "rate", "of", "apoptosis", "in", "neutrophilic", "and", "eosinophilic", "granulocytes", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-0", "entity_mentions": []}
{"tokens": ["Eosinophils", "and", "neutrophils", "are", "closely", "related", ",", "terminally", "differentiated", "cells", "that", "in", "vitro", "undergo", "constitutive", "cell", "death", "by", "apoptosis", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "cell_type", "text": "Eosinophils"}, {"start": 2, "end": 3, "entity_type": "cell_type", "text": "neutrophils"}, {"start": 7, "end": 10, "entity_type": "cell_type", "text": "terminally differentiated cells"}]}
{"tokens": ["The", "onset", "of", "apoptosis", "in", "both", "cell", "types", "can", "be", "delayed", "by", "hemopoietins", "and", "inflammatory", "mediators", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-2", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "hemopoietins"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "inflammatory mediators"}]}
{"tokens": ["Although", "there", "have", "been", "a", "number", "of", "reports", "demonstrating", "that", "glucocorticoids", "(", "in", "particular", "dexamethasone", ")", "antagonize", "the", "eosinophil", "life-prolonging", "effects", "of", "hemopoietins", ",", "direct", "effects", "of", "dexamethasone", "on", "eosinophil", "apoptosis", "have", "not", "been", "documented", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-3", "entity_mentions": [{"start": 22, "end": 23, "entity_type": "protein", "text": "hemopoietins"}]}
{"tokens": ["In", "this", "study", "we", "examined", "the", "direct", "effects", "of", "glucocorticoids", "on", "eosinophil", "and", "neutrophil", "apoptosis", "in", "light", "of", "their", "common", "therapeutic", "use", "as", "anti-inflammatory", "and", "anti-allergic", "/hypereosinophilic", "agents", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-4", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "cell_type", "text": "eosinophil"}, {"start": 13, "end": 14, "entity_type": "cell_type", "text": "neutrophil"}]}
{"tokens": ["We", "found", "that", "treatment", "with", "dexamethasone", "induced", "eosinophil", "apoptosis", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-5", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "cell_type", "text": "eosinophil"}]}
{"tokens": ["In", "contrast", ",", "dexamethasone", "was", "a", "potent", "inhibitor", "of", "neutrophil", "apoptosis", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-6", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "cell_type", "text": "neutrophil"}]}
{"tokens": ["The", "effect", "of", "dexamethasone", "on", "both", "cell", "types", "was", "mediated", "through", "the", "glucocorticoid", "receptor", ",", "i.e.", ",", "it", "was", "abolished", "by", "the", "glucocorticoid", "receptor", "antagonist", "RU38486", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-7", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "glucocorticoid receptor"}]}
{"tokens": ["This", "is", "the", "first", "description", "of", "an", "agent", "that", "promotes", "eosinophil", "apoptosis", "while", "inhibiting", "neutrophil", "apoptosis", ",", "and", "thus", "presents", "a", "novel", "approach", "to", "the", "study", "of", "control", "of", "apoptosis", "in", "these", "closely", "related", "cell", "types", "as", "well", "as", "increases", "our", "understanding", "of", "the", "clinical", "action", "of", "glucocorticoids", "in", "inflammation", "."], "doc_id": "MEDLINE:96247664", "sent_id": "MEDLINE:96247664-8", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "cell_type", "text": "eosinophil"}, {"start": 14, "end": 15, "entity_type": "cell_type", "text": "neutrophil"}]}
{"tokens": ["Permanent", "occupancy", "of", "the", "human", "immunodeficiency", "virus", "type", "1", "enhancer", "by", "NF-kappa", "B", "is", "needed", "for", "persistent", "viral", "replication", "in", "monocytes", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-0", "entity_mentions": [{"start": 4, "end": 10, "entity_type": "DNA", "text": "human immunodeficiency virus type 1 enhancer"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 20, "end": 21, "entity_type": "cell_type", "text": "monocytes"}]}
{"tokens": ["This", "work", "aimed", "to", "ascertain", "the", "role", "of", "kappaB-responsive", "elements", "of", "the", "human", "immunodeficiency", "virus", "type", "1", "(", "HIV-1", ")", "enhancer", "not", "only", "in", "early", "initiation", "but", "also", "in", "long-term", "maintenance", "of", "proviral", "transcription", "in", "cells", "of", "the", "monocytic", "lineage", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-1", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "DNA", "text": "kappaB-responsive elements"}, {"start": 12, "end": 21, "entity_type": "DNA", "text": "human immunodeficiency virus type 1 ( HIV-1 ) enhancer"}, {"start": 38, "end": 40, "entity_type": "cell_type", "text": "monocytic lineage"}]}
{"tokens": ["For", "this", "purpose", ",", "we", "used", "three", "main", "approaches", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-2", "entity_mentions": []}
{"tokens": ["The", "first", "was", "to", "abruptly", "terminate", "tumor", "necrosis", "factor-induced", "NF-kappaB", "binding", "to", "the", "enhancer", "sequences", "in", "U1", "monocytic", "cells", ",", "using", "a", "short", "pulse", "of", "exogenous", "tumor", "necrosis", "factor", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-3", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 25, "end": 29, "entity_type": "protein", "text": "exogenous tumor necrosis factor"}]}
{"tokens": ["This", "resulted", "in", "concomitant", "decrease", "in", "nuclear", "NF-kappaB", "DNA-binding", "activity", "and", "endogenous", "long", "terminal", "repeat", "transcriptional", "activity", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-4", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 11, "end": 15, "entity_type": "DNA", "text": "endogenous long terminal repeat"}]}
{"tokens": ["The", "second", "was", "to", "suppress", "the", "permanent", "NF-kappaB", "translocation", "induced", "by", "HIV-1", "replication", "itself", "in", "chronically", "infected", "U937", "cells", ",", "using", "a", "specific", "proteasome", "inhibitor", "(", "Z-LLL-H", ")", "."], "doc_id": "MEDLINE:96186719", "sent_id": "MEDLINE:96186719-5", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 15, "end": 19, "entity_type": "cell_line", "text": "chronically infected U937 cells"}]}
