{"tokens": ["AhR", "was", "expressed", "at", "high", "levels", "in", "monocytoid", "U937", ",", "THP1", ",", "and", "HEL/S", "cells", ",", "and", "at", "moderate", "levels", "in", "promyelocytic", "HL60", "cells", "and", "erythroblastic", "HEL", "cells", "."], "doc_id": "MEDLINE:95308691", "sent_id": "MEDLINE:95308691-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "AhR"}, {"start": 7, "end": 9, "entity_type": "cell_line", "text": "monocytoid U937"}, {"start": 10, "end": 11, "entity_type": "cell_line", "text": "THP1"}, {"start": 13, "end": 15, "entity_type": "cell_line", "text": "HEL/S cells"}, {"start": 21, "end": 24, "entity_type": "cell_line", "text": "promyelocytic HL60 cells"}, {"start": 25, "end": 28, "entity_type": "cell_line", "text": "erythroblastic HEL cells"}]}
{"tokens": ["However", ",", "it", "was", "not", "detected", "in", "lymphoid", "cells", "MOLT4", "(", "T", "cell", ")", "and", "BALL1", "(", "B", "cell", ")", ",", "nor", "in", "K562", "erythroblasts", "."], "doc_id": "MEDLINE:95308691", "sent_id": "MEDLINE:95308691-5", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "cell_type", "text": "lymphoid cells"}, {"start": 9, "end": 10, "entity_type": "cell_line", "text": "MOLT4"}, {"start": 11, "end": 13, "entity_type": "cell_type", "text": "T cell"}, {"start": 15, "end": 16, "entity_type": "cell_line", "text": "BALL1"}, {"start": 17, "end": 19, "entity_type": "cell_type", "text": "B cell"}, {"start": 23, "end": 25, "entity_type": "cell_line", "text": "K562 erythroblasts"}]}
