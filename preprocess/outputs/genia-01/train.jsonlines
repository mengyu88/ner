{"tokens": ["To", "characterize", "the", "protein-DNA", "interactions", "important", "for", "the", "developmental", "control", "of", "the", "human", "beta-globin", "locus", ",", "we", "analyzed", "by", "in", "vivo", "dimethyl", "sulfate", "footprinting", "erythroid", "cells", "expressing", "either", "the", "fetal", "or", "the", "adult", "globin", "developmental", "program", "."], "doc_id": "MEDLINE:96278860", "sent_id": "MEDLINE:96278860-2", "entity_mentions": [{"start": 12, "end": 15, "entity_type": "DNA", "text": "human beta-globin locus"}, {"start": 24, "end": 26, "entity_type": "cell_type", "text": "erythroid cells"}]}
{"tokens": ["In", "the", "locus", "control", "region", "(", "LCR", ")", "of", "the", "beta-globin", "locus", ",", "in", "vivo", "footprints", "on", "NF-E2", "(", "or", "AP-1", ")", "and", "GATA-1", "motifs", "remained", "the", "same", "regardless", "of", "whether", "the", "fetal", "or", "the", "adult", "globin", "genes", "are", "expressed", "."], "doc_id": "MEDLINE:96278860", "sent_id": "MEDLINE:96278860-3", "entity_mentions": [{"start": 2, "end": 5, "entity_type": "DNA", "text": "locus control region"}, {"start": 6, "end": 7, "entity_type": "DNA", "text": "LCR"}, {"start": 10, "end": 12, "entity_type": "DNA", "text": "beta-globin locus"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "NF-E2"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "AP-1"}, {"start": 23, "end": 25, "entity_type": "DNA", "text": "GATA-1 motifs"}, {"start": 35, "end": 38, "entity_type": "DNA", "text": "adult globin genes"}]}
{"tokens": ["In", "contrast", ",", "in", "vivo", "footprints", "on", "GT", "(", "CACCC", ")", "motifs", "differed", "between", "the", "cells", "expressing", "the", "fetal", "or", "the", "adult", "globin", "program", "."], "doc_id": "MEDLINE:96278860", "sent_id": "MEDLINE:96278860-4", "entity_mentions": [{"start": 7, "end": 12, "entity_type": "DNA", "text": "GT ( CACCC ) motifs"}]}
{"tokens": ["In", "promoter", "regions", ",", "the", "actively", "transcribed", "genes", "demonstrated", "extensive", "and", "consistent", "footprints", "over", "the", "canonical", "elements", ",", "such", "as", "CACCC", "and", "CCAAT", "motifs", "."], "doc_id": "MEDLINE:96278860", "sent_id": "MEDLINE:96278860-5", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "DNA", "text": "promoter regions"}, {"start": 5, "end": 8, "entity_type": "DNA", "text": "actively transcribed genes"}]}
