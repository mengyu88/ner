{"tokens": ["Retroviral", "vector-mediated", "transduction", "of", "RA", "receptor", "(", "RAR", "alpha", ")", "into", "this", "HL-60R", "subclone", "completely", "restored", "the", "sensitivity", "of", "these", "cells", "to", "ATRA", "in", "terms", "of", "their", "ability", "to", "express", "CD38", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-7", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "protein", "text": "RA receptor"}, {"start": 7, "end": 9, "entity_type": "protein", "text": "RAR alpha"}, {"start": 12, "end": 14, "entity_type": "cell_line", "text": "HL-60R subclone"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "CD38"}]}
{"tokens": ["In", "contrast", ",", "CD38", "expression", "was", "not", "inducible", "by", "ATRA", "in", "HL-60R", "cells", ",", "transfected", "with", "a", "functional", "RAR", "beta", ",", "RAR", "gamma", ",", "or", "RXR", "alpha", "receptor", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-8", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "CD38"}, {"start": 11, "end": 13, "entity_type": "cell_line", "text": "HL-60R cells"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "RAR beta"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "RAR gamma"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "RXR alpha receptor"}]}
{"tokens": ["Induction", "of", "CD38", "in", "acute", "promyelocytic", "and", "acute", "myeloblastic", "leukemia", "cells", "was", "independent", "of", "ATRA", "-induced", "cytodifferentiation", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-9", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "CD38"}]}
{"tokens": ["Following", "culture", "with", "ATRA", ",", "increased", "CD38", "protein", "levels", "were", "also", "observed", "in", "normal", "CD34+", "bone", "marrow", "cells", ",", "but", "not", "on", "normal", "circulating", "granulocytes", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-10", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "CD38"}, {"start": 13, "end": 18, "entity_type": "cell_type", "text": "normal CD34+ bone marrow cells"}, {"start": 22, "end": 25, "entity_type": "cell_type", "text": "normal circulating granulocytes"}]}
{"tokens": ["From", "these", "results", ",", "we", "conclude", "that", "CD38", "is", "ATRA", "inducible", "in", "myeloid", "leukemia", "cells", "and", "normal", "CD34+", "bone", "marrow", "cells", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-11", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "CD38"}, {"start": 12, "end": 15, "entity_type": "cell_type", "text": "myeloid leukemia cells"}, {"start": 16, "end": 21, "entity_type": "cell_type", "text": "normal CD34+ bone marrow cells"}]}
{"tokens": ["This", "effect", "is", "independent", "of", "differentiation", "and", "is", "mediated", "by", "RAR", "alpha", "in", "HL-60", "cells", ",", "suggesting", "a", "similar", "role", "for", "RAR", "alpha", "in", "CD38", "expression", "in", "other", "hematopoietic", "cells", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-12", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "RAR alpha"}, {"start": 13, "end": 15, "entity_type": "cell_type", "text": "HL-60 cells"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "RAR alpha"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "CD38"}, {"start": 28, "end": 30, "entity_type": "cell_type", "text": "hematopoietic cells"}]}
{"tokens": ["Some", "antioxidants", "inhibit", ",", "in", "a", "co-ordinate", "fashion", ",", "the", "production", "of", "tumor", "necrosis", "factor-alpha", ",", "IL-beta", ",", "and", "IL-6", "by", "human", "peripheral", "blood", "mononuclear", "cells", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-0", "entity_mentions": [{"start": 12, "end": 15, "entity_type": "protein", "text": "tumor necrosis factor-alpha"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "IL-beta"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-6"}, {"start": 21, "end": 26, "entity_type": "cell_type", "text": "human peripheral blood mononuclear cells"}]}
{"tokens": ["Some", "antioxidants", ",", "including", "butylated", "hydroxyanisole", "(", "BHA", ")", ",", "tetrahydropapaveroline", "(", "THP", ")", ",", "nordihydroguiauretic", "acid", ",", "and", "10,11-dihydroxyaporphine", "(", "DHA", ")", ",", "were", "found", "to", "be", "potent", "inhibitors", "of", "the", "production", "of", "tumor", "necrosis", "factor", "(", "TNF", ")", "-alpha", ",", "IL-1", "beta", ",", "and", "IL-6", "by", "human", "peripheral", "blood", "mononuclear", "cells", "(", "PBMC", ")", "stimulated", "by", "lipopolysaccharide", "(", "LPS", ")", "(", "IC50s", "in", "the", "low", "micromolar", "range", ")", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-1", "entity_mentions": [{"start": 34, "end": 41, "entity_type": "protein", "text": "tumor necrosis factor ( TNF ) -alpha"}, {"start": 42, "end": 44, "entity_type": "protein", "text": "IL-1 beta"}, {"start": 46, "end": 47, "entity_type": "protein", "text": "IL-6"}, {"start": 48, "end": 53, "entity_type": "cell_type", "text": "human peripheral blood mononuclear cells"}, {"start": 54, "end": 55, "entity_type": "cell_type", "text": "PBMC"}]}
{"tokens": ["Inhibition", "of", "cytokine", "production", "was", "gene", "selective", "and", "not", "due", "to", "general", "effects", "on", "protein", "synthesis", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-2", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "cytokine"}]}
{"tokens": ["Inhibition", "of", "cytokine", "production", "by", "PBMC", "was", "observed", "also", "when", "other", "inducers", "were", "used", "(", "staphylococci", ",", "silica", ",", "zymosan", ")", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-3", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "cytokine"}, {"start": 5, "end": 6, "entity_type": "cell_type", "text": "PBMC"}]}
{"tokens": ["Much", "higher", "concentrations", "of", "other", "antioxidants", "--", "including", "ascorbic", "acid", ",", "trolox", ",", "alpha-tocopherol", ",", "butylated", "hydroxytoluene", ",", "and", "the", "5-lipoxygenase", "inhibitor", "zileuton", "--", "did", "not", "affect", "the", "production", "of", "these", "cytokines", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-4", "entity_mentions": [{"start": 31, "end": 32, "entity_type": "protein", "text": "cytokines"}]}
{"tokens": ["The", "active", "compounds", "did", "not", "inhibit", "IL-1", "-induced", "production", "of", "IL-6", "in", "fibroblasts", ",", "showing", "the", "cell", "selectivity", "of", "the", "effect", "."], "doc_id": "MEDLINE:94242719", "sent_id": "MEDLINE:94242719-5", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "IL-1"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-6"}, {"start": 12, "end": 13, "entity_type": "cell_type", "text": "fibroblasts"}]}
