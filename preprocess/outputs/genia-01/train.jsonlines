{"tokens": ["Mapping", "of", "the", "transcriptional", "repression", "domain", "of", "the", "lymphoid-specific", "transcription", "factor", "oct-2A", "."], "doc_id": "MEDLINE:96278836", "sent_id": "MEDLINE:96278836-0", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "protein", "text": "transcriptional repression domain"}, {"start": 8, "end": 11, "entity_type": "protein", "text": "lymphoid-specific transcription factor"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "oct-2A"}]}
