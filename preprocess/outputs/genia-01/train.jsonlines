{"tokens": ["The", "eukaryotic", "transcription", "factor", "NF-kappa", "B", "plays", "a", "central", "role", "in", "the", "induced", "expression", "of", "human", "immunodeficiency", "virus", "type", "1", "and", "in", "many", "aspects", "of", "the", "genetic", "program", "mediating", "normal", "T-cell", "activation", "and", "growth", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-1", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "protein", "text": "eukaryotic transcription factor"}, {"start": 4, "end": 6, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["The", "nuclear", "activity", "of", "NF-kappa", "B", "is", "tightly", "regulated", "from", "the", "cytoplasmic", "compartment", "by", "an", "inhibitory", "subunit", "called", "I", "kappa", "B", "alpha", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-2", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "inhibitory subunit"}, {"start": 18, "end": 22, "entity_type": "protein", "text": "I kappa B alpha"}]}
{"tokens": ["This", "cytoplasmic", "inhibitor", "is", "rapidly", "phosphorylated", "and", "degraded", "in", "response", "to", "a", "diverse", "set", "of", "NF-kappa", "B", "-inducing", "agents", ",", "including", "T-cell", "mitogens", ",", "proinflammatory", "cytokines", ",", "and", "viral", "transactivators", "such", "as", "the", "Tax", "protein", "of", "human", "T-cell", "leukemia", "virus", "type", "1", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-3", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 15, "end": 19, "entity_type": "protein", "text": "NF-kappa B -inducing agents"}, {"start": 21, "end": 24, "entity_type": "protein", "text": "T-cell mitogens ,"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "proinflammatory cytokines"}, {"start": 28, "end": 30, "entity_type": "protein", "text": "viral transactivators"}, {"start": 33, "end": 35, "entity_type": "protein", "text": "Tax protein"}]}
{"tokens": ["To", "explore", "these", "I", "kappa", "B", "alpha", "-dependent", "mechanisms", "for", "NF-kappa", "B", "induction", ",", "we", "identified", "novel", "mutants", "of", "I", "kappa", "B", "alpha", "that", "uncouple", "its", "inhibitory", "and", "signal-transducing", "functions", "in", "human", "T", "lymphocytes", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-4", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "protein", "text": "I kappa B alpha"}, {"start": 10, "end": 12, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 19, "end": 23, "entity_type": "protein", "text": "I kappa B alpha"}, {"start": 32, "end": 34, "entity_type": "cell_type", "text": "T lymphocytes"}, {"start": 31, "end": 34, "entity_type": "cell_type", "text": "human T lymphocytes"}]}
{"tokens": ["Specifically", ",", "removal", "of", "the", "N-terminal", "36", "amino", "acids", "of", "I", "kappa", "B", "alpha", "failed", "to", "disrupt", "its", "ability", "to", "form", "latent", "complexes", "with", "NF-kappa", "B", "in", "the", "cytoplasm", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-5", "entity_mentions": [{"start": 5, "end": 9, "entity_type": "protein", "text": "N-terminal 36 amino acids"}, {"start": 10, "end": 14, "entity_type": "protein", "text": "I kappa B alpha"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["However", ",", "this", "deletion", "mutation", "prevented", "the", "induced", "phosphorylation", ",", "degradative", "loss", ",", "and", "functional", "release", "of", "I", "kappa", "B", "alpha", "from", "NF-kappa", "B", "in", "Tax", "-expressing", "cells", "."], "doc_id": "MEDLINE:95257963", "sent_id": "MEDLINE:95257963-6", "entity_mentions": [{"start": 17, "end": 21, "entity_type": "protein", "text": "I kappa B alpha"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "Tax"}, {"start": 25, "end": 28, "entity_type": "cell_line", "text": "Tax -expressing cells"}]}
