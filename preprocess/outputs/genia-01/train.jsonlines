{"tokens": ["BACKGROUND", ":", "Recent", "studies", "have", "raised", "the", "hypothesis", "that", "glucocorticoids", "could", "diminish", "the", "ability", "of", "endothelial", "cells", "to", "direct", "leukocyte", "traffic", "into", "inflamed", "tissues", "by", "inhibiting", "expression", "of", "the", "adhesion", "molecules", "endothelial-leukocyte", "adhesion", "molecule-1", "and", "intercellular", "adhesion", "molecule-1", "."], "doc_id": "MEDLINE:97379649", "sent_id": "MEDLINE:97379649-1", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "cell_type", "text": "endothelial cells"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "adhesion molecules"}, {"start": 31, "end": 34, "entity_type": "protein", "text": "endothelial-leukocyte adhesion molecule-1"}, {"start": 35, "end": 38, "entity_type": "protein", "text": "intercellular adhesion molecule-1"}]}
