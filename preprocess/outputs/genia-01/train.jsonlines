{"tokens": ["Overexpression", "of", "protein", "kinase", "C", "-zeta", "stimulates", "leukemic", "cell", "differentiation", "."], "doc_id": "MEDLINE:95151640", "sent_id": "MEDLINE:95151640-0", "entity_mentions": [{"start": 2, "end": 5, "entity_type": "protein", "text": "protein kinase C"}, {"start": 2, "end": 6, "entity_type": "protein", "text": "protein kinase C -zeta"}, {"start": 7, "end": 9, "entity_type": "cell_type", "text": "leukemic cell"}]}
