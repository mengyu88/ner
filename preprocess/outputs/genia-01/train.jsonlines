{"tokens": ["Pyrrolidine", "dithiocarbamate", ",", "a", "potent", "inhibitor", "of", "nuclear", "factor", "kappa", "B", "(", "NF-kappa", "B", ")", "activation", ",", "prevents", "apoptosis", "in", "human", "promyelocytic", "leukemia", "HL-60", "cells", "and", "thymocytes", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-0", "entity_mentions": [{"start": 7, "end": 11, "entity_type": "protein", "text": "nuclear factor kappa B"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 21, "end": 25, "entity_type": "cell_line", "text": "promyelocytic leukemia HL-60 cells"}, {"start": 26, "end": 27, "entity_type": "cell_type", "text": "thymocytes"}]}
{"tokens": ["We", "examined", "the", "effect", "of", "pyrrolidine", "dithiocarbamate", "(", "PDTC", ")", ",", "which", "potently", "blocks", "the", "activation", "of", "nuclear", "factor", "kappa", "B", "(", "NF-kappa", "B", ")", ",", "on", "the", "induction", "of", "apoptosis", "by", "a", "variety", "of", "agents", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-1", "entity_mentions": [{"start": 17, "end": 21, "entity_type": "protein", "text": "nuclear factor kappa B"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["Treatment", "of", "a", "human", "promyelocytic", "leukemia", "cell", "line", ",", "HL-60", ",", "with", "10", "micrograms/mL", "etoposide", "or", "2", "microM", "1-beta-D-arabinofuranosylcytosine", "induced", "NF-kappa", "B", "activation", "within", "1", "hr", "and", "subsequently", "caused", "apoptosis", "within", "3-4", "hr", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-2", "entity_mentions": [{"start": 3, "end": 8, "entity_type": "cell_line", "text": "human promyelocytic leukemia cell line"}, {"start": 9, "end": 10, "entity_type": "cell_line", "text": "HL-60"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "NF-kappa B"}]}
