{"tokens": ["However", ",", "there", "are", "other", "effects", ",", "such", "as", "the", "early", "activation", "of", "protein", "kinase", "C", ",", "which", "are", "probably", "derived", "from", "the", "production", "of", "primary", "DNA", "breakage", "by", "some", "anti-", "topoisomerase", "drugs", "."], "doc_id": "MEDLINE:97209911", "sent_id": "MEDLINE:97209911-10", "entity_mentions": [{"start": 13, "end": 16, "entity_type": "protein", "text": "protein kinase C"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "topoisomerase"}]}
{"tokens": ["GATA-1", "DNA", "binding", "activity", "is", "down-regulated", "in", "late", "S", "phase", "in", "erythroid", "cells", "."], "doc_id": "MEDLINE:97153026", "sent_id": "MEDLINE:97153026-0", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "GATA-1"}, {"start": 11, "end": 13, "entity_type": "cell_type", "text": "erythroid cells"}]}
