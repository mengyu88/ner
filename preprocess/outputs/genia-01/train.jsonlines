{"tokens": ["Human", "leukemia", "HL60", "cells", "respond", "to", "the", "presence", "of", "1,25-dihydroxyvitamin", "D3", "(", "1,25D3", ")", "by", "expressing", "a", "number", "of", "markers", "of", "the", "monocyte/macrophage", "phenotype", "and", "become", "arrested", "predominantly", "in", "the", "G1", "phase", "of", "the", "cell", "cycle", "."], "doc_id": "MEDLINE:97312374", "sent_id": "MEDLINE:97312374-2", "entity_mentions": [{"start": 0, "end": 4, "entity_type": "cell_line", "text": "Human leukemia HL60 cells"}]}
{"tokens": ["We", "have", "recently", "reported", "a", "series", "(", "A", ")", "of", "1,25D3", "-resistant", "variants", "of", "HL60", "cells", "which", "proliferate", "in", "the", "presence", "of", "1,25D3", "and", "do", "not", "express", "differentiation", "markers", "(", "Exp.", "Cell", "Res.", "224", ",", "312", ",", "1996", ")", "."], "doc_id": "MEDLINE:97312374", "sent_id": "MEDLINE:97312374-3", "entity_mentions": [{"start": 14, "end": 16, "entity_type": "cell_line", "text": "HL60 cells"}]}
{"tokens": ["We", "now", "describe", "another", "series", "(", "B", ")", "of", "such", "variants", ",", "which", "differ", "from", "A", "series", "cells", "grown", "in", "similar", "concentrations", "of", "1,25D3", "in", "that", "they", "express", "the", "CD14", "antigen", "and", "nonspecific", "esterase", ",", "characteristic", "of", "the", "monocyte", ",", "while", "continuing", "to", "proliferate", "and", "they", "develop", "hypotetraploid", "DNA", "(", "4C", ")", "content", "at", "higher", "concentrations", "of", "ambient", "1,25D3", "than", "the", "A", "series", "cells", "."], "doc_id": "MEDLINE:97312374", "sent_id": "MEDLINE:97312374-4", "entity_mentions": [{"start": 29, "end": 31, "entity_type": "protein", "text": "CD14 antigen"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "esterase"}]}
