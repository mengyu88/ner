{"tokens": ["In", "the", "present", "study", ",", "analysis", "of", "the", "interleukin-2", "(", "IL-2", ")", "gene", "activation", "shows", "that", "naive", "human", "helper", "T", "cells", "(", "cord", "blood", "CD4+", "T", "cells", ",", "adult", "CD4+CD45RO-", "T", "cells", ")", "regulate", "IL-2", "transcription", "by", "a", "mechanism", "involving", "both", "a", "silencer", "and", "an", "activator", "acting", "on", "the", "purine-rich", "IL-2", "promoter", "elements", "(", "NF-AT", "binding", "sites", ")", "."], "doc_id": "MEDLINE:93314685", "sent_id": "MEDLINE:93314685-2", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "interleukin-2"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-2"}, {"start": 8, "end": 13, "entity_type": "DNA", "text": "interleukin-2 ( IL-2 ) gene"}, {"start": 16, "end": 21, "entity_type": "cell_type", "text": "naive human helper T cells"}, {"start": 22, "end": 27, "entity_type": "cell_type", "text": "cord blood CD4+ T cells"}, {"start": 28, "end": 32, "entity_type": "cell_type", "text": "adult CD4+CD45RO- T cells"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "IL-2"}, {"start": 42, "end": 43, "entity_type": "DNA", "text": "silencer"}, {"start": 45, "end": 46, "entity_type": "DNA", "text": "activator"}, {"start": 49, "end": 53, "entity_type": "DNA", "text": "purine-rich IL-2 promoter elements"}, {"start": 54, "end": 57, "entity_type": "DNA", "text": "NF-AT binding sites"}]}
