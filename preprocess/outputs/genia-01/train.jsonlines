{"tokens": ["Indeed", ",", "addition", "of", "inhibitors", "of", "NF-kappa", "B", "activation", "pyrrolidine", "dithiocarbamate", "(", "PDTC", ")", ",", "to", "the", "lymphocytes", "of", "the", "chemically-exposed", "group", "was", "capable", "of", "inhibiting", "programmed", "cell", "death", "by", "40", "%", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-10", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 17, "end": 18, "entity_type": "cell_type", "text": "lymphocytes"}]}
