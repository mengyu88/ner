{"tokens": ["Although", "IL-10", "alone", "did", "not", "induce", "HIV-1", "replication", ",", "in", "the", "presence", "of", "TNF-alpha", ",", "IL-10", "markedly", "enhanced", "virion", "production", "from", "a", "chronically", "infected", "promonocytic", "cell", "line", "(", "U1", ")", "and", "in", "acutely", "infected", "monocyte-derived", "macrophages", "."], "doc_id": "MEDLINE:96133016", "sent_id": "MEDLINE:96133016-3", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "IL-10"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "TNF-alpha"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IL-10"}, {"start": 24, "end": 27, "entity_type": "cell_line", "text": "promonocytic cell line"}, {"start": 28, "end": 29, "entity_type": "cell_line", "text": "U1"}, {"start": 34, "end": 36, "entity_type": "cell_type", "text": "monocyte-derived macrophages"}]}
{"tokens": ["Neutralizing", "mAbs", "to", "IL-10", "and", "TNF-alpha", "indicated", "that", "both", "cytokines", "were", "essential", "for", "the", "induction", "and", "were", "required", "to", "generate", "a", "synergistic", "increase", "in", "virus", "expression", "."], "doc_id": "MEDLINE:96133016", "sent_id": "MEDLINE:96133016-4", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "mAbs"}, {"start": 3, "end": 4, "entity_type": "protein", "text": "IL-10"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "TNF-alpha"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "cytokines"}]}
{"tokens": ["The", "effects", "of", "the", "two", "cytokines", "were", "distinguishable", "functionally", "since", "pretreatment", "with", "TNF-alpha", "attenuated", "the", "cytokine", "cooperativity", ",", "while", "pretreatment", "with", "IL-10", "potentiated", "their", "cooperativity", ",", "suggesting", "that", "IL-10", "and", "TNF-alpha", "play", "different", "roles", "in", "the", "activation", "of", "virus", "."], "doc_id": "MEDLINE:96133016", "sent_id": "MEDLINE:96133016-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "cytokines"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "TNF-alpha"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "cytokine"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "IL-10"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "IL-10"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "TNF-alpha"}]}
