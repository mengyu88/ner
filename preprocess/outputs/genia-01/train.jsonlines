{"tokens": ["Dexamethasone", "had", "different", "effects", "on", "LPS", "-induced", "TNFalpha", "and", "IL-10", "secretion", ";", "whereas", "it", "suppressed", "TNFalpha", "in", "a", "dose-dependent", "fashion", ",", "its", "effect", "on", "IL-10", "secretion", "was", "biphasic", ",", "producing", "stimulation", "at", "lower", ",", "and", "inhibition", "at", "higher", "doses", "."], "doc_id": "MEDLINE:99371288", "sent_id": "MEDLINE:99371288-7", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "TNFalpha"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "IL-10"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "TNFalpha"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "IL-10"}]}
