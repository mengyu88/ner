{"tokens": ["Gel", "retardation", "assays", "with", "STAT-binding", "oligonucleotides", "showed", "that", "IL-7", "induces", "the", "formation", "of", "two", "major", "STAT", "complexes", "in", "BCP-ALL", "cells", "."], "doc_id": "MEDLINE:96320605", "sent_id": "MEDLINE:96320605-4", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "IL-7"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "STAT complexes"}, {"start": 18, "end": 20, "entity_type": "cell_line", "text": "BCP-ALL cells"}]}
