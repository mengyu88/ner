{"tokens": ["No", "significant", "differences", "were", "found", "in", "the", "immunolabeling", "of", "the", "regulatory", "subunits", "(", "type", "I", "and", "type", "II", ")", "of", "cAMP-dependent", "protein", "kinase", "."], "doc_id": "MEDLINE:99176388", "sent_id": "MEDLINE:99176388-6", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "regulatory subunits"}, {"start": 20, "end": 23, "entity_type": "protein", "text": "cAMP-dependent protein kinase"}]}
