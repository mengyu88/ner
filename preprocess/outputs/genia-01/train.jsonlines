{"tokens": ["Since", "one", "of", "the", "two", "X", "chromosomes", "is", "randomly", "inactivated", "at", "an", "early", "stage", "of", "female", "embryonic", "development", ",", "X-linked", "markers", "have", "been", "used", "to", "study", "the", "origin", "and", "development", "of", "various", "neoplastic", "disorders", "in", "affected", "heterozygous", "women", ";", "clonality", "assays", "have", "provided", "a", "useful", "tool", "to", "the", "understanding", "of", "the", "mechanisms", "underlying", "the", "development", "of", "neoplasia", "."], "doc_id": "MEDLINE:99097163", "sent_id": "MEDLINE:99097163-1", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "DNA", "text": "X chromosomes"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "X-linked markers"}]}
