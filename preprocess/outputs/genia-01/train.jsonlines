{"tokens": ["3", ".", "Peripheral", "blood", "lymphocytes", "(", "PBL", ")", "of", "both", "groups", "were", "tested", "for", "the", "percentage", "of", "apoptotic", "cells", "and", "cell", "cycle", "progression", "using", "flow", "cytometry", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-4", "entity_mentions": [{"start": 2, "end": 5, "entity_type": "cell_type", "text": "Peripheral blood lymphocytes"}, {"start": 6, "end": 7, "entity_type": "cell_type", "text": "PBL"}, {"start": 17, "end": 19, "entity_type": "cell_type", "text": "apoptotic cells"}]}
{"tokens": ["4", ".", "When", "apoptotic", "lymphocytes", "from", "exposed", "individuals", "were", "compared", "to", "apoptotic", "lymphocytes", "from", "the", "control", "group", ",", "statistically-significant", "differences", "between", "each", "mean", "group", "were", "detected", "(", "26.4", "+/-", "1.8", "and", "12.1", "+/-", "1.3", ",", "respectively", ")", ",", "indicating", "an", "increased", "rate", "of", "apoptosis", "in", "80.5", "%", "of", "exposed", "individuals", "(", "P", "<", "0.0001", ",", "Mann-Whitney", "U-Test", ")", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-5", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "cell_type", "text": "apoptotic lymphocytes"}, {"start": 11, "end": 13, "entity_type": "cell_type", "text": "apoptotic lymphocytes"}]}
{"tokens": ["MTBE", "and", "benzene", "-induced", "apoptosis", "is", "attributed", "to", "a", "discrete", "block", "within", "the", "cell", "cycle", "progression", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-6", "entity_mentions": []}
{"tokens": ["Because", "cell", "cycle", "analysis", "showed", "that", "in", "PBL", "from", "chemically-", "exposed", "individuals", ",", "between", "20-50", "%", "of", "cells", "were", "accumulated", "at", "the", "S-G2/M", "boundaries", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-7", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "cell_type", "text": "PBL"}]}
{"tokens": ["5", ".", "One", "of", "the", "signaling", "molecules", "which", "mediates", "programmed", "cell", "death", "is", "nuclear", "factor", "Kappa-B", "(", "NF-kappa", "B", ")", "."], "doc_id": "MEDLINE:97451158", "sent_id": "MEDLINE:97451158-8", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "signaling molecules"}, {"start": 13, "end": 16, "entity_type": "protein", "text": "nuclear factor Kappa-B"}, {"start": 17, "end": 19, "entity_type": "protein", "text": "NF-kappa B"}]}
