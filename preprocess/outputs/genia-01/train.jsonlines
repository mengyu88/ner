{"tokens": ["Under", "these", "conditions", ",", "NF-kappa", "B", "activation", "was", "found", "to", "be", "a", "rapid", "and", "transient", "response", ",", "reaching", "a", "maximum", "by", "10-15", "min", ",", "and", "returning", "to", "near-basal", "levels", "by", "30", "min", "."], "doc_id": "MEDLINE:97420486", "sent_id": "MEDLINE:97420486-3", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "protein", "text": "NF-kappa B"}]}
