{"tokens": ["Type", "I", "IFNs", "(", "IFN-alpha/beta", ")", ",", "in", "addition", "to", "IL-12", ",", "have", "been", "shown", "to", "play", "an", "important", "role", "in", "the", "differentiation", "of", "human", ",", "but", "not", "mouse", ",", "Th", "cells", "."], "doc_id": "MEDLINE:99077519", "sent_id": "MEDLINE:99077519-1", "entity_mentions": [{"start": 0, "end": 3, "entity_type": "protein", "text": "Type I IFNs"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "IFN-alpha/beta"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-12"}, {"start": 30, "end": 32, "entity_type": "cell_type", "text": "Th cells"}]}
