{"tokens": ["We", "now", "show", "that", "a", "depletion", "of", "intracellular", "glutathione", "in", "a", "human", "T", "cell", "line", "(", "Molt-4", ")", "inhibits", "the", "activation", "and", "nuclear", "translocation", "of", "the", "transcription", "factor", "NF", "kappa", "B", ",", "whereas", "incubation", "with", "increasing", "extracellular", "concentrations", "of", "cysteine", "inhibits", "the", "DNA-binding", "and", "transactivating", "activity", "of", "NF", "kappa", "B", "."], "doc_id": "MEDLINE:95301128", "sent_id": "MEDLINE:95301128-2", "entity_mentions": [{"start": 11, "end": 15, "entity_type": "cell_line", "text": "human T cell line"}, {"start": 16, "end": 17, "entity_type": "cell_line", "text": "Molt-4"}, {"start": 28, "end": 31, "entity_type": "protein", "text": "NF kappa B"}, {"start": 26, "end": 31, "entity_type": "protein", "text": "transcription factor NF kappa B"}, {"start": 47, "end": 50, "entity_type": "protein", "text": "NF kappa B"}]}
