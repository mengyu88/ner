{"tokens": ["We", "have", "found", "that", ",", "in", "the", "human", "pro-monocytic", "cell", "line", ",", "THP-1", ",", "the", "lipopolysaccharide", "-induced", "expression", "of", "interleukin", "1beta", "is", "dependent", "on", "tyrosine", "kinase", "activation", "."], "doc_id": "MEDLINE:96324890", "sent_id": "MEDLINE:96324890-4", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "cell_line", "text": "pro-monocytic cell line"}, {"start": 12, "end": 13, "entity_type": "cell_line", "text": "THP-1"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "interleukin 1beta"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "tyrosine kinase"}]}
