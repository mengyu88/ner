{"tokens": ["To", "test", "this", "apparent", "discrepancy", ",", "we", "realized", "that", "HTB", "and", "triflusal", "(", "but", "neither", "aspirin", "nor", "salicylate", ")", "produced", "a", "concentration-dependent", "inhibition", "of", "COX-2", "protein", "expression", "in", "peripheral", "human", "mononuclear", "cells", "."], "doc_id": "MEDLINE:99201482", "sent_id": "MEDLINE:99201482-4", "entity_mentions": [{"start": 24, "end": 25, "entity_type": "protein", "text": "COX-2"}, {"start": 28, "end": 32, "entity_type": "cell_type", "text": "peripheral human mononuclear cells"}]}
{"tokens": ["This", "observation", "was", "further", "confirmed", "in", "a", "rat", "air", "pouch", "model", "in", "vivo", ",", "in", "which", "both", "aspirin", "and", "triflusal", "inhibited", "PGE2", "production", "(", "ID50", "=", "18.9", "and", "11.4", "mg/kg", "p.o.", ",", "respectively", ")", "but", "only", "triflusal", "-treated", "animals", "showed", "a", "decrease", "in", "COX-2", "expression", "."], "doc_id": "MEDLINE:99201482", "sent_id": "MEDLINE:99201482-5", "entity_mentions": [{"start": 43, "end": 44, "entity_type": "protein", "text": "COX-2"}]}
