{"tokens": ["Our", "results", "suggest", "that", "the", "bulk", "of", "protein-DNA", "interactions", "that", "underlies", "the", "developmental", "control", "of", "globin", "genes", "takes", "place", "in", "the", "gamma-", "and", "beta-", "globin", "gene", "promoters", ",", "and", "that", "GT", "motifs", "of", "the", "beta-globin", "locus", "LCR", "may", "play", "a", "role", "in", "the", "developmental", "regulation", "of", "human", "beta-globin", "gene", "expression", ",", "perhaps", "by", "increasing", "the", "probability", "of", "interaction", "of", "the", "LCR", "holocomplex", "with", "the", "fetal", "or", "the", "adult", "globin", "gene", "."], "doc_id": "MEDLINE:96278860", "sent_id": "MEDLINE:96278860-7", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "DNA", "text": "globin genes"}, {"start": 30, "end": 32, "entity_type": "DNA", "text": "GT motifs"}, {"start": 34, "end": 36, "entity_type": "DNA", "text": "beta-globin locus"}, {"start": 36, "end": 37, "entity_type": "DNA", "text": "LCR"}, {"start": 47, "end": 49, "entity_type": "DNA", "text": "beta-globin gene"}, {"start": 60, "end": 61, "entity_type": "DNA", "text": "LCR"}, {"start": 60, "end": 62, "entity_type": "protein", "text": "LCR holocomplex"}]}
