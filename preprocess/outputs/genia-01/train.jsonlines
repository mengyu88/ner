{"tokens": ["A", "family", "of", "serine", "proteases", "expressed", "exclusively", "in", "myelo-", "monocytic", "cells", "specifically", "processes", "the", "nuclear", "factor-kappa", "B", "subunit", "p65", "in", "vitro", "and", "may", "impair", "human", "immunodeficiency", "virus", "replication", "in", "these", "cells", "."], "doc_id": "MEDLINE:95016436", "sent_id": "MEDLINE:95016436-0", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "serine proteases"}, {"start": 9, "end": 11, "entity_type": "cell_type", "text": "monocytic cells"}, {"start": 14, "end": 19, "entity_type": "protein", "text": "nuclear factor-kappa B subunit p65"}]}
{"tokens": ["Two", "groups", "of", "U937", "promonocytic", "cells", "were", "obtained", "by", "limiting", "dilution", "cloning", "which", "differed", "strikingly", "in", "their", "ability", "to", "support", "human", "immunodeficiency", "virus", "1", "(", "HIV-1", ")", "replication", "."], "doc_id": "MEDLINE:95016436", "sent_id": "MEDLINE:95016436-1", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "cell_line", "text": "U937 promonocytic cells"}]}
{"tokens": ["\"", "Plus", "\"", "clones", "replicated", "the", "virus", "efficiently", ",", "whereas", "\"", "minus", "\"", "clones", "did", "not", "."], "doc_id": "MEDLINE:95016436", "sent_id": "MEDLINE:95016436-2", "entity_mentions": [{"start": 0, "end": 4, "entity_type": "cell_line", "text": "\" Plus \" clones"}, {"start": 10, "end": 14, "entity_type": "cell_line", "text": "\" minus \" clones"}]}
{"tokens": ["We", "examined", "these", "clones", "for", "differences", "in", "nuclear", "factor", "(", "NF", ")", "-kappa", "B", "activity", "which", "might", "account", "for", "the", "observed", "phenomenon", "."], "doc_id": "MEDLINE:95016436", "sent_id": "MEDLINE:95016436-3", "entity_mentions": [{"start": 7, "end": 14, "entity_type": "protein", "text": "nuclear factor ( NF ) -kappa B"}]}
{"tokens": ["Stimulation", "of", "plus", "clones", "liberated", "the", "classical", "p50-p65", "complex", "from", "cytoplasmic", "pools", ",", "whereas", "minus", "clones", "produced", "an", "apparently", "novel", ",", "faster-migrating", "complex", ",", "as", "judged", "by", "electrophoretic", "mobility", "shift", "assays", "."], "doc_id": "MEDLINE:95016436", "sent_id": "MEDLINE:95016436-4", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "plus clones"}, {"start": 7, "end": 9, "entity_type": "protein", "text": "p50-p65 complex"}, {"start": 14, "end": 16, "entity_type": "cell_line", "text": "minus clones"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "faster-migrating complex"}]}
