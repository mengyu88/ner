{"tokens": ["Recently", ",", "the", "transcription", "factor", "GATA-3", "was", "shown", "to", "be", "selectively", "expressed", "in", "Th2", "but", "not", "Th1", "cells", "and", "to", "augment", "Th2-specific", "cytokines", "."], "doc_id": "MEDLINE:99060929", "sent_id": "MEDLINE:99060929-1", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "transcription factor"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "GATA-3"}, {"start": 16, "end": 18, "entity_type": "cell_type", "text": "Th1 cells"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "Th2-specific cytokines"}]}
{"tokens": ["Here", ",", "we", "show", "that", "loss", "of", "GATA-3", "expression", "by", "developing", "Th1", "cells", "requires", "IL-12", "signaling", "through", "Stat4", "and", "does", "not", "simply", "result", "from", "an", "absence", "of", "IL-4", "."], "doc_id": "MEDLINE:99060929", "sent_id": "MEDLINE:99060929-2", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "GATA-3"}, {"start": 11, "end": 13, "entity_type": "cell_type", "text": "Th1 cells"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "IL-12"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "Stat4"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "IL-4"}]}
{"tokens": ["Moreover", ",", "we", "demonstrate", "a", "novel", "role", "for", "GATA-3", "in", "directly", "repressing", "Th1", "development", "distinct", "from", "its", "positive", "actions", "on", "Th2-specific", "cytokines", "."], "doc_id": "MEDLINE:99060929", "sent_id": "MEDLINE:99060929-3", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "GATA-3"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "Th2-specific cytokines"}]}
{"tokens": ["GATA-3", "inhibits", "Th1", "cytokines", "by", "a", "cell-intrinsic", "mechanism", "that", "is", "not", "dependent", "on", "IL-4", "and", "that", "may", "involve", "repression", "of", "IL-12", "signaling", "."], "doc_id": "MEDLINE:99060929", "sent_id": "MEDLINE:99060929-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "GATA-3"}, {"start": 2, "end": 4, "entity_type": "protein", "text": "Th1 cytokines"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IL-4"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "IL-12"}]}
{"tokens": ["Thus", ",", "GATA-3", "expression", "and", "IL-12", "signaling", "are", "mutually", "antagonistic", ",", "which", "facilitates", "rapid", "dominance", "of", "one", "pathway", "during", "early", "Th", "development", ",", "producing", "a", "stable", "divergence", "in", "cytokine", "profiles", "."], "doc_id": "MEDLINE:99060929", "sent_id": "MEDLINE:99060929-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "GATA-3"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "IL-12"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "cytokine"}]}
