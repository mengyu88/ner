{"tokens": ["YY1", ",", "a", "widely", "distributed", "human", "transcription", "factor", ",", "is", "known", "to", "inhibit", "HIV-1", "long", "terminal", "repeat", "(", "LTR", ")", "transcription", "and", "virus", "production", "."], "doc_id": "MEDLINE:98037648", "sent_id": "MEDLINE:98037648-3", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "YY1"}, {"start": 5, "end": 8, "entity_type": "protein", "text": "human transcription factor"}, {"start": 13, "end": 17, "entity_type": "DNA", "text": "HIV-1 long terminal repeat"}, {"start": 18, "end": 19, "entity_type": "DNA", "text": "LTR"}]}
