{"tokens": ["To", "understand", "the", "mechanism", "by", "which", "PRL", "regulates", "the", "biphasic", "expression", "of", "IRF-1", ",", "we", "cloned", "the", "rat", "IRF-1", "gene", "and", "functionally", "characterized", "the", "IRF-1", "promoter", "."], "doc_id": "MEDLINE:94285936", "sent_id": "MEDLINE:94285936-2", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "PRL"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "IRF-1"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "IRF-1"}, {"start": 17, "end": 20, "entity_type": "DNA", "text": "rat IRF-1 gene"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "IRF-1"}, {"start": 24, "end": 26, "entity_type": "DNA", "text": "IRF-1 promoter"}]}
