{"tokens": ["Galectin-3", "is", "a", "beta-galactoside-binding", "lectin", "previously", "designated", "as", "epsilon", "BP", "(", "IgE-binding", "protein", ")", ",", "CBP35", ",", "Mac-2", ",", "L-29", ",", "and", "L-34", ",", "and", "its", "expression", "has", "been", "associated", "with", "various", "physiological", "and", "pathological", "processes", ",", "including", "cell", "growth", ",", "tumor", "transformation", ",", "and", "metastasis", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-2", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "beta-galactoside-binding lectin"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "epsilon BP"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "IgE-binding protein"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "CBP35"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "Mac-2"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "L-29"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "L-34"}]}
{"tokens": ["Galectin-3", "is", "widely", "distributed", "in", "various", "tissues", "and", "cell", "types", "and", "is", "expressed", "in", "many", "leukocytes", ",", "with", "the", "notable", "exception", "of", "B", "and", "T", "lymphocytes", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-3", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Galectin-3"}, {"start": 15, "end": 16, "entity_type": "cell_type", "text": "leukocytes"}]}
{"tokens": ["We", "now", "report", "that", "galectin-3", "is", "abundantly", "expressed", "in", "a", "number", "of", "human", "T", "lymphotropic", "virus", "(", "HTLV", ")", "-I", "-infected", "human", "T", "cell", "lines", ",", "including", "F6T", ",", "HUT", "102", ",", "K3T", ",", "MT-2", ",", "and", "SLB-I", ",", "but", "is", "not", "expressed", "in", "non-", "HTLV-I", "-infected", "T", "cell", "lines", "such", "as", "Jurkat", ",", "CEM", ",", "and", "MOLT-4", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-4", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "galectin-3"}, {"start": 12, "end": 25, "entity_type": "cell_line", "text": "human T lymphotropic virus ( HTLV ) -I -infected human T cell lines"}, {"start": 27, "end": 28, "entity_type": "cell_line", "text": "F6T"}, {"start": 29, "end": 31, "entity_type": "cell_line", "text": "HUT 102"}, {"start": 32, "end": 33, "entity_type": "cell_line", "text": "K3T"}, {"start": 34, "end": 35, "entity_type": "cell_line", "text": "MT-2"}, {"start": 37, "end": 38, "entity_type": "cell_line", "text": "SLB-I"}, {"start": 44, "end": 50, "entity_type": "cell_line", "text": "non- HTLV-I -infected T cell lines"}, {"start": 52, "end": 53, "entity_type": "cell_line", "text": "Jurkat"}, {"start": 54, "end": 55, "entity_type": "cell_line", "text": "CEM"}, {"start": 57, "end": 58, "entity_type": "cell_line", "text": "MOLT-4"}]}
{"tokens": ["In", "addition", ",", "the", "galectin-3", "level", "was", "markedly", "increased", "in", "human", "thymocytes", "after", "infection", "with", "HTLV-I", "as", "compared", "with", "uninfected", "thymocytes", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-5", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "galectin-3"}, {"start": 10, "end": 12, "entity_type": "cell_type", "text": "human thymocytes"}, {"start": 19, "end": 21, "entity_type": "cell_type", "text": "uninfected thymocytes"}]}
{"tokens": ["The", "up-regulation", "of", "galectin-3", "expression", "appeared", "to", "correlate", "well", "with", "HTLV-I", "gene", "expression", ",", "as", "undetectable", "or", "very", "low", "levels", "of", "galectin-3", "were", "found", "in", "the", "S1T", "and", "ATL-1K", "cell", "lines", ",", "which", "are", "nonproductively", "infected", "with", "HTLV-I", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-6", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "galectin-3"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "galectin-3"}]}
{"tokens": ["In", "co-transfection", "experiments", ",", "the", "galectin-3", "promoter", "was", "significantly", "up-regulated", "by", "expression", "vectors", "encoding", "the", "40-kd", "Tax", "protein", ",", "a", "potent", "transactivator", "in", "HTLV-I", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-7", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "galectin-3"}, {"start": 5, "end": 7, "entity_type": "DNA", "text": "galectin-3 promoter"}, {"start": 11, "end": 13, "entity_type": "DNA", "text": "expression vectors"}, {"start": 15, "end": 18, "entity_type": "protein", "text": "40-kd Tax protein"}]}
{"tokens": ["Analysis", "of", "various", "Tax", "mutants", "suggested", "that", "galectin-3", "promoter", "induction", "is", "dependent", "on", "activation", "of", "the", "cyclic-AMP", "-responsive", "element", "binding", "protein/activation", "transcription", "factor", "family", "of", "transcription", "factors", "and", ",", "to", "a", "lesser", "extent", ",", "nuclear", "factor-kappa", "B/Rel", "induction", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-8", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "Tax mutants"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "galectin-3"}, {"start": 7, "end": 9, "entity_type": "DNA", "text": "galectin-3 promoter"}, {"start": 16, "end": 24, "entity_type": "protein", "text": "cyclic-AMP -responsive element binding protein/activation transcription factor family"}, {"start": 25, "end": 27, "entity_type": "protein", "text": "transcription factors"}, {"start": 34, "end": 37, "entity_type": "protein", "text": "nuclear factor-kappa B/Rel"}]}
