{"tokens": ["Because", "monocytes", "play", "a", "pivotal", "role", "in", "the", "pathophysiology", "of", "intravascular", "coagulation", "activation", "through", "their", "ability", "to", "synthesize", "tissue", "factor", "(", "TF", ")", ",", "we", "asked", "(", "1", ")", "whether", "monocyte", "TF", "activation", "occurs", "in", "cardiac", "transplant", "recipients", "and", "(", "2", ")", "whether", "monocyte", "TF", "expression", "is", "affected", "by", "treatment", "with", "cyclosporin", "A", "(", "CsA", ")", "."], "doc_id": "MEDLINE:98077369", "sent_id": "MEDLINE:98077369-2", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "cell_type", "text": "monocytes"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "tissue factor"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "TF"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "TF"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "TF"}]}
