{"tokens": ["The", "active", "vitamin", "D3", "metabolite", "1,25-dihydroxycholecalciferol", "(", "1,25(OH)2D3", ")", "acts", "as", "an", "antiproliferative", "and", "differentiating", "agent", "for", "the", "monoblastoid", "cell", "line", "U937", "and", "as", "an", "important", "immunologic", "mediator", "implicated", "particularly", "in", "the", "function", "of", "cells", "belonging", "to", "the", "monocyte/macrophage", "lineage", "."], "doc_id": "MEDLINE:96247660", "sent_id": "MEDLINE:96247660-1", "entity_mentions": [{"start": 18, "end": 22, "entity_type": "cell_line", "text": "monoblastoid cell line U937"}, {"start": 38, "end": 40, "entity_type": "cell_type", "text": "monocyte/macrophage lineage"}]}
{"tokens": ["These", "effects", "are", "controlled", "by", "the", "vitamin", "D", "receptor", "(", "VDR", ")", ",", "a", "member", "of", "the", "steroid", "hormone", "receptor", "family", "."], "doc_id": "MEDLINE:96247660", "sent_id": "MEDLINE:96247660-2", "entity_mentions": [{"start": 6, "end": 9, "entity_type": "protein", "text": "vitamin D receptor"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "VDR"}, {"start": 17, "end": 21, "entity_type": "protein", "text": "steroid hormone receptor family"}]}
{"tokens": ["The", "objective", "of", "this", "study", "was", "to", "develop", "U937", "transfectants", "expressing", "antisense", "VDR", "mRNA", ",", "and", "to", "use", "these", "to", "examine", "the", "role", "of", "1,25(OH)2D3", "-VDR", "interaction", "in", "this", "lineage", "."], "doc_id": "MEDLINE:96247660", "sent_id": "MEDLINE:96247660-3", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "cell_line", "text": "U937"}, {"start": 12, "end": 14, "entity_type": "RNA", "text": "VDR mRNA"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "-VDR"}]}
{"tokens": ["A", "2-kb", "VDR", "cDNA", "insert", "(", "including", "the", "complete", "VDR", "coding", "region", ")", "was", "cloned", "in", "an", "antisense", "orientation", "into", "the", "EBV", "episomal", "vector", "pMEP4", "under", "the", "control", "of", "an", "inducible", "promoter", "and", "transfected", "into", "U937", "."], "doc_id": "MEDLINE:96247660", "sent_id": "MEDLINE:96247660-4", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "VDR"}, {"start": 1, "end": 5, "entity_type": "DNA", "text": "2-kb VDR cDNA insert"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "VDR"}, {"start": 9, "end": 12, "entity_type": "DNA", "text": "VDR coding region"}, {"start": 30, "end": 32, "entity_type": "DNA", "text": "inducible promoter"}, {"start": 35, "end": 36, "entity_type": "cell_line", "text": "U937"}]}
{"tokens": ["The", "resultant", "cell", "line", ",", "DH42", ",", "was", "hygromycin", "resistant", ",", "contained", "VDR", "cDNA", ",", "expressed", "fewer", "VDRs", "than", "controls", ",", "and", "showed", "a", "substantial", "decrease", "in", "antiproliferative", "response", "to", "1,25(OH)2D3", "."], "doc_id": "MEDLINE:96247660", "sent_id": "MEDLINE:96247660-5", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "cell_line", "text": "resultant cell line"}, {"start": 5, "end": 6, "entity_type": "cell_line", "text": "DH42"}, {"start": 12, "end": 14, "entity_type": "DNA", "text": "VDR cDNA"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "VDRs"}]}
