{"tokens": ["However", ",", "Rta", "by", "itself", "is", "less", "potent", "than", "ZEBRA", "in", "the", "ability", "to", "activate", "most", "early", "and", "late", "lytic", "cycle", "genes", "."], "doc_id": "MEDLINE:98406200", "sent_id": "MEDLINE:98406200-7", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "Rta"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "ZEBRA"}, {"start": 19, "end": 22, "entity_type": "DNA", "text": "lytic cycle genes"}]}
