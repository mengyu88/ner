{"tokens": ["Although", "no", "proof", "yet", "exists", "of", "a", "role", "for", "these", "lesions", "in", "DLCL", "pathogenesis", ",", "the", "feature", "of", "the", "BCL-6", "gene", "product", ",", "its", "specific", "pattern", "of", "expression", "in", "B", "cells", ",", "and", "the", "clustering", "of", "lesions", "disrupting", "its", "regulatory", "domain", "strongly", "suggest", "that", "deregulation", "of", "BCL-6", "expression", "may", "contribute", "to", "DLCL", "development", "."], "doc_id": "MEDLINE:96063079", "sent_id": "MEDLINE:96063079-2", "entity_mentions": [{"start": 19, "end": 20, "entity_type": "protein", "text": "BCL-6"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "BCL-6 gene product"}, {"start": 29, "end": 31, "entity_type": "cell_type", "text": "B cells"}, {"start": 46, "end": 47, "entity_type": "protein", "text": "BCL-6"}]}
