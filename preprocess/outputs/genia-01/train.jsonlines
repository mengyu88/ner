{"tokens": ["Our", "finding", "that", "Vpr", "can", "regulate", "NF-kappa", "B", "supports", "the", "hypothesis", "that", "some", "aspects", "of", "viral", "pathogenesis", "are", "the", "consequence", "of", "cell", "dysregulation", "by", "Vpr", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-8", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "Vpr"}, {"start": 6, "end": 8, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "Vpr"}]}
{"tokens": ["Tissue", "transglutaminase-dependent", "posttranslational", "modification", "of", "the", "retinoblastoma", "gene", "product", "in", "promonocytic", "cells", "undergoing", "apoptosis", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-0", "entity_mentions": [{"start": 6, "end": 9, "entity_type": "protein", "text": "retinoblastoma gene product"}, {"start": 10, "end": 12, "entity_type": "cell_line", "text": "promonocytic cells"}]}
{"tokens": ["The", "retinoblastoma", "gene", "product", "(", "pRB", ")", "plays", "an", "important", "role", "in", "controlling", "both", "cell", "release", "from", "the", "G1", "phase", "and", "apoptosis", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-1", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "protein", "text": "retinoblastoma gene product"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "pRB"}]}
{"tokens": ["We", "show", "here", "that", "in", "the", "early", "phases", "of", "apoptosis", ",", "pRB", "is", "posttranslationally", "modified", "by", "a", "tissue", "transglutaminase", "(", "tTG", ")", "-catalyzed", "reaction", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-2", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "pRB"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "tTG"}]}
{"tokens": ["In", "fact", ",", "by", "employing", "a", "novel", "haptenized", "lysis", "synthetic", "substrate", "which", "allows", "the", "isolation", "of", "glutaminyl-tTG", "substrates", "in", "vivo", ",", "we", "identified", "pRB", "as", "a", "potential", "tTG", "substrate", "in", "U937", "cells", "undergoing", "apoptosis", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-3", "entity_mentions": [{"start": 23, "end": 24, "entity_type": "protein", "text": "pRB"}, {"start": 30, "end": 32, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["In", "keeping", "with", "this", "finding", ",", "we", "showed", "that", "apoptosis", "of", "U937", "cells", "is", "characterized", "by", "the", "rapid", "disappearance", "of", "the", "105,000-", "to", "110,000-molecular-weight", "pRB", "forms", "concomitantly", "with", "the", "appearance", "of", "a", "smear", "of", "immunoreactive", "products", "with", "a", "molecular", "weight", "of", "greater", "than", "250,000", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-4", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "pRB"}]}
{"tokens": ["The", "shift", "in", "pRB", "molecular", "weight", "was", "reproduced", "by", "adding", "exogenous", "purified", "tTG", "to", "extracts", "obtained", "from", "viable", "U937", "cells", "and", "was", "prevented", "by", "dansylcadaverine", ",", "a", "potent", "enzyme", "inhibitor", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-5", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "pRB"}, {"start": 18, "end": 20, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["The", "effect", "of", "the", "pRB", "posttranslational", "modification", "during", "apoptosis", "was", "investigated", "by", "determining", "the", "E2F-1", "levels", "and", "by", "isolating", "and", "characterizing", "pRB", "-null", "clones", "from", "U937", "cells", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-6", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "pRB"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "E2F-1"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "pRB"}, {"start": 21, "end": 24, "entity_type": "cell_line", "text": "pRB -null clones"}, {"start": 25, "end": 27, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["Notably", ",", "the", "lack", "of", "pRB", "in", "these", "U937-derived", "clones", "renders", "these", "p53-null", "cells", "highly", "resistant", "to", "apoptosis", "induced", "by", "serum", "withdrawal", ",", "calphostin", "C", ",", "and", "ceramide", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-7", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "pRB"}, {"start": 8, "end": 10, "entity_type": "cell_line", "text": "U937-derived clones"}, {"start": 12, "end": 14, "entity_type": "cell_line", "text": "p53-null cells"}]}
{"tokens": ["Taken", "together", ",", "these", "data", "suggest", "that", "tTG", ",", "acting", "on", "the", "pRB", "protein", ",", "might", "play", "an", "important", "role", "in", "the", "cell", "progression", "through", "the", "death", "program", "."], "doc_id": "MEDLINE:97459703", "sent_id": "MEDLINE:97459703-8", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "tTG"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "pRB"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "pRB protein"}]}
