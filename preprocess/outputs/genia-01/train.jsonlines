{"tokens": ["When", "analyzed", "by", "DNase", "footprinting", ",", "region", "II", "was", "protected", "preferentially", "in", "monocytic", "cells", "."], "doc_id": "MEDLINE:95059037", "sent_id": "MEDLINE:95059037-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "DNase"}, {"start": 6, "end": 8, "entity_type": "DNA", "text": "region II"}, {"start": 12, "end": 14, "entity_type": "cell_type", "text": "monocytic cells"}]}
