{"tokens": ["Aclacinomycin", "(", "ACLA", ")", "and", "doxorubicin", "(", "DOX", ")", "were", "used", "at", "subtoxic", "concentrations", "to", "induce", "erythroid", "differentiation", "in", "the", "human", "leukemic", "cell", "line", "K562", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-1", "entity_mentions": [{"start": 20, "end": 25, "entity_type": "cell_line", "text": "human leukemic cell line K562"}]}
{"tokens": ["Cell", "hemoglobinization", "was", "accompanied", "by", "the", "increased", "expression", "of", "genes", "encoding", "gamma-globin", "and", "porphobilinogen", "deaminase", "(", "PBGD", ")", ",", "an", "enzyme", "of", "heme", "synthesis", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-2", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "DNA", "text": "genes"}, {"start": 11, "end": 15, "entity_type": "protein", "text": "gamma-globin and porphobilinogen deaminase"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "PBGD"}]}
{"tokens": ["By", "using", "run-on", "assays", ",", "ACLA", "was", "shown", "to", "induce", "an", "enhancement", "of", "the", "transcription", "of", "erythroid", "genes", ",", "including", "gamma-globin", ",", "PBGD", ",", "erythropoietin", "receptor", ",", "and", "GATA-1", "transcription", "factor", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-3", "entity_mentions": [{"start": 16, "end": 18, "entity_type": "DNA", "text": "erythroid genes"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "gamma-globin"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "PBGD"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "erythropoietin receptor"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "GATA-1"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "transcription factor"}]}
{"tokens": ["In", "contrast", ",", "in", "DOX", "-treated", "cells", ",", "the", "transcription", "rate", "of", "these", "genes", "was", "unchanged", "in", "comparison", "with", "control", "cells", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-4", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "cell_line", "text": "DOX -treated cells"}, {"start": 13, "end": 14, "entity_type": "DNA", "text": "genes"}, {"start": 19, "end": 21, "entity_type": "cell_type", "text": "control cells"}]}
{"tokens": ["In", "addition", ",", "inhibition", "of", "mRNA", "synthesis", "with", "actinomycin", "D", "indicated", "that", "DOX", "induced", "an", "increased", "stability", "of", "PBGD", "and", "GATA-1", "mRNAs", ",", "whereas", "ACLA", "did", "not", "affect", "the", "half-lives", "of", "these", "mRNAs", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "RNA", "text": "mRNA"}, {"start": 32, "end": 33, "entity_type": "RNA", "text": "mRNAs"}]}
{"tokens": ["Because", "the", "increase", "in", "erythroid", "mRNA", "steady-state", "level", "in", "anthracycline", "-treated", "cells", "was", "inhibited", "by", "cycloheximide", ",", "this", "suggests", "that", "transcriptional", "activation", "in", "ACLA", "-treated", "cells", "and", "mRNA", "stabilization", "in", "DOX", "-treated", "cells", "were", "dependent", "on", "de", "novo", "protein", "synthesis", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-6", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "RNA", "text": "erythroid mRNA"}, {"start": 9, "end": 12, "entity_type": "cell_type", "text": "anthracycline -treated cells"}, {"start": 23, "end": 26, "entity_type": "cell_line", "text": "ACLA -treated cells"}, {"start": 30, "end": 33, "entity_type": "cell_type", "text": "DOX -treated cells"}]}
{"tokens": ["Finally", ",", "GATA-1", "protein", "level", "was", "shown", "to", "be", "increased", "in", "ACLA-treated", "but", "not", "in", "DOX-treated", "cells", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-7", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "GATA-1"}]}
{"tokens": ["These", "two", "anthracyclines", ",", "although", "closely", "related", "in", "their", "structures", ",", "appeared", "to", "act", "as", "differentiation", "inducers", "by", "distinct", "mechanisms", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-8", "entity_mentions": []}
{"tokens": ["Indeed", ",", "erythroid", "gene", "expression", "was", "demonstrated", "to", "be", "regulated", "transcriptionally", "by", "ACLA", "and", "mainly", "posttranscriptionally", "by", "DOX", "."], "doc_id": "MEDLINE:97006605", "sent_id": "MEDLINE:97006605-9", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "DNA", "text": "erythroid gene"}]}
{"tokens": ["Interleukin-7", "signaling", "in", "human", "B", "cell", "precursor", "acute", "lymphoblastic", "leukemia", "cells", "and", "murine", "BAF3", "cells", "involves", "activation", "of", "STAT1", "and", "STAT5", "mediated", "via", "the", "interleukin-7", "receptor", "alpha", "chain", "."], "doc_id": "MEDLINE:96320605", "sent_id": "MEDLINE:96320605-0", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Interleukin-7"}, {"start": 3, "end": 11, "entity_type": "cell_line", "text": "human B cell precursor acute lymphoblastic leukemia cells"}, {"start": 12, "end": 15, "entity_type": "cell_line", "text": "murine BAF3 cells"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "STAT1"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "STAT5"}, {"start": 24, "end": 28, "entity_type": "protein", "text": "interleukin-7 receptor alpha chain"}]}
