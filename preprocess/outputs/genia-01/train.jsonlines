{"tokens": ["METHODS", "AND", "RESULTS", ":", "Incubation", "of", "human", "whole", "blood", "with", "platelet-activating", "factor", "(", "PAF", ",", "1", "mumol/L", ")", "evoked", "downregulation", "of", "L-selectin", "and", "upregulation", "of", "CD11/CD18", "adhesion", "receptors", "on", "neutrophils", "as", "measured", "by", "flow", "cytometry", "."], "doc_id": "MEDLINE:97379649", "sent_id": "MEDLINE:97379649-3", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "platelet-activating factor"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "PAF"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "L-selectin"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "CD11/CD18"}, {"start": 26, "end": 28, "entity_type": "protein", "text": "adhesion receptors"}]}
{"tokens": ["While", "dexamethasone", "(", "0.1", "nmol/L", "to", "100", "mumol/L", ")", "did", "not", "affect", "expression", "of", "adhesion", "molecules", "on", "resting", "neutrophils", ",", "it", "attenuated", "the", "PAF", "-induced", "changes", "in", "L-selectin", "and", "CD18", "expression", "in", "a", "time-", "and", "concentration-dependent", "fashion", "with", "IC50", "values", "of", "31", "and", "13", "nmol/L", ",", "respectively", "."], "doc_id": "MEDLINE:97379649", "sent_id": "MEDLINE:97379649-4", "entity_mentions": [{"start": 14, "end": 16, "entity_type": "protein", "text": "adhesion molecules"}, {"start": 17, "end": 19, "entity_type": "cell_type", "text": "resting neutrophils"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "PAF"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "L-selectin"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "CD18"}]}
