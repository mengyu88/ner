{"tokens": ["Using", "this", "RAR-selective", "antagonist", ",", "and", "RXR", "and", "RAR", "agonist", ",", "we", "demonstrate", "the", "RAR", "-mediated", "signaling", "pathway", "is", "important", "for", "differentiation", "and", "apoptosis", "of", "myeloid", "leukemic", "cells", "."], "doc_id": "MEDLINE:98341858", "sent_id": "MEDLINE:98341858-5", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "RXR"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "RAR"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "RAR"}, {"start": 25, "end": 28, "entity_type": "cell_type", "text": "myeloid leukemic cells"}]}
