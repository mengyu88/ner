{"tokens": ["Studies", "presented", "here", "show", "that", "overall", "NF-kappa", "B", "signal", "transduction", "begins", "with", "a", "parallel", "series", "of", "stimuli-specific", "pathways", "through", "which", "cytokines", "(", "tumor", "necrosis", "factor", "alpha", ")", ",", "oxidants", "(", "hydrogen", "peroxide", "and", "mitomycin", "C", ")", ",", "and", "phorbol", "ester", "(", "phorbol", "12-myristate", "13-acetate", ")", "individually", "initiate", "signaling", "."], "doc_id": "MEDLINE:95062301", "sent_id": "MEDLINE:95062301-1", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "cytokines"}, {"start": 22, "end": 26, "entity_type": "protein", "text": "tumor necrosis factor alpha"}]}
{"tokens": ["These", "initial", "pathways", "culminate", "in", "a", "common", "pathway", "through", "which", "all", "of", "the", "stimulating", "agents", "ultimately", "signal", "NF-kappa", "B", "activation", "."], "doc_id": "MEDLINE:95062301", "sent_id": "MEDLINE:95062301-2", "entity_mentions": [{"start": 17, "end": 19, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["We", "distinguish", "the", "stimuli-specific", "pathways", "by", "showing", "that", "the", "oxidative", "stimuli", "trigger", "NF-kappa", "B", "activation", "in", "only", "one", "of", "two", "human", "T-cell", "lines", "(", "Wurzburg", "but", "not", "Jurkat", ")", ",", "whereas", "tumor", "necrosis", "factor", "alpha", "and", "phorbol", "12-myristate", "13-acetate", "readily", "stimulate", "in", "both", "lines", "."], "doc_id": "MEDLINE:95062301", "sent_id": "MEDLINE:95062301-3", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 20, "end": 23, "entity_type": "cell_line", "text": "human T-cell lines"}, {"start": 24, "end": 25, "entity_type": "cell_line", "text": "Wurzburg"}, {"start": 27, "end": 28, "entity_type": "cell_line", "text": "Jurkat"}, {"start": 31, "end": 35, "entity_type": "protein", "text": "tumor necrosis factor alpha"}]}
{"tokens": ["We", "propose", "the", "common", "pathway", "as", "the", "simplest", "way", "of", "accounting", "for", "the", "common", "requirements", "and", "properties", "of", "the", "signaling", "pathway", "."], "doc_id": "MEDLINE:95062301", "sent_id": "MEDLINE:95062301-4", "entity_mentions": []}
{"tokens": ["We", "include", "a", "redox-regulatory", "mechanism", "(", "s", ")", "in", "this", "common", "pathway", "to", "account", "for", "the", "previously", "demonstrated", "redox", "regulation", "of", "NF-kappa", "B", "activation", "in", "Jurkat", "cells", "(", "in", "which", "oxidants", "do", "n't", "activate", "NF-kappa", "B", ")", ";", "we", "put", "tyrosine", "phosphorylation", "in", "the", "common", "pathway", "by", "showing", "that", "kinase", "activity", "(", "inhibitable", "by", "herbimycin", "A", "and", "tyrphostin", "47", ")", "is", "required", "for", "NF-kappa", "B", "activation", "by", "all", "stimuli", "tested", "in", "both", "cell", "lines", "."], "doc_id": "MEDLINE:95062301", "sent_id": "MEDLINE:95062301-5", "entity_mentions": [{"start": 21, "end": 23, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 25, "end": 27, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 34, "end": 36, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 63, "end": 65, "entity_type": "protein", "text": "NF-kappa B"}]}
