{"tokens": ["Thus", ",", "we", "were", "able", "to", "derive", "a", "hematopoietic", "cell", "line", ",", "called", "47.10", ",", "that", "grew", "indefinitely", "under", "these", "conditions", ",", "whereas", "no", "cell", "line", "could", "be", "developed", "from", "nontransgenic", "mice", "."], "doc_id": "MEDLINE:99120322", "sent_id": "MEDLINE:99120322-4", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "cell_line", "text": "hematopoietic cell line"}, {"start": 13, "end": 14, "entity_type": "cell_line", "text": "47.10"}]}
