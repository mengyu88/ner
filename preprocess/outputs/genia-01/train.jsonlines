{"tokens": ["Our", "results", "suggest", "that", "PKA", "inhibits", "T", "cell", "activation", "by", "interfering", "with", "multiple", "events", "along", "the", "two", "signaling", "pathways", "operating", "downstream", "of", "the", "TCR", "and", "the", "CD28", "co-receptor", "molecules", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-10", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "PKA"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "TCR"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "CD28"}, {"start": 26, "end": 29, "entity_type": "protein", "text": "CD28 co-receptor molecules"}]}
