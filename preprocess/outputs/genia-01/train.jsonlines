{"tokens": ["The", "levels", "of", "cAMP-dependent", "protein", "kinase", "and", "Rap1", "were", "assessed", "by", "Western", "blot", "analysis", ",", "immunostaining", ",", "and", "computer-assisted", "imaging", "."], "doc_id": "MEDLINE:99176388", "sent_id": "MEDLINE:99176388-4", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "protein", "text": "cAMP-dependent protein kinase"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "Rap1"}]}
