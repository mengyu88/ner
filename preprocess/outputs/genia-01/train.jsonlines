{"tokens": ["Increased", "monocyte", "TF", "expression", "in", "transplant", "recipients", "was", "shown", "to", "be", "adversely", "affected", "by", "treatment", "with", "CsA", ":", "TF", "induction", "was", "markedly", "reduced", "by", "CsA", "serum", "concentrations", "reaching", "peak", "CsA", "drug", "levels", "."], "doc_id": "MEDLINE:98077369", "sent_id": "MEDLINE:98077369-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "TF"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "TF"}]}
