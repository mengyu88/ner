{"tokens": ["In", "these", "experiments", ",", "SOCS-3", "associated", "with", "Jak1", "and", "inhibited", "Jak1", "phosphorylation", ",", "and", "this", "inhibition", "was", "markedly", "enhanced", "by", "the", "presence", "of", "IL-2", "receptor", "beta", "chain", "(", "IL-2Rbeta", ")", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-7", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "SOCS-3"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "Jak1"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "Jak1"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "IL-2"}, {"start": 23, "end": 27, "entity_type": "protein", "text": "IL-2 receptor beta chain"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "IL-2Rbeta"}]}
{"tokens": ["Moreover", ",", "following", "IL-2", "stimulation", "of", "T", "cells", ",", "SOCS-3", "was", "able", "to", "interact", "with", "the", "IL-2", "receptor", "complex", ",", "and", "in", "particular", "tyrosine", "phosphorylated", "Jak1", "and", "IL-2Rbeta", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-8", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "IL-2"}, {"start": 6, "end": 8, "entity_type": "cell_type", "text": "T cells"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "SOCS-3"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "IL-2"}, {"start": 16, "end": 19, "entity_type": "protein", "text": "IL-2 receptor complex"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "Jak1"}, {"start": 23, "end": 26, "entity_type": "protein", "text": "tyrosine phosphorylated Jak1"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "IL-2Rbeta"}]}
{"tokens": ["Additionally", ",", "in", "lymphocytes", "expressing", "SOCS-3", "but", "not", "CIS", ",", "IL-2", "-induced", "tyrosine", "phosphorylation", "of", "STAT5b", "was", "markedly", "reduced", ",", "while", "there", "was", "only", "a", "weak", "effect", "on", "IL-3-mediated", "STAT5b", "tyrosine", "phosphorylation", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-9", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "cell_type", "text": "lymphocytes"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "SOCS-3"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "CIS"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-2"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "STAT5b"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "STAT5b"}, {"start": 28, "end": 30, "entity_type": "protein", "text": "IL-3-mediated STAT5b"}]}
{"tokens": ["Finally", ",", "proliferation", "induced", "by", "both", "IL-2", "-", "and", "IL-3", "was", "significantly", "inhibited", "in", "the", "presence", "of", "SOCS-3", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-10", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "IL-2"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "IL-3"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "SOCS-3"}]}
{"tokens": ["The", "findings", "suggest", "that", "when", "SOCS-3", "is", "rapidly", "induced", "by", "IL-2", "in", "T", "cells", ",", "it", "acts", "to", "inhibit", "IL-2", "responses", "in", "a", "classical", "negative", "feedback", "loop", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-11", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "SOCS-3"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-2"}, {"start": 12, "end": 14, "entity_type": "cell_type", "text": "T cells"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-2"}]}
{"tokens": ["Human", "alveolar", "macrophages", "are", "markedly", "deficient", "in", "REF-1", "and", "AP-1", "DNA", "binding", "activity", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-0", "entity_mentions": [{"start": 0, "end": 3, "entity_type": "cell_type", "text": "Human alveolar macrophages"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "REF-1"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["Although", "many", "functions", "of", "human", "alveolar", "macrophages", "are", "altered", "compared", "with", "their", "precursor", "cell", ",", "the", "blood", "monocyte", "(", "monocyte", ")", ",", "the", "reason", "(", "s", ")", "for", "these", "functional", "changes", "have", "not", "been", "determined", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-1", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "cell_type", "text": "human alveolar macrophages"}, {"start": 12, "end": 14, "entity_type": "cell_type", "text": "precursor cell"}, {"start": 16, "end": 18, "entity_type": "cell_type", "text": "blood monocyte"}, {"start": 19, "end": 20, "entity_type": "cell_type", "text": "monocyte"}]}
{"tokens": ["We", "recently", "reported", "that", "human", "alveolar", "macrophages", "do", "not", "express", "AP-1", "DNA", "binding", "activity", "(", "Monick", ",", "M.", "M.", ",", "Carter", ",", "A.", "B.", ",", "Gudmundsson", ",", "G.", ",", "Geist", ",", "L.", "J.", ",", "and", "Hunninghake", ",", "G.", "W.", "(", "1998", ")", "Am.", "J.", "Physiol.", "275", ",", "L389-", "L397", ")", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-2", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "cell_type", "text": "human alveolar macrophages"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["To", "determine", "why", "alveolar", "macrophages", "do", "not", "express", "AP-1", "DNA", "binding", "activity", ",", "we", "first", "showed", "that", "there", "was", "not", "a", "decrease", "in", "expression", "of", "the", "FOS", "and", "JUN", "proteins", "that", "make", "up", "the", "AP-1", "complex", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-3", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "cell_type", "text": "alveolar macrophages"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "AP-1"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["There", "was", ",", "however", ",", "a", "significant", "difference", "in", "the", "amounts", "of", "the", "nuclear", "protein", ",", "REF-1", "(", "which", "regulates", "AP-1", "DNA", "binding", "by", "altering", "the", "redox", "status", "of", "FOS", "and", "JUN", "proteins", ")", ",", "in", "alveolar", "macrophages", "compared", "with", "monocytes", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-4", "entity_mentions": [{"start": 13, "end": 15, "entity_type": "protein", "text": "nuclear protein"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "REF-1"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "AP-1"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "FOS"}, {"start": 31, "end": 33, "entity_type": "protein", "text": "JUN proteins"}, {"start": 36, "end": 38, "entity_type": "cell_type", "text": "alveolar macrophages"}, {"start": 40, "end": 41, "entity_type": "cell_type", "text": "monocytes"}]}
{"tokens": ["In", "addition", ",", "in", "vitro", "differentiation", "of", "monocytes", "to", "a", "macrophage-like", "cell", "resulted", "in", "decreased", "amounts", "of", "REF-1", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-5", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "cell_type", "text": "monocytes"}, {"start": 10, "end": 12, "entity_type": "cell_type", "text": "macrophage-like cell"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "REF-1"}]}
{"tokens": ["Finally", ",", "addition", "of", "REF-1", "from", "activated", "monocytes", "to", "alveolar", "macrophage", "nuclear", "proteins", "resulted", "in", "a", "marked", "increase", "in", "AP-1", "DNA", "binding", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-6", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "REF-1"}, {"start": 6, "end": 8, "entity_type": "cell_type", "text": "activated monocytes"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["These", "studies", "strongly", "suggest", "that", "the", "process", "of", "differentiation", "of", "monocytes", "into", "alveolar", "macrophages", "is", "associated", "with", "a", "loss", "of", "REF-1", "and", "AP-1", "activity", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-7", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "cell_type", "text": "monocytes"}, {"start": 12, "end": 14, "entity_type": "cell_type", "text": "alveolar macrophages"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "REF-1"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["This", "observation", "may", "explain", ",", "in", "part", ",", "some", "of", "the", "functional", "differences", "observed", "for", "alveolar", "macrophages", "compared", "with", "monocytes", "."], "doc_id": "MEDLINE:99292784", "sent_id": "MEDLINE:99292784-8", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "cell_type", "text": "alveolar macrophages"}, {"start": 19, "end": 20, "entity_type": "cell_type", "text": "monocytes"}]}
