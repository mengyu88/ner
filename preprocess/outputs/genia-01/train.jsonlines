{"tokens": ["The", "aim", "of", "this", "study", "was", "to", "examine", "the", "ability", "of", "tumor", "necrosis", "factor", "alpha", "(", "TNFalpha", ",", "a", "proinflammatory", "cytokine", ")", "and", "interleukin", "(", "IL", ")", "-10", "(", "an", "anti-inflammatory", "cytokine", ")", "to", "differentially", "regulate", "the", "sensitivity", "of", "human", "monocytes", "/macrophages", "to", "glucocorticoids", "."], "doc_id": "MEDLINE:99371288", "sent_id": "MEDLINE:99371288-2", "entity_mentions": [{"start": 11, "end": 14, "entity_type": "protein", "text": "tumor necrosis factor"}, {"start": 11, "end": 15, "entity_type": "protein", "text": "tumor necrosis factor alpha"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "TNFalpha"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "proinflammatory cytokine"}, {"start": 23, "end": 28, "entity_type": "protein", "text": "interleukin ( IL ) -10"}, {"start": 30, "end": 32, "entity_type": "protein", "text": "anti-inflammatory cytokine"}, {"start": 39, "end": 41, "entity_type": "cell_type", "text": "human monocytes"}, {"start": 41, "end": 42, "entity_type": "cell_type", "text": "/macrophages"}]}
