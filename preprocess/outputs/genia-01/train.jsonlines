{"tokens": ["In", "this", "study", ",", "we", "have", "characterized", "a", "cellular", "mutant", ",", "the", "70/Z3-derived", "1.3E2", "murine", "pre-B", "cell", "line", ",", "that", "does", "not", "activate", "NF-kappaB", "in", "response", "to", "several", "stimuli", "."], "doc_id": "MEDLINE:97184469", "sent_id": "MEDLINE:97184469-5", "entity_mentions": [{"start": 12, "end": 18, "entity_type": "cell_line", "text": "70/Z3-derived 1.3E2 murine pre-B cell line"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "NF-kappaB"}]}
{"tokens": ["We", "demonstrate", "that", "upon", "stimulation", "by", "lipopolysaccharide", ",", "Taxol", ",", "phorbol", "myristate", "acetate", ",", "interleukin-1", ",", "or", "double-stranded", "RNA", ",", "I", "kappaB", "alpha", "is", "not", "degraded", ",", "as", "a", "result", "of", "an", "absence", "of", "induced", "phosphorylation", "on", "serines", "32", "and", "36", "."], "doc_id": "MEDLINE:97184469", "sent_id": "MEDLINE:97184469-6", "entity_mentions": [{"start": 14, "end": 15, "entity_type": "protein", "text": "interleukin-1"}, {"start": 17, "end": 19, "entity_type": "RNA", "text": "double-stranded RNA"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "I kappaB"}, {"start": 20, "end": 23, "entity_type": "protein", "text": "I kappaB alpha"}]}
