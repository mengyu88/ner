{"tokens": ["Flow", "cytometry", "analysis", "indicated", "that", "these", "cells", "were", "expressing", "high", "levels", "of", "vascular", "cell", "adhesion", "molecule", "1", "(", "VCAM-1", "[", "CD106", "]", ")", ",", "a", "110-kDa", "member", "of", "the", "immunoglobulin", "gene", "superfamily", ",", "first", "identified", "on", "endothelial", "cells", "stimulated", "with", "inflammatory", "cytokines", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-3", "entity_mentions": [{"start": 12, "end": 17, "entity_type": "protein", "text": "vascular cell adhesion molecule 1"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "VCAM-1"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "CD106"}, {"start": 29, "end": 32, "entity_type": "protein", "text": "immunoglobulin gene superfamily"}, {"start": 36, "end": 38, "entity_type": "cell_type", "text": "endothelial cells"}, {"start": 40, "end": 42, "entity_type": "protein", "text": "inflammatory cytokines"}]}
{"tokens": ["This", "adhesion", "molecule", "was", "also", "expressed", "by", "T", "cells", "obtained", "from", "one", "patient", "with", "HTLV-1", "-associated", "myelopathy/tropical", "spastic", "paraparesis", "but", "not", "by", "activated", "T", "cells", "isolated", "from", "one", "normal", "blood", "donor", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-4", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "cell_type", "text": "T cells"}, {"start": 23, "end": 25, "entity_type": "cell_type", "text": "T cells"}, {"start": 22, "end": 25, "entity_type": "cell_type", "text": "activated T cells"}]}
{"tokens": ["The", "role", "of", "the", "viral", "trans-activator", "Tax", "protein", "in", "the", "induction", "of", "VCAM-1", "was", "first", "indicated", "by", "the", "detection", "of", "this", "adhesion", "molecule", "on", "Jurkat", "T-cell", "clones", "stably", "expressing", "the", "tax", "gene", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-5", "entity_mentions": [{"start": 4, "end": 8, "entity_type": "protein", "text": "viral trans-activator Tax protein"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "VCAM-1"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "adhesion molecule"}, {"start": 24, "end": 27, "entity_type": "cell_line", "text": "Jurkat T-cell clones"}]}
{"tokens": ["The", "effect", "of", "Tax", "on", "VCAM-1", "gene", "transcription", "was", "next", "confirmed", "in", "JPX-9", "cells", ",", "a", "subclone", "of", "Jurkat", "cells", ",", "carrying", "the", "tax", "sequences", "under", "the", "control", "of", "an", "inducible", "promoter", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-6", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "Tax"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "VCAM-1"}, {"start": 12, "end": 14, "entity_type": "cell_line", "text": "JPX-9 cells"}, {"start": 18, "end": 20, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 23, "end": 25, "entity_type": "DNA", "text": "tax sequences"}, {"start": 30, "end": 32, "entity_type": "DNA", "text": "inducible promoter"}]}
{"tokens": ["Furthermore", ",", "deletion", "and", "mutation", "analyses", "of", "the", "VCAM-1", "promoter", "performed", "with", "chloramphenicol", "acetyltransferase", "constructs", "revealed", "that", "Tax", "was", "trans", "activating", "the", "VCAM-1", "promoter", "via", "two", "NF-kappaB", "sites", "present", "at", "bp", "-72", "and", "-57", "in", "the", "VCAM-1", "gene", "promoter", ",", "with", "both", "of", "them", "being", "required", "for", "the", "Tax", "-induced", "expression", "of", "this", "adhesion", "molecule", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-7", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "VCAM-1"}, {"start": 8, "end": 10, "entity_type": "DNA", "text": "VCAM-1 promoter"}, {"start": 12, "end": 15, "entity_type": "DNA", "text": "chloramphenicol acetyltransferase constructs"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "Tax"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "VCAM-1"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "VCAM-1 promoter"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 26, "end": 28, "entity_type": "DNA", "text": "NF-kappaB sites"}, {"start": 36, "end": 37, "entity_type": "protein", "text": "VCAM-1"}, {"start": 36, "end": 39, "entity_type": "DNA", "text": "VCAM-1 gene promoter"}, {"start": 48, "end": 49, "entity_type": "protein", "text": "Tax"}, {"start": 53, "end": 55, "entity_type": "protein", "text": "adhesion molecule"}]}
{"tokens": ["Finally", ",", "gel", "mobility", "shift", "assays", "demonstrated", "the", "nuclear", "translocation", "of", "proteins", "specifically", "bound", "to", "these", "two", "NF-kappaB", "motifs", ",", "confirming", "that", "VCAM-1", "was", "induced", "on", "Tax", "-expressing", "cells", "in", "a", "kappaB", "-dependent", "manner", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-8", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 17, "end": 19, "entity_type": "DNA", "text": "NF-kappaB motifs"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "VCAM-1"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "Tax"}, {"start": 26, "end": 29, "entity_type": "cell_line", "text": "Tax -expressing cells"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "kappaB"}]}
{"tokens": ["Collectively", ",", "these", "results", "therefore", "suggest", "that", "the", "exclusive", "Tax", "-induced", "expression", "of", "VCAM-1", "on", "T", "cells", "may", "represent", "a", "pivotal", "event", "in", "the", "progression", "of", "HTLV-1", "-associated", "diseases", "."], "doc_id": "MEDLINE:98001375", "sent_id": "MEDLINE:98001375-9", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "Tax"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "VCAM-1"}, {"start": 15, "end": 17, "entity_type": "cell_type", "text": "T cells"}]}
{"tokens": ["HIV-1", "Vpr", "suppresses", "immune", "activation", "and", "apoptosis", "through", "regulation", "of", "nuclear", "factor", "kappa", "B", "[", "see", "comments", "]"], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-0", "entity_mentions": [{"start": 0, "end": 2, "entity_type": "protein", "text": "HIV-1 Vpr"}, {"start": 10, "end": 14, "entity_type": "protein", "text": "nuclear factor kappa B"}]}
{"tokens": ["The", "HIV-1", "accessory", "gene", "product", "Vpr", "can", "influence", "viral", "pathogenesis", "by", "affecting", "viral", "replication", "as", "well", "as", "host", "cell", "transcription", "and", "proliferation", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-1", "entity_mentions": [{"start": 1, "end": 5, "entity_type": "protein", "text": "HIV-1 accessory gene product"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "Vpr"}]}
{"tokens": ["We", "have", "investigated", "the", "effects", "of", "Vpr", "on", "host", "cell", "activation", "and", "confirm", "that", "it", "influences", "cellular", "proliferation", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-2", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "Vpr"}]}
{"tokens": ["However", ",", "we", "have", "also", "found", "that", "Vpr", "modulates", "T-cell", "receptor", "(", "TCR", ")", "-triggered", "apoptosis", "in", "a", "manner", "similar", "to", "that", "of", "glucocorticoids", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-3", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "Vpr"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "TCR"}]}
{"tokens": ["In", "the", "absence", "of", "TCR", "-mediated", "activation", ",", "Vpr", "induces", "apoptosis", "whereas", "in", "its", "presence", ",", "Vpr", "interrupts", "the", "expected", "induction", "of", "apoptosis", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-4", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "TCR"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "Vpr"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "Vpr"}]}
{"tokens": ["This", "regulation", "of", "apoptosis", "is", "linked", "to", "Vpr", "suppression", "of", "NF-kappa", "B", "activity", "via", "the", "induction", "of", "I", "kappa", "B", ",", "an", "inhibitor", "of", "NF-kappa", "B", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-5", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "Vpr"}, {"start": 10, "end": 12, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 17, "end": 20, "entity_type": "protein", "text": "I kappa B"}, {"start": 24, "end": 26, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["Further", ",", "Vpr", "suppresses", "expression", "of", "IL-2", ",", "IL-10", ",", "IL-12", ",", "TNF", "alpha", "and", "IL-4", ",", "all", "of", "which", "are", "NF-kappa", "B", "-dependent", "."], "doc_id": "MEDLINE:97475199", "sent_id": "MEDLINE:97475199-6", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "Vpr"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "IL-2"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IL-10"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-12"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "TNF alpha"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IL-4"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "NF-kappa B"}]}
