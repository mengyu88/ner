{"tokens": ["However", ",", "the", "specific", "members", "of", "the", "NF-kappa", "B", "/Rel", "transcription", "factor", "family", "involved", "in", "the", "LPS", "response", ",", "and", "the", "mechanisms", "through", "which", "LPS", "-generated", "signals", "are", "transduced", "remain", "unclear", "."], "doc_id": "MEDLINE:93280143", "sent_id": "MEDLINE:93280143-2", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 10, "end": 12, "entity_type": "protein", "text": "transcription factor"}, {"start": 7, "end": 13, "entity_type": "protein", "text": "NF-kappa B /Rel transcription factor family"}]}
