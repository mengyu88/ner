{"tokens": ["CD36", "is", "a", "cell", "surface", "glycoprotein", "composed", "of", "a", "single", "polypeptide", "chain", ",", "which", "interacts", "with", "thrombospondin", ",", "collagens", "type", "I", "and", "IV", ",", "oxidized", "low", "density", "lipoprotein", ",", "fatty", "acids", ",", "anionic", "phospholipids", ",", "and", "erythrocytes", "parasitized", "with", "Plasmodium", "falciparum", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "CD36"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "glycoprotein"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "thrombospondin"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "low density lipoprotein"}, {"start": 36, "end": 37, "entity_type": "cell_type", "text": "erythrocytes"}]}
{"tokens": ["Its", "expression", "is", "restricted", "to", "a", "few", "cell", "types", ",", "including", "monocyte/macrophages", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-2", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "cell_type", "text": "monocyte/macrophages"}]}
{"tokens": ["In", "these", "cells", ",", "CD36", "is", "involved", "in", "phagocytosis", "of", "apoptotic", "cells", ",", "and", "foam", "cell", "formation", "by", "uptake", "of", "oxidized", "low", "density", "lipoprotein", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-3", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "CD36"}, {"start": 10, "end": 12, "entity_type": "cell_type", "text": "apoptotic cells"}, {"start": 20, "end": 24, "entity_type": "protein", "text": "oxidized low density lipoprotein"}]}
{"tokens": ["To", "study", "the", "molecular", "mechanisms", "that", "control", "the", "transcription", "of", "the", "CD36", "gene", "in", "monocytic", "cells", "we", "have", "isolated", "and", "analyzed", "the", "CD36", "promoter", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-4", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "CD36"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "CD36"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "CD36 promoter"}]}
{"tokens": ["Transient", "expression", "experiments", "of", "5'-deletion", "fragments", "of", "the", "CD36", "promoter", "coupled", "to", "luciferase", "demonstrated", "that", "as", "few", "as", "158", "base", "pairs", "upstream", "from", "the", "transcription", "initiation", "site", "were", "sufficient", "to", "direct", "the", "monocyte-specific", "transcription", "of", "the", "reporter", "gene", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-5", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "DNA", "text": "5'-deletion fragments"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "CD36"}, {"start": 8, "end": 10, "entity_type": "DNA", "text": "CD36 promoter"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "luciferase"}, {"start": 18, "end": 22, "entity_type": "DNA", "text": "158 base pairs upstream"}, {"start": 24, "end": 27, "entity_type": "DNA", "text": "transcription initiation site"}, {"start": 36, "end": 38, "entity_type": "DNA", "text": "reporter gene"}]}
{"tokens": ["Within", "the", "above", "region", ",", "the", "fragment", "spanning", "nucleotides", "-158", "to", "-90", "was", "required", "for", "optimal", "transcription", "in", "monocytic", "cells", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-6", "entity_mentions": [{"start": 8, "end": 12, "entity_type": "DNA", "text": "nucleotides -158 to -90"}, {"start": 18, "end": 20, "entity_type": "cell_type", "text": "monocytic cells"}]}
{"tokens": ["Biochemical", "analysis", "of", "the", "region", "-158/-90", "revealed", "a", "binding", "site", "for", "transcription", "factors", "of", "the", "polyomavirus", "enhancer-binding", "protein", "2/core-binding", "factor", "(", "PEBP2/CBF", ")", "family", "at", "position", "-103", "."], "doc_id": "MEDLINE:96205972", "sent_id": "MEDLINE:96205972-7", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "-158/-90"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "transcription factors"}, {"start": 15, "end": 24, "entity_type": "protein", "text": "polyomavirus enhancer-binding protein 2/core-binding factor ( PEBP2/CBF ) family"}, {"start": 25, "end": 27, "entity_type": "DNA", "text": "position -103"}]}
