{"tokens": ["Cloning", "of", "the", "cDNA", "encoding", "human", "SR-BP", "shows", "an", "open", "reading", "frame", "for", "a", "223-amino", "acid", "protein", ",", "which", "is", "homologous", "to", "the", "recently", "cloned", "sigma", "1", "receptor", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-5", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "DNA", "text": "cDNA"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "SR-BP"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "human SR-BP"}, {"start": 9, "end": 12, "entity_type": "DNA", "text": "open reading frame"}, {"start": 14, "end": 17, "entity_type": "protein", "text": "223-amino acid protein"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "sigma 1 receptor"}]}
{"tokens": ["Interestingly", ",", "the", "deduced", "amino", "acid", "sequence", "was", "found", "to", "be", "related", "to", "fungal", "C8-C7", "sterol", "isomerase", ",", "encoded", "by", "the", "ERG2", "gene", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-6", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "protein", "text": "amino acid sequence"}, {"start": 13, "end": 17, "entity_type": "protein", "text": "fungal C8-C7 sterol isomerase"}, {"start": 21, "end": 23, "entity_type": "DNA", "text": "ERG2 gene"}]}
