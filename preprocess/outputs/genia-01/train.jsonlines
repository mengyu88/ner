{"tokens": ["Stable", "transfection", "of", "U937", "cells", "with", "sense", "or", "antisense", "RXR-alpha", "cDNA", "suggests", "a", "role", "for", "RXR-alpha", "in", "the", "control", "of", "monoblastic", "differentiation", "induced", "by", "retinoic", "acid", "and", "vitamin", "D", "."], "doc_id": "MEDLINE:98005040", "sent_id": "MEDLINE:98005040-0", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 8, "end": 11, "entity_type": "DNA", "text": "antisense RXR-alpha cDNA"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "RXR-alpha"}]}
{"tokens": ["Although", "retinoic", "acid", "(", "RA", ")", "has", "been", "known", "for", "many", "years", "to", "be", "a", "modulating", "agent", "that", "plays", "a", "role", "in", "generating", "both", "granulocytes", "and", "monocytes", ",", "the", "molecular", "mechanism", "underlying", "this", "role", "has", "not", "been", "defined", "in", "the", "monoblast", "lineage", "."], "doc_id": "MEDLINE:98005040", "sent_id": "MEDLINE:98005040-1", "entity_mentions": [{"start": 24, "end": 25, "entity_type": "cell_type", "text": "granulocytes"}, {"start": 26, "end": 27, "entity_type": "cell_type", "text": "monocytes"}, {"start": 40, "end": 42, "entity_type": "cell_type", "text": "monoblast lineage"}]}
