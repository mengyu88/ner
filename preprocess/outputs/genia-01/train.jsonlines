{"tokens": ["Furthermore", ",", "we", "evaluated", "the", "mineralocorticoid", "receptor", "(", "MR", ")", "count", "in", "mononuclear", "leukocytes", "in", "the", "2", "groups", "."], "doc_id": "MEDLINE:93244226", "sent_id": "MEDLINE:93244226-5", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "mineralocorticoid receptor"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "MR"}, {"start": 12, "end": 14, "entity_type": "cell_type", "text": "mononuclear leukocytes"}]}
