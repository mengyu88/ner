{"tokens": ["We", "have", "shown", "that", "the", "apparent", "binding", "affinity", "of", "the", "glucocorticoid", "receptor", "in", "squirrel", "monkey", "lymphocytes", "is", "5-fold", "lower", "than", "that", "in", "human", "lymphocytes", "(", "apparent", "Kd", ",", "20.9", "+/-", "1.8", "and", "4.3", "+/-", "0.2", "nmol/L", ",", "respectively", ";", "n", "=", "3", ")", ",", "consistent", "with", "previous", "studies", "in", "mononuclear", "leukocytes", "isolated", "from", "the", "two", "species", "."], "doc_id": "MEDLINE:97176699", "sent_id": "MEDLINE:97176699-2", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 13, "end": 16, "entity_type": "cell_type", "text": "squirrel monkey lymphocytes"}, {"start": 22, "end": 24, "entity_type": "cell_type", "text": "human lymphocytes"}, {"start": 49, "end": 51, "entity_type": "cell_type", "text": "mononuclear leukocytes"}]}
