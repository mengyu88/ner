{"tokens": ["The", "aim", "of", "the", "present", "study", "was", "to", "investigate", "the", "effects", "of", "oxidized", "LDL", "(", "oxLDL", ")", "on", "the", "NF-kappa", "B", "system", "in", "human", "THP-1", "monocytic", "cells", "as", "well", "as", "adherent", "monocytes", "."], "doc_id": "MEDLINE:98012705", "sent_id": "MEDLINE:98012705-2", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "protein", "text": "oxidized LDL"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "oxLDL"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 24, "end": 27, "entity_type": "cell_line", "text": "THP-1 monocytic cells"}, {"start": 30, "end": 32, "entity_type": "cell_type", "text": "adherent monocytes"}]}
{"tokens": ["Our", "results", "demonstrate", "that", "short-term", "incubation", "of", "these", "cells", "with", "oxLDL", "activated", "p50/p65", "containing", "NF-kappa", "B", "dimers", "and", "induced", "the", "expression", "of", "the", "target", "gene", "IL-8", "."], "doc_id": "MEDLINE:98012705", "sent_id": "MEDLINE:98012705-3", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "oxLDL"}, {"start": 10, "end": 13, "entity_type": "protein", "text": "oxLDL activated p50/p65"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 14, "end": 17, "entity_type": "protein", "text": "NF-kappa B dimers"}, {"start": 23, "end": 26, "entity_type": "DNA", "text": "target gene IL-8"}]}
