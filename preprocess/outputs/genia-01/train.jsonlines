{"tokens": ["Reduction", "of", "IL-2", "production", "is", "secondary", "to", "the", "inability", "to", "phosphorylate", "the", "cAMP", "response", "element", "binding", "protein", ",", "CREB", ",", "and", "induce", "expression", "of", "the", "immediate", "early", "genes", "such", "as", "Fos", "B", "that", "are", "required", "to", "transactivate", "the", "IL-2", "promoter", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "IL-2"}, {"start": 12, "end": 17, "entity_type": "protein", "text": "cAMP response element binding protein"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "CREB"}, {"start": 25, "end": 28, "entity_type": "DNA", "text": "immediate early genes"}, {"start": 30, "end": 32, "entity_type": "DNA", "text": "Fos B"}, {"start": 38, "end": 39, "entity_type": "protein", "text": "IL-2"}, {"start": 38, "end": 40, "entity_type": "DNA", "text": "IL-2 promoter"}]}
{"tokens": ["Because", "transgene", "expression", "was", "regulated", "by", "the", "proximal", "promoter", "of", "the", "murine", "lck", "gene", "and", "this", "promoter", "is", "inactivated", "in", "T", "cells", "that", "exit", "the", "thymus", ",", "the", "mutant", "hCaMKIV", "is", "not", "present", "in", "peripheral", "T", "cells", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-6", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "DNA", "text": "proximal promoter"}, {"start": 11, "end": 14, "entity_type": "DNA", "text": "murine lck gene"}, {"start": 20, "end": 22, "entity_type": "cell_type", "text": "T cells"}, {"start": 28, "end": 30, "entity_type": "protein", "text": "mutant hCaMKIV"}, {"start": 34, "end": 37, "entity_type": "cell_type", "text": "peripheral T cells"}]}
{"tokens": ["Consequently", ",", "T", "lymphocytes", "present", "in", "the", "spleen", "can", "be", "activated", "normally", "in", "response", "to", "either", "stimulus", "mentioned", "above", ",", "demonstrating", "that", "the", "effects", "of", "the", "inactive", "CaMKIV", "on", "activation", "are", "reversible", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-7", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_type", "text": "T lymphocytes"}, {"start": 26, "end": 28, "entity_type": "protein", "text": "inactive CaMKIV"}]}
