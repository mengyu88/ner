{"tokens": ["DZA", "inhibits", "the", "transcriptional", "activity", "of", "NF-kappaB", "through", "the", "hindrance", "of", "p65", "(", "Rel-A", ")", "phosphorylation", "without", "reduction", "of", "its", "nuclear", "translocation", "and", "DNA", "binding", "activity", "."], "doc_id": "MEDLINE:99315834", "sent_id": "MEDLINE:99315834-4", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "p65"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "Rel-A"}]}
