{"tokens": ["We", "show", "that", "in", "parental", "K562", "cells", ",", "the", "HSF2-alpha", "isoform", "is", "predominantly", "expressed", "and", "HSF2", "can", "be", "activated", "upon", "hemin", "treatment", "."], "doc_id": "MEDLINE:97326105", "sent_id": "MEDLINE:97326105-4", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "cell_line", "text": "K562 cells"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "HSF2-alpha"}, {"start": 9, "end": 11, "entity_type": "protein", "text": "HSF2-alpha isoform"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "HSF2"}]}
{"tokens": ["In", "contrast", ",", "when", "HSF2-beta", "is", "expressed", "at", "levels", "exceeding", "those", "of", "endogenous", "HSF2-alpha", ",", "the", "hemin-induced", "DNA", "binding", "activity", "and", "transcription", "of", "heat", "shock", "genes", "are", "repressed", ",", "whereas", "overexpression", "of", "HSF2-alpha", "results", "in", "an", "enhanced", "hemin", "response", "."], "doc_id": "MEDLINE:97326105", "sent_id": "MEDLINE:97326105-5", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "HSF2-beta"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "HSF2-alpha"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "endogenous HSF2-alpha"}, {"start": 23, "end": 26, "entity_type": "DNA", "text": "heat shock genes"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "HSF2-alpha"}, {"start": 37, "end": 38, "entity_type": "protein", "text": "hemin"}]}
