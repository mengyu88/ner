{"tokens": ["In", "this", "paper", ",", "we", "show", "that", "HCMV", "down", "regulates", "gamma", "interferon", "(", "IFN-gamma", ")", "-induced", "HLA-DR", "expression", "in", "U373", "MG", "astrocytoma", "cells", "due", "to", "a", "defect", "downstream", "of", "STAT1", "phosphorylation", "and", "nuclear", "translocation", "."], "doc_id": "MEDLINE:99329182", "sent_id": "MEDLINE:99329182-2", "entity_mentions": [{"start": 13, "end": 14, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "HLA-DR"}, {"start": 19, "end": 23, "entity_type": "cell_line", "text": "U373 MG astrocytoma cells"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "STAT1"}]}
{"tokens": ["Repression", "of", "class", "II", "transactivator", "(", "CIITA", ")", "mRNA", "expression", "is", "detected", "within", "the", "first", "hours", "of", "IFN-gamma", "-HCMV", "coincubation", "and", "results", "in", "the", "absence", "of", "HLA-DR", "synthesis", "."], "doc_id": "MEDLINE:99329182", "sent_id": "MEDLINE:99329182-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "DNA", "text": "CIITA"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "HLA-DR"}]}
