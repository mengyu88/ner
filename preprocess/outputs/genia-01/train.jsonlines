{"tokens": ["Here", "we", "report", "that", "binding", "of", "human", "IL-2", "to", "its", "binding", "site", "leads", "to", "transcriptional", "activation", "of", "the", "macrophage", "CSF", "(", "M-CSF", ")", "gene", "in", "Mo", "resulting", "in", "accumulation", "of", "M-CSF", "mRNA", "and", "subsequent", "release", "of", "bioactive", "M-CSF", "protein", "as", "demonstrated", "by", "ELISA", "and", "inhibition", "of", "IL-2", "induced", "release", "of", "an", "activity-stimulating", "growth", "of", "monocyte-type", "colonies", "by", "a", "neutralizing", "anti-M-CSF", "antibody", "."], "doc_id": "MEDLINE:93294310", "sent_id": "MEDLINE:93294310-2", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "human IL-2"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "M-CSF"}, {"start": 18, "end": 24, "entity_type": "DNA", "text": "macrophage CSF ( M-CSF ) gene"}, {"start": 25, "end": 26, "entity_type": "cell_type", "text": "Mo"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "M-CSF"}, {"start": 30, "end": 32, "entity_type": "RNA", "text": "M-CSF mRNA"}, {"start": 37, "end": 39, "entity_type": "protein", "text": "M-CSF protein"}, {"start": 46, "end": 47, "entity_type": "protein", "text": "IL-2"}, {"start": 54, "end": 56, "entity_type": "cell_line", "text": "monocyte-type colonies"}, {"start": 59, "end": 61, "entity_type": "protein", "text": "anti-M-CSF antibody"}]}
{"tokens": ["Transcriptional", "activation", "of", "the", "M-CSF", "gene", "by", "IL-2", "is", "preceded", "by", "enhanced", "binding", "activity", "of", "the", "transcription", "factor", "NF-kappa", "B", "to", "its", "recognition", "sequence", "in", "the", "5'", "regulatory", "enhancer", "region", "of", "the", "M-CSF", "gene", "."], "doc_id": "MEDLINE:93294310", "sent_id": "MEDLINE:93294310-3", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "DNA", "text": "M-CSF gene"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "IL-2"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "transcription factor"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 32, "end": 34, "entity_type": "DNA", "text": "M-CSF gene"}]}
{"tokens": ["Moreover", ",", "using", "a", "heterologous", "promoter", "(", "herpes", "thymidine", "kinase", ")", "construct", "containing", "the", "NF-kappa", "B", "consensus", "sequence", ",", "it", "is", "shown", "that", "NF-kappa", "B", "binding", "by", "an", "IL-2", "-induced", "monocyte-derived", "nuclear", "protein", "confers", "reporter", "gene", "(", "human", "growth", "hormone", ")", "activity", "."], "doc_id": "MEDLINE:93294310", "sent_id": "MEDLINE:93294310-4", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "DNA", "text": "heterologous promoter"}, {"start": 7, "end": 10, "entity_type": "protein", "text": "herpes thymidine kinase"}, {"start": 4, "end": 12, "entity_type": "DNA", "text": "heterologous promoter ( herpes thymidine kinase ) construct"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 14, "end": 18, "entity_type": "DNA", "text": "NF-kappa B consensus sequence"}, {"start": 23, "end": 25, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "IL-2"}, {"start": 28, "end": 33, "entity_type": "protein", "text": "IL-2 -induced monocyte-derived nuclear protein"}]}
{"tokens": ["Taken", "together", ",", "our", "findings", "indicate", "that", "IL-2", "induces", "gene", "expression", "of", "M-CSF", "in", "human", "blood-derived", "Mo", "and", "provide", "evidence", "for", "involvement", "of", "NF-kappa", "B", "in", "transcriptional", "regulation", "of", "this", "gene", "."], "doc_id": "MEDLINE:93294310", "sent_id": "MEDLINE:93294310-5", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "IL-2"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "M-CSF"}, {"start": 16, "end": 17, "entity_type": "cell_type", "text": "Mo"}, {"start": 14, "end": 17, "entity_type": "cell_type", "text": "human blood-derived Mo"}, {"start": 23, "end": 25, "entity_type": "protein", "text": "NF-kappa B"}]}
{"tokens": ["Regulation", "of", "the", "interleukin-1", "beta", "(", "IL-1", "beta", ")", "gene", "by", "mycobacterial", "components", "and", "lipopolysaccharide", "is", "mediated", "by", "two", "nuclear", "factor-IL6", "motifs", "."], "doc_id": "MEDLINE:93268332", "sent_id": "MEDLINE:93268332-0", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "protein", "text": "IL-1 beta"}, {"start": 3, "end": 10, "entity_type": "DNA", "text": "interleukin-1 beta ( IL-1 beta ) gene"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "mycobacterial components"}, {"start": 19, "end": 22, "entity_type": "DNA", "text": "nuclear factor-IL6 motifs"}]}
{"tokens": ["The", "cytokines", "interleukin-1", "beta", "(", "IL-1", "beta", ")", "and", "tumor", "necrosis", "factor", "alpha", "(", "TNF-alpha", ")", "are", "released", "by", "mononuclear", "phagocytes", "in", "vitro", "after", "stimulation", "with", "mycobacteria", "and", "are", "considered", "to", "mediate", "pathophysiologic", "events", ",", "including", "granuloma", "formation", "and", "systemic", "symptoms", "."], "doc_id": "MEDLINE:93268332", "sent_id": "MEDLINE:93268332-1", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "IL-1 beta"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "TNF-alpha"}, {"start": 19, "end": 21, "entity_type": "cell_type", "text": "mononuclear phagocytes"}]}
{"tokens": ["We", "demonstrated", "that", "the", "Mycobacterium", "tuberculosis", "cell", "wall", "component", "lipoarabinomannan", "(", "LAM", ")", "is", "a", "very", "potent", "inducer", "of", "IL-1", "beta", "gene", "expression", "in", "human", "monocytes", "and", "investigated", "the", "mechanism", "of", "this", "effect", "."], "doc_id": "MEDLINE:93268332", "sent_id": "MEDLINE:93268332-2", "entity_mentions": [{"start": 19, "end": 22, "entity_type": "DNA", "text": "IL-1 beta gene"}, {"start": 24, "end": 26, "entity_type": "cell_type", "text": "human monocytes"}]}
