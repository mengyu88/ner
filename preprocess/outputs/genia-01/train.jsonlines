{"tokens": ["The", "IRF-2", "promoter", "region", "contains", "a", "CpG", "island", ",", "with", "several", "GC", "boxes", ",", "a", "putative", "NF-kappa", "B", "-binding", "site", ",", "and", "a", "CAAT", "box", ",", "but", "no", "TATA", "box", "."], "doc_id": "MEDLINE:94148994", "sent_id": "MEDLINE:94148994-4", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "IRF-2"}, {"start": 2, "end": 4, "entity_type": "DNA", "text": "promoter region"}, {"start": 6, "end": 8, "entity_type": "DNA", "text": "CpG island"}, {"start": 11, "end": 13, "entity_type": "DNA", "text": "GC boxes"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 16, "end": 20, "entity_type": "DNA", "text": "NF-kappa B -binding site"}, {"start": 23, "end": 25, "entity_type": "DNA", "text": "CAAT box"}, {"start": 28, "end": 30, "entity_type": "DNA", "text": "TATA box"}]}
