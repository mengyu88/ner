{"tokens": ["Functionally", ",", "galectin-3", "was", "shown", "to", "activate", "interleukin-2", "production", "in", "Jurkat", "T", "cells", "."], "doc_id": "MEDLINE:96208140", "sent_id": "MEDLINE:96208140-10", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "galectin-3"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "interleukin-2"}, {"start": 10, "end": 13, "entity_type": "cell_type", "text": "Jurkat T cells"}]}
