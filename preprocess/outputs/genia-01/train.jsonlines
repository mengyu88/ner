{"tokens": ["Finally", ",", "we", "show", "that", "a", "DNA", "fragment", "containing", "the", "human", "GATA3", "transcription", "unit", ",", "3", "kb", "upstream", "from", "the", "initiation", "site", "and", "4", "kb", "downstream", "from", "the", "polyadenylation", "site", ",", "displays", "T-cell", "specificity", "."], "doc_id": "MEDLINE:94375000", "sent_id": "MEDLINE:94375000-7", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "DNA", "text": "DNA fragment"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "GATA3"}, {"start": 10, "end": 14, "entity_type": "DNA", "text": "human GATA3 transcription unit"}, {"start": 15, "end": 18, "entity_type": "DNA", "text": "3 kb upstream"}, {"start": 20, "end": 22, "entity_type": "DNA", "text": "initiation site"}, {"start": 23, "end": 26, "entity_type": "DNA", "text": "4 kb downstream"}, {"start": 28, "end": 30, "entity_type": "DNA", "text": "polyadenylation site"}]}
