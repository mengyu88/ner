{"tokens": ["Functional", "studies", "in", "extrarenal", ",", "non-epithelial", "cells", "such", "as", "smooth", "muscle", "cells", "and", "more", "recently", "circulating", "human", "lymphocytes", "have", "provided", "increasing", "evidence", "that", "aldosterone", "produces", "not", "only", "classical", "genomic", "effects", ",", "but", "also", "rapid", ",", "non-genomic", "effects", "on", "transmembrane", "electrolyte", "movements", "."], "doc_id": "MEDLINE:93246027", "sent_id": "MEDLINE:93246027-1", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "cell_type", "text": "extrarenal , non-epithelial cells"}, {"start": 9, "end": 12, "entity_type": "cell_type", "text": "smooth muscle cells"}, {"start": 16, "end": 18, "entity_type": "cell_type", "text": "human lymphocytes"}, {"start": 15, "end": 18, "entity_type": "cell_type", "text": "circulating human lymphocytes"}]}
