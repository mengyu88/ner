{"tokens": ["This", "raises", "the", "possibility", "that", "androgen", "receptors", "in", "peripheral", "mononuclear", "leukocytes", "differ", "from", "those", "in", "genital", "skin", "fibroblasts", "."], "doc_id": "MEDLINE:94190839", "sent_id": "MEDLINE:94190839-6", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "androgen receptors"}, {"start": 8, "end": 11, "entity_type": "cell_type", "text": "peripheral mononuclear leukocytes"}, {"start": 15, "end": 18, "entity_type": "cell_type", "text": "genital skin fibroblasts"}]}
