{"tokens": ["Finally", ",", "it", "is", "demonstrated", "that", "macrophages", "in", "the", "adrenal", "gland", ",", "the", "major", "site", "of", "endogenous", "GC", "production", ",", "express", "sialoadhesin", "."], "doc_id": "MEDLINE:96413262", "sent_id": "MEDLINE:96413262-11", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "cell_type", "text": "macrophages"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "sialoadhesin"}]}
