{"tokens": ["However", ",", "ILT-mat", "cells", "and", "ATL16T(-)", "cells", ",", "although", "they", "were", "ATL", "cells", ",", "showed", "rather", "low", "surface", "ICAM-1", "expression", "and", "ICAM-1", "mRNA", "expression", "."], "doc_id": "MEDLINE:97362594", "sent_id": "MEDLINE:97362594-4", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "ILT-mat cells"}, {"start": 5, "end": 7, "entity_type": "cell_line", "text": "ATL16T(-) cells"}, {"start": 11, "end": 13, "entity_type": "cell_line", "text": "ATL cells"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "ICAM-1"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "ICAM-1"}, {"start": 21, "end": 23, "entity_type": "RNA", "text": "ICAM-1 mRNA"}]}
{"tokens": ["Southern", "blot", "hybridization", "showed", "that", "only", "two", "and", "four", "bands", "were", "found", "in", "ILT-mat", "and", "ATL16T(-)", "cells", ",", "respectively", ",", "whereas", ">", "10", "bands", "were", "detected", "in", "other", "ATL", "cells", "."], "doc_id": "MEDLINE:97362594", "sent_id": "MEDLINE:97362594-5", "entity_mentions": [{"start": 13, "end": 14, "entity_type": "cell_line", "text": "ILT-mat"}, {"start": 15, "end": 17, "entity_type": "cell_line", "text": "ATL16T(-) cells"}, {"start": 28, "end": 30, "entity_type": "cell_line", "text": "ATL cells"}]}
