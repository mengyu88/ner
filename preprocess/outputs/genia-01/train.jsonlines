{"tokens": ["In", "this", "study", "we", "show", "that", "the", "structurally", "unrelated", "antioxidant", "agents", "pyrrolidine", "dithiocarbamate", "(", "PDTC", ")", ",", "butylated", "hydroxyanisole", ",", "and", "Nacetylcysteine", "activated", "JNK", "(", "c-Jun", "NH2-terminal", "kinase", ")", "in", "Jurkat", "T", "cells", "."], "doc_id": "MEDLINE:96421639", "sent_id": "MEDLINE:96421639-3", "entity_mentions": [{"start": 23, "end": 24, "entity_type": "protein", "text": "JNK"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "c-Jun NH2-terminal kinase"}, {"start": 30, "end": 33, "entity_type": "cell_line", "text": "Jurkat T cells"}]}
{"tokens": ["This", "activation", "differed", "substantially", "from", "that", "mediated", "by", "phorbol", "12-myristate", "13-acetate", "(", "PMA", ")", "and", "Ca2+", "ionophore", "or", "produced", "by", "costimulation", "with", "antibodies", "against", "the", "T", "cell", "receptor-CD3", "complex", "and", "to", "CD28", "."], "doc_id": "MEDLINE:96421639", "sent_id": "MEDLINE:96421639-4", "entity_mentions": [{"start": 22, "end": 23, "entity_type": "protein", "text": "antibodies"}, {"start": 25, "end": 29, "entity_type": "protein", "text": "T cell receptor-CD3 complex"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "CD28"}]}
{"tokens": ["The", "activation", "of", "JNK", "by", "classical", "T", "cell", "stimuli", "was", "transient", ",", "whereas", "that", "mediated", "by", "PDTC", "and", "butylated", "hydroxyanisole", "(", "but", "not", "N-acetylcysteine", ")", "was", "sustained", "."], "doc_id": "MEDLINE:96421639", "sent_id": "MEDLINE:96421639-5", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "JNK"}]}
