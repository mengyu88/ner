{"tokens": ["Significance", "of", "quantitative", "analysis", "of", "AML1", "/ETO", "transcripts", "in", "peripheral", "blood", "stem", "cells", "from", "t(8;21)", "acute", "myelogenous", "leukemia", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-0", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "AML1"}, {"start": 5, "end": 8, "entity_type": "RNA", "text": "AML1 /ETO transcripts"}, {"start": 9, "end": 13, "entity_type": "cell_type", "text": "peripheral blood stem cells"}]}
{"tokens": ["Autologous", "peripheral", "blood", "stem", "cell", "transplantation", "(", "PBSCT", ")", "is", "replacing", "autologous", "bone", "marrow", "transplantation", "(", "BMT", ")", "in", "the", "treatment", "of", "leukemia", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-1", "entity_mentions": [{"start": 1, "end": 5, "entity_type": "cell_type", "text": "peripheral blood stem cell"}]}
{"tokens": ["One", "of", "the", "potential", "advantages", "of", "autologous", "PBSCT", "is", "the", "possibility", "that", "peripheral", "blood", "stem", "cells", "(", "PBSC", ")", "are", "less", "likely", "to", "be", "contaminated", "by", "leukemic", "cells", "than", "bone", "marrow", "grafts", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-2", "entity_mentions": [{"start": 12, "end": 16, "entity_type": "cell_type", "text": "peripheral blood stem cells"}, {"start": 17, "end": 18, "entity_type": "cell_type", "text": "PBSC"}, {"start": 26, "end": 28, "entity_type": "cell_type", "text": "leukemic cells"}]}
{"tokens": ["However", ",", "the", "major", "problem", "still", "remains", "the", "high", "incidence", "of", "leukemic", "relapse", "following", "autologous", "PBSCT", ",", "which", "may", "be", "caused", "by", "the", "reinfusion", "of", "PBSC", "contaminated", "by", "leukemic", "cells", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-3", "entity_mentions": [{"start": 25, "end": 26, "entity_type": "cell_type", "text": "PBSC"}, {"start": 28, "end": 30, "entity_type": "cell_type", "text": "leukemic cells"}]}
{"tokens": ["Recently", ",", "we", "have", "developed", "a", "quantitative", "assay", "using", "competitive", "reverse", "transcriptase", "polymerase", "chain", "reaction", "that", "estimates", "the", "number", "of", "AML1", "/ETO", "transcripts", "in", "t(8;21)", "acute", "myelogenous", "leukemia", "(", "AML", ")", ",", "in", "order", "to", "determine", "the", "degree", "of", "leukemic", "cell", "contamination", "in", "PBSC", "harvests", ",", "and", "to", "monitor", "minimal", "residual", "disease", "(", "MRD", ")", "quantitatively", "in", "patients", "with", "t(8;21)", "AML", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-4", "entity_mentions": [{"start": 10, "end": 13, "entity_type": "protein", "text": "reverse transcriptase polymerase"}, {"start": 20, "end": 21, "entity_type": "DNA", "text": "AML1"}, {"start": 20, "end": 23, "entity_type": "RNA", "text": "AML1 /ETO transcripts"}, {"start": 43, "end": 44, "entity_type": "cell_type", "text": "PBSC"}]}
{"tokens": ["Our", "data", "indicate", "that", "although", "PBSC", "harvests", "collected", "after", "consolidation", "chemotherapy", "are", "contaminated", "by", "leukemic", "cells", ",", "the", "degree", "of", "leukemic", "cell", "contamination", "decreases", "with", "repeated", "cycles", "of", "chemotherapy", "."], "doc_id": "MEDLINE:97276922", "sent_id": "MEDLINE:97276922-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "cell_type", "text": "PBSC"}, {"start": 14, "end": 16, "entity_type": "cell_type", "text": "leukemic cells"}]}
