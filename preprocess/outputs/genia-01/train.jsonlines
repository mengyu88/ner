{"tokens": ["We", "have", "measured", "the", "level", "of", "junB", "mRNA", "in", "the", "B", "hybridoma", "cell", "line", "7TD1", ",", "under", "interleukin-6", "(", "IL-6", ")", "stimulation", "."], "doc_id": "MEDLINE:95138118", "sent_id": "MEDLINE:95138118-1", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "RNA", "text": "junB mRNA"}, {"start": 10, "end": 15, "entity_type": "cell_line", "text": "B hybridoma cell line 7TD1"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "interleukin-6"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-6"}]}
