{"tokens": ["These", "findings", "establish", "that", "STAT1", "and", "STAT5", ",", "and", "possibly", "STAT3", ",", "are", "activated", "upon", "stimulation", "of", "precursor", "B", "cells", "with", "IL-7", "."], "doc_id": "MEDLINE:96320605", "sent_id": "MEDLINE:96320605-11", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "STAT1"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "STAT5"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "STAT3"}, {"start": 17, "end": 20, "entity_type": "cell_type", "text": "precursor B cells"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "IL-7"}]}
