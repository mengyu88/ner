{"tokens": ["The", "results", "indicate", "that", "stimulation", "of", "NK", "cells", ",", "either", "freshly", "isolated", "from", "peripheral", "blood", "lymphocytes", "(", "PBL", ")", "or", "long-term", "cultured", "NK", "clones", ",", "with", "specific", "cell", "targets", "results", "in", "an", "increased", "binding", "activity", "of", "NF-kappa", "B", "and", "AP-1", "transcription", "factors", "measured", "by", "gel", "retardation", "."], "doc_id": "MEDLINE:97300635", "sent_id": "MEDLINE:97300635-2", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "cell_type", "text": "NK cells"}, {"start": 13, "end": 16, "entity_type": "cell_type", "text": "peripheral blood lymphocytes"}, {"start": 17, "end": 18, "entity_type": "cell_type", "text": "PBL"}, {"start": 20, "end": 24, "entity_type": "cell_line", "text": "long-term cultured NK clones"}, {"start": 36, "end": 38, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 39, "end": 40, "entity_type": "protein", "text": "AP-1"}, {"start": 40, "end": 42, "entity_type": "protein", "text": "transcription factors"}]}
{"tokens": ["Pretreatment", "of", "NK", "cells", "with", "the", "antioxidant", "pyrrolidine", "dithiocarbarmate", "(", "PDTC", ")", "leads", "to", "the", "inhibition", "of", "NF-kappa", "B", "activation", "but", "the", "AP-1", "binding", "to", "DNA", "was", "superinduced", "."], "doc_id": "MEDLINE:97300635", "sent_id": "MEDLINE:97300635-3", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_type", "text": "NK cells"}, {"start": 17, "end": 19, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "AP-1"}]}
