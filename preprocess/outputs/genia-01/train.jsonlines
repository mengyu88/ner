{"tokens": ["IL-7", "also", "induced", "STAT", "/DNA", "binding", "in", "BCP-ALL", "cases", "that", "failed", "to", "proliferate", "in", "response", "to", "IL-7", ",", "suggesting", "that", "the", "ability", "of", "IL-7R", "to", "activate", "the", "JAK", "/STAT", "pathway", "per", "se", "is", "not", "sufficient", "for", "proliferation", "induction", "."], "doc_id": "MEDLINE:96320605", "sent_id": "MEDLINE:96320605-7", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "IL-7"}, {"start": 3, "end": 4, "entity_type": "protein", "text": "STAT"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "IL-7"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "IL-7R"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "JAK"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "/STAT"}]}
