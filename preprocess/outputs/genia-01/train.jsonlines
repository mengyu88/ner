{"tokens": ["We", "have", "previously", "shown", "that", "the", "presence", "of", "the", "CD4", "cytoplasmic", "tail", "is", "critical", "for", "human", "immunodeficiency", "virus", "(", "HIV", ")", "-induced", "apoptosis", "(", "J.Corbeil", ",", "M.Tremblay", ",", "and", "D.D.Richman", ",", "J.Exp.Med.183", ":", "39-48", ",", "1996", ")", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-1", "entity_mentions": [{"start": 9, "end": 12, "entity_type": "protein", "text": "CD4 cytoplasmic tail"}]}
{"tokens": ["We", "have", "pursued", "our", "investigation", "of", "the", "role", "of", "the", "CD4", "transduction", "pathway", "in", "HIV-induced", "apoptosis", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-2", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "CD4"}]}
{"tokens": ["To", "do", "this", ",", "wild-type", "and", "mutant", "forms", "of", "the", "CD4", "cytoplasmic", "tail", "were", "stably", "expressed", "in", "the", "lymphoblastoid", "T-cell", "line", "A2.01", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-3", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "CD4"}, {"start": 10, "end": 13, "entity_type": "protein", "text": "CD4 cytoplasmic tail"}, {"start": 18, "end": 21, "entity_type": "cell_line", "text": "lymphoblastoid T-cell line"}, {"start": 21, "end": 22, "entity_type": "cell_line", "text": "A2.01"}]}
{"tokens": ["Apoptosis", "was", "prevented", "when", "CD4", "truncated", "at", "residue", "402", "was", "expressed", ";", "however", ",", "cells", "expressing", "mutated", "receptors", "that", "do", "not", "associate", "with", "p56(lck)", "(", "mutated", "at", "the", "dicysteine", "motif", "and", "truncated", "at", "residue", "418", ")", "but", "which", "conserved", "proximal", "domains", "of", "the", "cytoplasmic", "tail", "underwent", "apoptosis", "like", "wild- type", "CD4", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-4", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "CD4"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "p56(lck)"}, {"start": 28, "end": 30, "entity_type": "protein", "text": "dicysteine motif"}, {"start": 43, "end": 45, "entity_type": "protein", "text": "cytoplasmic tail"}, {"start": 49, "end": 50, "entity_type": "protein", "text": "CD4"}, {"start": 48, "end": 50, "entity_type": "protein", "text": "wild- type CD4"}]}
{"tokens": ["The", "differences", "between", "wild-type", "and", "mutated", "receptors", "in", "the", "induction", "of", "apoptosis", "were", "not", "related", "to", "levels", "of", "p56(lck)", "or", "NF- kappaB", "activation", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-5", "entity_mentions": [{"start": 18, "end": 19, "entity_type": "protein", "text": "p56(lck)"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "NF- kappaB"}]}
{"tokens": ["Initial", "signaling", "through", "the", "CD4", "receptor", "played", "a", "major", "role", "in", "the", "sensitization", "of", "HIV-infected", "T", "cells", "to", "undergo", "apoptosis", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-6", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "CD4"}, {"start": 4, "end": 6, "entity_type": "protein", "text": "CD4 receptor"}, {"start": 14, "end": 17, "entity_type": "cell_type", "text": "HIV-infected T cells"}]}
{"tokens": ["Incubation", "of", "HIV-infected", "cells", "with", "monoclonal", "antibody", "(", "MAb", ")", "13B8-2", ",", "which", "binds", "to", "CD4", "in", "a", "region", "critical", "for", "dimerization", "of", "the", "receptor", ",", "prevented", "apoptosis", "without", "inhibiting", "HIV", "replication", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-7", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_type", "text": "HIV-infected cells"}, {"start": 5, "end": 11, "entity_type": "protein", "text": "monoclonal antibody ( MAb ) 13B8-2"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "CD4"}]}
{"tokens": ["Moreover", ",", "the", "apoptotic", "process", "was", "not", "related", "to", "Fas", "-Fas", "ligand", "interaction", ";", "however", ",", "an", "antagonistic", "anti-Fas", "MAb", "(", "ZB-4", ")", "enhanced", "apoptosis", "in", "HIV-infected", "cells", "without", "inducing", "apoptosis", "in", "uninfected", "cells", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-8", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "Fas"}, {"start": 10, "end": 12, "entity_type": "protein", "text": "-Fas ligand"}, {"start": 26, "end": 28, "entity_type": "cell_type", "text": "HIV-infected cells"}, {"start": 32, "end": 34, "entity_type": "cell_type", "text": "uninfected cells"}]}
{"tokens": ["These", "observations", "demonstrate", "that", "CD4", "signaling", "mediates", "HIV-induced", "apoptosis", "by", "a", "mechanism", "independent", "of", "Fas", "-Fas", "ligand", "interaction", ",", "does", "not", "require", "p56(lck)", "signaling", ",", "and", "may", "involve", "a", "critical", "region", "for", "CD4", "dimerization", "."], "doc_id": "MEDLINE:98406210", "sent_id": "MEDLINE:98406210-9", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "CD4"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "Fas"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "-Fas ligand"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "p56(lck)"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "CD4"}]}
{"tokens": ["p130", ",", "p107", ",", "and", "pRb", "are", "differentially", "regulated", "in", "proliferating", "cells", "and", "during", "cell", "cycle", "arrest", "by", "alpha-interferon", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-0", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "p130"}, {"start": 2, "end": 3, "entity_type": "protein", "text": "p107"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "pRb"}, {"start": 10, "end": 12, "entity_type": "cell_type", "text": "proliferating cells"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "alpha-interferon"}]}
{"tokens": ["We", "have", "determined", "how", "the", "phosphorylation", "of", "the", "retinoblastoma", "family", "(", "pRb", ",", "p107", ",", "and", "p130", ")", "is", "governed", "in", "individual", "cell", "cycle", "phases", "of", "Daudi", "B-cells", "during", "cell", "cycle", "exit", "triggered", "by", "alpha-interferon", "(", "alpha-IFN", ")", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-1", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "protein", "text": "retinoblastoma family"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "pRb"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "p107"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "p130"}, {"start": 26, "end": 28, "entity_type": "cell_line", "text": "Daudi B-cells"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "alpha-interferon"}, {"start": 36, "end": 37, "entity_type": "protein", "text": "alpha-IFN"}]}
{"tokens": ["alpha-IFN", "causes", "dephosphorylation", "of", "pRb", "and", "loss", "of", "p130", "phosphorylated", "Form", "3", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-2", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "alpha-IFN"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "pRb"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "p130"}, {"start": 8, "end": 12, "entity_type": "protein", "text": "p130 phosphorylated Form 3"}]}
{"tokens": ["However", ",", "the", "change", "in", "p130", "phosphorylation", "in", "response", "to", "alpha-IFN", "occurs", "before", "dephosphorylation", "of", "pRb", "is", "complete", "because", "loss", "of", "p130", "Form", "3", "occurs", "throughout", "the", "cell", "cycle", "prior", "to", "complete", "arrest", "in", "G1", ",", "whereas", "pRb", "is", "dephosphorylated", "only", "in", "G1", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "p130"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "alpha-IFN"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "pRb"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "p130"}, {"start": 21, "end": 24, "entity_type": "protein", "text": "p130 Form 3"}, {"start": 37, "end": 38, "entity_type": "protein", "text": "pRb"}]}
{"tokens": ["In", "contrast", ",", "p107", "is", "dephosphorylated", "and", "is", "then", "depleted", "from", "cells", "as", "they", "exit", "the", "cell", "cycle", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "p107"}]}
{"tokens": ["p130", ",", "predominantly", "in", "Form", "1", ",", "and", "hypophosphorylated", "pRb", "bind", "an", "E2F", "DNA", "binding", "site", ";", "p130", "complexes", "E2F-4", ",", "whereas", "pRb", "binds", "both", "E2F-4", "and", "E2F-1", "."], "doc_id": "MEDLINE:98395073", "sent_id": "MEDLINE:98395073-5", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "p130"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "pRb"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "hypophosphorylated pRb"}, {"start": 12, "end": 16, "entity_type": "DNA", "text": "E2F DNA binding site"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "p130"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "E2F-4"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "pRb"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "E2F-1"}]}
