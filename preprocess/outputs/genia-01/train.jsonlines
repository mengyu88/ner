{"tokens": ["Altogether", ",", "the", "data", "indicate", "that", "the", "defect", "induced", "by", "HCMV", "resides", "in", "the", "activation", "of", "the", "IFN-gamma", "-responsive", "promoter", "of", "CIITA", "."], "doc_id": "MEDLINE:99329182", "sent_id": "MEDLINE:99329182-6", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 17, "end": 20, "entity_type": "DNA", "text": "IFN-gamma -responsive promoter"}, {"start": 21, "end": 22, "entity_type": "DNA", "text": "CIITA"}]}
