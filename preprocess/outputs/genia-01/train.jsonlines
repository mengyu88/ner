{"tokens": ["Here", "we", "demonstrate", "that", "B-1", "lymphocytes", "constitutively", "express", "nuclear", "activated", "STAT3", ",", "which", "is", "not", "expressed", "by", "unmanipulated", "conventional", "(", "B-2", ")", "lymphocytes", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-5", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "cell_type", "text": "B-1 lymphocytes"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "STAT3"}, {"start": 8, "end": 11, "entity_type": "protein", "text": "nuclear activated STAT3"}, {"start": 17, "end": 23, "entity_type": "cell_type", "text": "unmanipulated conventional ( B-2 ) lymphocytes"}]}
{"tokens": ["In", "contrast", ",", "STAT3", "activation", "is", "induced", "in", "B-2", "cells", "after", "antigen", "receptor", "engagement", "in", "a", "delayed", "fashion", "(", "after", "3", "h", ")", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-6", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "STAT3"}, {"start": 8, "end": 10, "entity_type": "cell_type", "text": "B-2 cells"}]}
{"tokens": ["Induction", "of", "STAT3", "is", "inhibited", "by", "both", "the", "serine/threonine", "protein", "kinase", "inhibitor", "H-7", "and", "the", "immunosuppressive", "drug", "rapamycin", "and", "requires", "de", "novo", "protein", "synthesis", ",", "demonstrating", "novel", "coupling", "between", "sIg", "and", "STAT", "proteins", "that", "differs", "from", "the", "classical", "paradigm", "for", "STAT", "induction", "by", "cytokine", "receptors", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-7", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "STAT3"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "sIg"}, {"start": 31, "end": 33, "entity_type": "protein", "text": "STAT proteins"}, {"start": 40, "end": 41, "entity_type": "protein", "text": "STAT"}, {"start": 43, "end": 45, "entity_type": "protein", "text": "cytokine receptors"}]}
{"tokens": ["The", "inability", "of", "prolonged", "stimulation", "of", "conventional", "B-2", "cells", "with", "anti-Ig", ",", "a", "treatment", "sufficient", "to", "induce", "CD5", "expression", ",", "to", "result", "in", "sustained", "STAT3", "activation", "suggests", "that", "STAT3", "is", "a", "specific", "nuclear", "marker", "for", "B-1", "cells", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-8", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "cell_type", "text": "B-2 cells"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "anti-Ig"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "CD5"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "STAT3"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "STAT3"}, {"start": 35, "end": 37, "entity_type": "cell_type", "text": "B-1 cells"}]}
