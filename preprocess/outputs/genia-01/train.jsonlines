{"tokens": ["To", "clarify", "the", "etiological", "relationship", "between", "the", "two", "variants", ",", "we", "analyzed", "responsiveness", "to", "IL-4", "of", "transfectants", "with", "four", "kinds", "of", "IL-4Ralpha", "carrying", "either", "Val", "or", "Ile", "at", "50", "and", "either", "Gln", "or", "Arg", "at", "551", "."], "doc_id": "MEDLINE:99138796", "sent_id": "MEDLINE:99138796-2", "entity_mentions": [{"start": 14, "end": 15, "entity_type": "protein", "text": "IL-4"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "IL-4Ralpha"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "50"}, {"start": 35, "end": 36, "entity_type": "protein", "text": "551"}]}
