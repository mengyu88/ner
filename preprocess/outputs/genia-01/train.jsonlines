{"tokens": ["Several", "studies", "have", "established", "that", "Tat", "releases", "an", "elongation", "block", "to", "the", "transcription", "of", "HIV", "long", "terminal", "repeat", "(", "LTR", ")", ";", "however", ",", "it", "is", "not", "known", "whether", "this", "mechanism", "alone", "is", "sufficient", "to", "explain", "the", "block", "to", "HIV", "replication", "in", "human", "T", "cells", "when", "Tat", "is", "absent", "."], "doc_id": "MEDLINE:95373132", "sent_id": "MEDLINE:95373132-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "Tat"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "elongation block"}, {"start": 14, "end": 18, "entity_type": "DNA", "text": "HIV long terminal repeat"}, {"start": 19, "end": 20, "entity_type": "DNA", "text": "LTR"}, {"start": 42, "end": 45, "entity_type": "cell_type", "text": "human T cells"}, {"start": 46, "end": 47, "entity_type": "protein", "text": "Tat"}]}
