{"tokens": ["We", "demonstrate", "that", ",", "in", "primary", "NK", "cells", ",", "IL-13", ",", "but", "not", "IL-4", ",", "may", "induce", "low", "levels", "of", "IFN-gamma", "secretion", "."], "doc_id": "MEDLINE:98309442", "sent_id": "MEDLINE:98309442-3", "entity_mentions": [{"start": 5, "end": 8, "entity_type": "cell_type", "text": "primary NK cells"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "IL-13"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IL-4"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "IFN-gamma"}]}
{"tokens": ["When", "NK", "cells", "were", "costimulated", "with", "IL-13", "and", "IL-2", ",", "IL-13", "generally", "resulted", "in", "two", "types", "of", "reactivity", ":", "IL-13", "synergized", "with", "IL-2", "to", "stimulate", "IFN-gamma", "production", "or", "it", "modestly", "inhibited", "IL-2", "-", "mediated", "IFN-gamma", "production", "."], "doc_id": "MEDLINE:98309442", "sent_id": "MEDLINE:98309442-4", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_type", "text": "NK cells"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "IL-13"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IL-2"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-13"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-13"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "IL-2"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "IL-2"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "IFN-gamma"}]}
{"tokens": ["In", "both", "types", "of", "donors", ",", "the", "effect", "of", "IL-13", "on", "IL-2", "-induced", "IFN-gamma", "production", "was", "in", "marked", "contrast", "to", "the", "strong", "inhibition", "seen", "with", "IL-4", "in", "NK", "cells", "."], "doc_id": "MEDLINE:98309442", "sent_id": "MEDLINE:98309442-5", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "IL-13"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "IL-2"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "IL-4"}, {"start": 27, "end": 29, "entity_type": "cell_type", "text": "NK cells"}]}
