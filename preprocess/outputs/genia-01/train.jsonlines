{"tokens": ["Finally", ",", "in", "JAK-1", "-deficient", "HeLa", "cells", ",", "STAT6", "activation", "by", "IL-4", "is", "completely", "abolished", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-9", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "JAK-1"}, {"start": 3, "end": 7, "entity_type": "cell_line", "text": "JAK-1 -deficient HeLa cells"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "STAT6"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "IL-4"}]}
{"tokens": ["Together", ",", "these", "data", "demonstrate", "that", "the", "IL-4R", "alpha", "cytoplasmic", "domain", "is", "sufficient", "to", "activate", "JAK-1", "and", "STAT6", "and", "to", "induce", "expression", "of", "IL-4", "target", "genes", ",", "thus", "identifying", "a", "mechanism", "by", "which", "IL-4", "signaling", "can", "proceed", "in", "the", "absence", "of", "JAK-3", "and", "gamma(c)", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-10", "entity_mentions": [{"start": 7, "end": 11, "entity_type": "protein", "text": "IL-4R alpha cytoplasmic domain"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "JAK-1"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "STAT6"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "IL-4"}, {"start": 23, "end": 26, "entity_type": "DNA", "text": "IL-4 target genes"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "IL-4"}, {"start": 41, "end": 42, "entity_type": "protein", "text": "JAK-3"}, {"start": 43, "end": 44, "entity_type": "protein", "text": "gamma(c)"}]}
{"tokens": ["Histamine", "modulates", "the", "expression", "of", "c-fos", "through", "cyclic", "AMP", "production", "via", "the", "H2", "receptor", "in", "the", "human", "promonocytic", "cell", "line", "U937", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-0", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "c-fos"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "H2 receptor"}, {"start": 16, "end": 21, "entity_type": "cell_line", "text": "human promonocytic cell line U937"}]}
