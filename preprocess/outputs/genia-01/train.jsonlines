{"tokens": ["These", "data", "suggest", "that", "a", "small", "number", "of", "GATA-1.05", "mutant", "hematopoietic", "progenitor", "cells", "begin", "to", "proliferate", "vigorously", "during", "early", "adulthood", ",", "but", "because", "the", "cells", "are", "unable", "to", "terminally", "differentiate", ",", "this", "leads", "to", "progenitor", "proliferation", "in", "the", "spleen", "and", "consequently", "death", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-7", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "GATA-1.05"}, {"start": 8, "end": 13, "entity_type": "cell_line", "text": "GATA-1.05 mutant hematopoietic progenitor cells"}]}
