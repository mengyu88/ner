{"tokens": ["Thus", ",", "BOB.1/OBF.1", "is", "a", "transcriptional", "coactivator", "that", "is", "critically", "regulated", "by", "posttranslational", "modifications", "to", "mediate", "cell", "type-specific", "gene", "expression", "."], "doc_id": "MEDLINE:97362321", "sent_id": "MEDLINE:97362321-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "BOB.1/OBF.1"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "transcriptional coactivator"}]}
