{"tokens": ["We", "have", "previously", "shown", "that", "c-Jun", "is", "a", "potent", "inhibitor", "of", "the", "rat", "prolactin", "(", "rPRL", ")", "promoter", "activity", "induced", "by", "either", "oncogenic", "Ras", "or", "phorbol", "esters", "."], "doc_id": "MEDLINE:96291858", "sent_id": "MEDLINE:96291858-2", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "c-Jun"}, {"start": 12, "end": 18, "entity_type": "DNA", "text": "rat prolactin ( rPRL ) promoter"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "oncogenic Ras"}]}
