{"tokens": ["When", "expressed", "in", "the", "TNT", "System", ",", "squirrel", "monkey", "and", "human", "glucocorticoid", "receptors", "had", "similar", ",", "high", "affinity", "binding", "for", "dexamethasone", "(", "apparent", "Kd", ",", "5.9", "+/-", "1.2", "and", "4.3", "+/-", "0.5", "nmol/L", ",", "respectively", ";", "n", "=", "3", ")", ",", "whereas", "the", "squirrel", "monkey", "F774L", "receptor", "had", "lower", "affinity", "binding", "(", "apparent", "Kd", ",", "20.4", "+/-", "2.0", "nmol/L", ";", "n", "=", "3", ")", "."], "doc_id": "MEDLINE:97176699", "sent_id": "MEDLINE:97176699-11", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "protein", "text": "glucocorticoid receptors"}, {"start": 10, "end": 13, "entity_type": "protein", "text": "human glucocorticoid receptors"}, {"start": 43, "end": 47, "entity_type": "protein", "text": "squirrel monkey F774L receptor"}]}
