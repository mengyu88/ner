{"tokens": ["CD23", "expression", "and", "IgE", "synthesis", "by", "IL-4", "were", "augmented", "in", "Ile50", "-bearing", "PBMC", ",", "compared", "with", "those", "bearing", "Val50", "."], "doc_id": "MEDLINE:99138796", "sent_id": "MEDLINE:99138796-5", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "CD23"}, {"start": 3, "end": 4, "entity_type": "protein", "text": "IgE"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "IL-4"}, {"start": 10, "end": 13, "entity_type": "cell_line", "text": "Ile50 -bearing PBMC"}]}
