{"tokens": ["The", "different", "patterns", "of", "p50", ",", "p52", "and", "RelB", "protein", "nuclear", "localization", "may", "provide", "insight", "into", "their", "different", "roles", "during", "the", "immune", "response", "in", "vivo", "."], "doc_id": "MEDLINE:97080592", "sent_id": "MEDLINE:97080592-13", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "p50"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "p52"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "RelB"}]}
