{"tokens": ["To", "test", "these", "hypotheses", ",", "we", "studied", "several", "tat", "mutants", ",", "including", "two", "stop", "codon", "mutants", "and", "one", "deletion", "mutant", "using", "replication-competent", "HIV-1", "constructs", "carrying", "wild-type", "or", "mutant", "LTRs", "with", "modifications", "in", "the", "NF-kappa", "B", "and/or", "Sp1", "binding", "sites", "."], "doc_id": "MEDLINE:95373132", "sent_id": "MEDLINE:95373132-5", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "protein", "text": "tat mutants"}, {"start": 13, "end": 16, "entity_type": "protein", "text": "stop codon mutants"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "deletion mutant"}, {"start": 21, "end": 24, "entity_type": "DNA", "text": "replication-competent HIV-1 constructs"}]}
{"tokens": ["In", "this", "study", ",", "we", "show", "that", "Tat- HIV-1", "with", "wild-type", "LTRs", "can", "replicate", "in", "HeLa", "cells", ",", "and", "the", "virus", "produced", "from", "HeLa", "cells", "can", "infect", "primary", "peripheral", "blood", "lymphocytes", "and", "macrophages", "."], "doc_id": "MEDLINE:95373132", "sent_id": "MEDLINE:95373132-6", "entity_mentions": [{"start": 9, "end": 11, "entity_type": "DNA", "text": "wild-type LTRs"}, {"start": 14, "end": 16, "entity_type": "cell_line", "text": "HeLa cells"}, {"start": 22, "end": 24, "entity_type": "cell_line", "text": "HeLa cells"}, {"start": 27, "end": 30, "entity_type": "cell_type", "text": "peripheral blood lymphocytes"}, {"start": 31, "end": 32, "entity_type": "cell_type", "text": "macrophages"}]}
