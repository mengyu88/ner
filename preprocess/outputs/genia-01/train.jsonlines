{"tokens": ["Constitutive", "PKR", "activity", "was", "also", "detected", "in", "HIV-1", "-infected", "cells", "as", "a", "result", "of", "low-level", "IFN", "production", ",", "since", "the", "addition", "of", "anti-IFN-alpha/beta", "antibody", "to", "the", "cells", "decreased", "PKR", "expression", "."], "doc_id": "MEDLINE:96357043", "sent_id": "MEDLINE:96357043-5", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "PKR"}, {"start": 7, "end": 10, "entity_type": "cell_line", "text": "HIV-1 -infected cells"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IFN"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "anti-IFN-alpha/beta antibody"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "PKR"}]}
{"tokens": ["Furthermore", ",", "the", "analysis", "of", "IkappaBalpha", "turnover", "demonstrated", "an", "increased", "degradation", "of", "IkappaBalpha", "in", "HIV-1", "-infected", "cells", "that", "may", "account", "for", "the", "constitutive", "DNA", "binding", "activity", "."], "doc_id": "MEDLINE:96357043", "sent_id": "MEDLINE:96357043-6", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "IkappaBalpha"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "IkappaBalpha"}, {"start": 14, "end": 17, "entity_type": "cell_line", "text": "HIV-1 -infected cells"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "constitutive DNA"}]}
