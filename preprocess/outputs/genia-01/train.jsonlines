{"tokens": ["The", "c-rel", "protooncogene", "product", "represses", "NF-kappa", "B", "p65", "-mediated", "transcriptional", "activation", "of", "the", "long", "terminal", "repeat", "of", "type", "1", "human", "immunodeficiency", "virus", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-0", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "DNA", "text": "c-rel protooncogene"}, {"start": 1, "end": 4, "entity_type": "protein", "text": "c-rel protooncogene product"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "p65"}]}
{"tokens": ["The", "long", "terminal", "repeat", "(", "LTR", ")", "of", "the", "type", "1", "human", "immunodeficiency", "virus", "(", "HIV-1", ")", "and", "the", "5'", "regulatory", "region", "of", "the", "gene", "encoding", "the", "interleukin", "2", "receptor", "alpha", "subunit", "(", "IL-2R", "alpha", ")", "share", "functional", "kappa", "B", "enhancer", "elements", "involved", "in", "the", "regulation", "of", "these", "inducible", "transcription", "units", "during", "T-cell", "activation", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-1", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "DNA", "text": "long terminal repeat"}, {"start": 5, "end": 6, "entity_type": "DNA", "text": "LTR"}, {"start": 19, "end": 22, "entity_type": "DNA", "text": "5' regulatory region"}, {"start": 27, "end": 32, "entity_type": "protein", "text": "interleukin 2 receptor alpha subunit"}, {"start": 33, "end": 35, "entity_type": "protein", "text": "IL-2R alpha"}, {"start": 38, "end": 42, "entity_type": "DNA", "text": "kappa B enhancer elements"}]}
{"tokens": ["These", "kappa", "B", "enhancer", "elements", "are", "recognized", "by", "a", "structurally", "related", "family", "of", "interactive", "proteins", "that", "includes", "p50", ",", "p65", ",", "and", "the", "product", "of", "the", "c-rel", "protooncogene", "(", "c-Rel", ")", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-2", "entity_mentions": [{"start": 1, "end": 5, "entity_type": "DNA", "text": "kappa B enhancer elements"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "p50"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "p65"}, {"start": 26, "end": 28, "entity_type": "DNA", "text": "c-rel protooncogene"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "c-Rel"}]}
{"tokens": ["Recent", "biochemical", "studies", "have", "shown", "that", "p65", "and", "p50", "form", "the", "prototypical", "NF-kappa", "B", "complex", ",", "which", "is", "rapidly", "translocated", "from", "the", "cytoplasm", "to", "the", "nucleus", "during", "T-cell", "activation", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "p65"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "p50"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 12, "end": 15, "entity_type": "protein", "text": "NF-kappa B complex"}]}
{"tokens": ["This", "intracellular", "signaling", "complex", "potently", "stimulates", "kappa", "B-directed", "transcription", "from", "either", "the", "HIV-1", "LTR", "or", "the", "IL-2R", "alpha", "promoter", "via", "the", "strong", "transactivation", "domain", "present", "in", "p65", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-4", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "DNA", "text": "HIV-1 LTR"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "IL-2R alpha"}, {"start": 16, "end": 19, "entity_type": "DNA", "text": "IL-2R alpha promoter"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "p65"}]}
{"tokens": ["We", "now", "demonstrate", "that", "nuclear", "expression", "of", "human", "c-Rel", ",", "which", "is", "induced", "by", "either", "phorbol", "ester", "or", "tumor", "necrosis", "factor", "alpha", "with", "delayed", "kinetics", "relative", "to", "p65", ",", "markedly", "represses", "p65", "-mediated", "activation", "of", "these", "transcription", "units", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-5", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "c-Rel"}, {"start": 18, "end": 22, "entity_type": "protein", "text": "tumor necrosis factor alpha"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "p65"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "p65"}]}
{"tokens": ["These", "inhibitory", "effects", "of", "c-Rel", "correlate", "with", "its", "DNA-binding", "activity", "but", "not", "with", "its", "ability", "to", "heterodimerize", "with", "p50", ",", "suggesting", "that", "c-Rel", "inhibition", "involves", "competition", "with", "p50", "/p65", "for", "occupancy", "of", "the", "kappa", "B", "enhancer", "element", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-6", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "c-Rel"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "p50"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "c-Rel"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "p50"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "/p65"}, {"start": 27, "end": 29, "entity_type": "protein", "text": "p50 /p65"}]}
{"tokens": ["Together", ",", "these", "findings", "suggest", "that", "one", "function", "of", "c-Rel", "is", "as", "a", "physiologic", "repressor", "of", "the", "HIV-1", "LTR", "and", "IL-2R", "alpha", "promoters", ",", "serving", "to", "efficiently", "counter", "the", "strong", "transcriptional", "activating", "effects", "of", "p65", "."], "doc_id": "MEDLINE:93157335", "sent_id": "MEDLINE:93157335-7", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "c-Rel"}, {"start": 17, "end": 19, "entity_type": "DNA", "text": "HIV-1 LTR"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "IL-2R alpha"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "p65"}]}
{"tokens": ["Ras", "oncogene", "transformation", "of", "human", "B", "lymphoblasts", "is", "associated", "with", "lymphocyte", "activation", "and", "with", "a", "block", "of", "differentiation", "."], "doc_id": "MEDLINE:93141262", "sent_id": "MEDLINE:93141262-0", "entity_mentions": [{"start": 0, "end": 2, "entity_type": "DNA", "text": "Ras oncogene"}, {"start": 4, "end": 7, "entity_type": "cell_type", "text": "human B lymphoblasts"}]}
