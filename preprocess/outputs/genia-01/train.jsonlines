{"tokens": ["In", "this", "study", ",", "we", "characterize", "an", "essential", "upstream", "IL-2", "response", "element", "that", "contains", "both", "consensus", "and", "non-consensus", "GAS", "motifs", ",", "two", "putative", "Ets", "binding", "sites", "(", "EBS", ")", ",", "one", "of", "which", "overlaps", "the", "consensus", "GAS", "motif", ",", "and", "a", "GATA", "motif", ",", "which", "overlaps", "the", "non-consensus", "GAS", "motif", "."], "doc_id": "MEDLINE:97051821", "sent_id": "MEDLINE:97051821-2", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "IL-2"}, {"start": 9, "end": 12, "entity_type": "DNA", "text": "IL-2 response element"}, {"start": 23, "end": 26, "entity_type": "DNA", "text": "Ets binding sites"}, {"start": 27, "end": 28, "entity_type": "DNA", "text": "EBS"}, {"start": 35, "end": 38, "entity_type": "DNA", "text": "consensus GAS motif"}, {"start": 41, "end": 43, "entity_type": "DNA", "text": "GATA motif"}, {"start": 47, "end": 50, "entity_type": "DNA", "text": "non-consensus GAS motif"}]}
{"tokens": ["We", "demonstrate", "that", "although", "the", "individual", "components", "of", "this", "element", "do", "not", "respond", "to", "IL-2", ",", "together", "they", "form", "a", "composite", "element", "capable", "of", "conferring", "IL-2", "responsiveness", "to", "a", "heterologous", "promoter", "."], "doc_id": "MEDLINE:97051821", "sent_id": "MEDLINE:97051821-3", "entity_mentions": [{"start": 14, "end": 15, "entity_type": "protein", "text": "IL-2"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "IL-2"}, {"start": 29, "end": 31, "entity_type": "DNA", "text": "heterologous promoter"}]}
{"tokens": ["Multiple", "factors", "including", "Stat5", ",", "Elf-1", ",", "HMG-I(Y)", "and", "GATA", "family", "proteins", "bind", "to", "the", "IL-2", "response", "element", "and", "mutation", "of", "any", "one", "of", "these", "binding", "sites", "diminishes", "the", "activity", "of", "this", "element", "."], "doc_id": "MEDLINE:97051821", "sent_id": "MEDLINE:97051821-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "Stat5"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "Elf-1"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "HMG-I(Y)"}, {"start": 9, "end": 12, "entity_type": "protein", "text": "GATA family proteins"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IL-2"}, {"start": 15, "end": 18, "entity_type": "DNA", "text": "IL-2 response element"}]}
