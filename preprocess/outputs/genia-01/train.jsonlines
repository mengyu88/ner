{"tokens": ["Here", "we", "show", "that", "blockade", "of", "NF-kappaB", "activity", ",", "using", "a", "dominant", "negative", "IkappaBalpha", ",", "has", "opposite", "effects", "on", "these", "two", "apoptotic", "signals", "."], "doc_id": "MEDLINE:99310960", "sent_id": "MEDLINE:99310960-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "dominant negative IkappaBalpha"}]}
{"tokens": ["Treatment", "with", "PMA", "plus", "ionomycin", "(", "P/I", ")", "results", "in", "the", "upregulation", "of", "Fas", "Ligand", "(", "FasL", ")", "and", "induction", "of", "apoptosis", "."], "doc_id": "MEDLINE:99310960", "sent_id": "MEDLINE:99310960-4", "entity_mentions": [{"start": 13, "end": 15, "entity_type": "protein", "text": "Fas Ligand"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "FasL"}]}
{"tokens": ["Inhibition", "of", "NF-kappaB", "activity", "inhibits", "the", "P/I", "mediated", "induction", "of", "FasL", "mRNA", "and", "decreases", "the", "level", "of", "apoptosis", "in", "these", "cultures", ",", "thus", "establishing", "NF-kappaB", "as", "a", "proapoptotic", "factor", "in", "this", "context", "."], "doc_id": "MEDLINE:99310960", "sent_id": "MEDLINE:99310960-5", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "FasL"}, {"start": 10, "end": 12, "entity_type": "RNA", "text": "FasL mRNA"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 27, "end": 29, "entity_type": "protein", "text": "proapoptotic factor"}]}
{"tokens": ["Conversely", ",", "inhibition", "of", "NF-kappaB", "confers", "a", "tenfold", "increase", "in", "glucocorticoid", "mediated", "apoptosis", ",", "establishing", "that", "NF-kappaB", "also", "functions", "as", "an", "antiapoptotic", "factor", "."], "doc_id": "MEDLINE:99310960", "sent_id": "MEDLINE:99310960-6", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "NF-kappaB"}]}
