{"tokens": ["The", "binding", "sites", "fulfil", "the", "required", "criteria", "for", "specific", "steroid", "binding", "sites", "however", "differ", "somewhat", "from", "the", "classic", "androgen", "receptors", "from", "genital", "skin", "fibroblast", ":", "in", "fertile", "adult", "males", "(", "n", "=", "20", ")", "the", "binding", "sites", "showed", "(", "1", ")", "a", "high", "affinity", "for", "testosterone", "(", "1.32", "+/-", "0.49", "nM", ";", "mean", "+/-", "SD", ")", ",", "(", "2", ")", "a", "saturable", "capacity", "(", "184", "+/-", "52", "binding", "sites", "per", "cell", ";", "mean", "+/-", "SD", ")", ",", "and", "(", "3", ")", "a", "characteristic", "competitive", "binding", "profile", "for", "other", "steroid", "hormones", "(", "relative", "binding", "affinities", ":", "testosterone", "=", "dihydrotestosterone", ">", "17", "beta-estradiol", ">", "progesterone", ",", "whereas", "aldosterone", ",", "17-hydroxy-progesterone", "and", "cortisol", "did", "not", "compete", "appreciably", ")", "."], "doc_id": "MEDLINE:94190839", "sent_id": "MEDLINE:94190839-4", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "protein", "text": "binding sites"}, {"start": 9, "end": 12, "entity_type": "protein", "text": "steroid binding sites"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "androgen receptors"}, {"start": 21, "end": 24, "entity_type": "cell_type", "text": "genital skin fibroblast"}, {"start": 35, "end": 37, "entity_type": "protein", "text": "binding sites"}, {"start": 67, "end": 69, "entity_type": "protein", "text": "binding sites"}]}
