{"tokens": ["In", "the", "control", "group", ",", "dexamethasone", "produced", "a", "significant", "depression", "of", "Type", "I", "receptors", "(", "from", "267", "+/-", "72", "to", "169", "+/-", "71", "receptors", "per", "cell", ")", ",", "which", "can", "be", "interpreted", "as", "a", "primary", "involvement", "of", "Type", "I", "receptors", "in", "the", "response", "to", "dexamethasone", ";", "Type", "II", "receptors", "decreased", "in", "half", "the", "subjects", "(", "from", "2849", "+/-", "703", "to", "2345", "+/-", "569", "receptors", "per", "cell", ")", "."], "doc_id": "MEDLINE:97118356", "sent_id": "MEDLINE:97118356-8", "entity_mentions": [{"start": 11, "end": 14, "entity_type": "protein", "text": "Type I receptors"}, {"start": 37, "end": 40, "entity_type": "protein", "text": "Type I receptors"}, {"start": 46, "end": 49, "entity_type": "protein", "text": "Type II receptors"}]}
