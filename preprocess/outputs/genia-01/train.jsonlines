{"tokens": ["These", "two", "cell", "lines", "are", "representative", "of", "different", "virologic", "subtypes", "of", "PEL", ",", "i.e.", "HHV-8", "+/EBV-", "PEL", "in", "the", "case", "of", "CRO-AP/3", "and", "HHV-8", "+/EBV+", "PEL", "in", "the", "case", "of", "CRO-AP/5", "."], "doc_id": "MEDLINE:98403730", "sent_id": "MEDLINE:98403730-2", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "cell lines"}, {"start": 11, "end": 12, "entity_type": "cell_line", "text": "PEL"}, {"start": 14, "end": 17, "entity_type": "cell_line", "text": "HHV-8 +/EBV- PEL"}, {"start": 21, "end": 22, "entity_type": "cell_line", "text": "CRO-AP/3"}, {"start": 21, "end": 26, "entity_type": "cell_line", "text": "CRO-AP/3 and HHV-8 +/EBV+ PEL"}, {"start": 30, "end": 31, "entity_type": "cell_line", "text": "CRO-AP/5"}]}
