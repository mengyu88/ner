{"tokens": ["The", "region", "which", "induced", "these", "inductions", "was", "identified", "as", "being", "confined", "to", "40", "nucleotides", "5'", "to", "the", "major", "transcriptional", "initiation", "site", "by", "testing", "a", "series", "of", "clones", "with", "truncated", "promoter", "of", "IRF-2", "."], "doc_id": "MEDLINE:94148994", "sent_id": "MEDLINE:94148994-6", "entity_mentions": [{"start": 12, "end": 15, "entity_type": "DNA", "text": "40 nucleotides 5'"}, {"start": 17, "end": 21, "entity_type": "DNA", "text": "major transcriptional initiation site"}, {"start": 28, "end": 30, "entity_type": "DNA", "text": "truncated promoter"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "IRF-2"}]}
