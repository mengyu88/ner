{"tokens": ["Transfected", "U937", "cells", "stably", "overexpressing", "PKC-zeta", "displayed", "a", "longer", "doubling", "time", ",", "lower", "saturation", "density", "at", "confluency", ",", "and", "an", "increase", "in", "adherence", "to", "plastic", "as", "compared", "to", "control", "cells", "."], "doc_id": "MEDLINE:95151640", "sent_id": "MEDLINE:95151640-2", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "PKC-zeta"}, {"start": 28, "end": 30, "entity_type": "cell_line", "text": "control cells"}]}
{"tokens": ["PKC-zeta", "cells", "expressed", "a", "more", "differentiated", "phenotype", "as", "assessed", "by", "changes", "in", "morphology", ",", "surface", "antigen", "expression", ",", "and", "lysosomal", "enzyme", "activities", "and", "were", "distinct", "from", "parental", "U937", "cells", "stimulated", "to", "differentiate", "by", "exposure", "to", "phorbol", "esters", "."], "doc_id": "MEDLINE:95151640", "sent_id": "MEDLINE:95151640-3", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "PKC-zeta"}, {"start": 0, "end": 2, "entity_type": "cell_line", "text": "PKC-zeta cells"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "lysosomal enzyme"}, {"start": 27, "end": 29, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 26, "end": 29, "entity_type": "cell_line", "text": "parental U937 cells"}]}
{"tokens": ["In", "contrast", "to", "parental", "U937", "cells", ",", "PKC-zeta", "cells", "constitutively", "expressed", "mRNA", "transcripts", "for", "c-jun", "and", "a", "low", "mobility", "AP-1", "binding", "activity", "."], "doc_id": "MEDLINE:95151640", "sent_id": "MEDLINE:95151640-4", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "PKC-zeta"}, {"start": 7, "end": 9, "entity_type": "cell_line", "text": "PKC-zeta cells"}, {"start": 11, "end": 12, "entity_type": "RNA", "text": "mRNA"}, {"start": 11, "end": 13, "entity_type": "RNA", "text": "mRNA transcripts"}, {"start": 14, "end": 15, "entity_type": "DNA", "text": "c-jun"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "AP-1"}]}
