{"tokens": ["However", ",", "B", "series", "cells", "resembled", "the", "A", "series", "cells", "in", "exhibiting", "faster", "growth", "rates", "than", "the", "parental", "HL60", "cells", "and", "showed", "high", "levels", "of", "vitamin", "D", "receptor", "and", "retinoid", "receptor", "X", "proteins", "."], "doc_id": "MEDLINE:97312374", "sent_id": "MEDLINE:97312374-6", "entity_mentions": [{"start": 18, "end": 20, "entity_type": "cell_line", "text": "HL60 cells"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "vitamin D receptor"}, {"start": 29, "end": 33, "entity_type": "protein", "text": "retinoid receptor X proteins"}]}
