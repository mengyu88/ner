{"tokens": ["These", "findings", "demonstrate", "that", "certain", "cytokines", ",", "including", "IFN-gamma", "and", "IL-10", ",", "antagonize", "the", "ability", "of", "IL-4", "and", "IL-13", "to", "induce", "increased", "expression", "of", "the", "IL-1RI", "and", "IL-1RII", "genes", "in", "monocytes", "."], "doc_id": "MEDLINE:98209796", "sent_id": "MEDLINE:98209796-11", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-10"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "IL-4"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "IL-13"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "IL-1RII"}, {"start": 27, "end": 29, "entity_type": "DNA", "text": "IL-1RII genes"}, {"start": 30, "end": 31, "entity_type": "cell_type", "text": "monocytes"}]}
