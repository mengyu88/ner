{"tokens": ["Cytokine", "and", "growth", "factor", "receptor", "engagement", "leads", "to", "the", "rapid", "phosphorylation", "and", "activation", "of", "latent", ",", "cytosolic", "signal", "transducers", "and", "activators", "of", "transcription", "(", "STAT", ")", "proteins", ",", "which", "then", "translocate", "to", "the", "nucleus", "where", "they", "regulate", "transcriptional", "events", "from", "specific", "promoter", "sequences", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Cytokine"}, {"start": 2, "end": 5, "entity_type": "protein", "text": "growth factor receptor"}, {"start": 16, "end": 27, "entity_type": "protein", "text": "cytosolic signal transducers and activators of transcription ( STAT ) proteins"}, {"start": 40, "end": 43, "entity_type": "DNA", "text": "specific promoter sequences"}]}
{"tokens": ["STAT3", "expression", "in", "particular", "has", "been", "associated", "with", "Abl", ",", "Src", ",", "and", "HTLV-1", "transformation", "of", "normal", "cells", "."], "doc_id": "MEDLINE:97228139", "sent_id": "MEDLINE:97228139-2", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "STAT3"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "Abl"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "Src"}, {"start": 16, "end": 18, "entity_type": "cell_type", "text": "normal cells"}]}
