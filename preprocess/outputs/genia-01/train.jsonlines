{"tokens": ["We", "have", "found", "that", "in", "nodular", "lymphocyte", "predominance", "HD", "(", "NLPHD", ")", "tumor", "cells", "consistently", "display", "the", "BCL-6", "(+)/", "syn-1", "(-)", "phenotype", ",", "indicating", "their", "derivation", "from", "GC", "B", "cells", "."], "doc_id": "MEDLINE:98421363", "sent_id": "MEDLINE:98421363-4", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "BCL-6"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "syn-1"}, {"start": 27, "end": 30, "entity_type": "cell_type", "text": "GC B cells"}]}
{"tokens": ["Conversely", ",", "classic", "HD", "(", "CHD", ")", "is", "heterogeneous", "because", "the", "tumor", "cells", "of", "a", "fraction", "of", "CHD", "display", "the", "BCL-6", "(-)/", "syn-1", "(+)", "phenotype", "of", "post-GC", "B-cells", ",", "whereas", "another", "fraction", "of", "CHD", "is", "constituted", "by", "a", "mixture", "of", "tumor", "cells", "reflecting", "the", "GC", "(", "BCL-6", "(+)/", "syn-1", "(-)", ")", "or", "post-GC", "(", "BCL-6", "(-)/", "syn-1", "(+)", ")", "phenotypes", "."], "doc_id": "MEDLINE:98421363", "sent_id": "MEDLINE:98421363-5", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "BCL-6"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "syn-1"}, {"start": 40, "end": 42, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 46, "end": 47, "entity_type": "protein", "text": "BCL-6"}, {"start": 48, "end": 49, "entity_type": "protein", "text": "syn-1"}, {"start": 54, "end": 55, "entity_type": "protein", "text": "BCL-6"}, {"start": 56, "end": 57, "entity_type": "protein", "text": "syn-1"}]}
{"tokens": ["BCL-6", "(-)/", "syn-1", "(+)", "tumor", "cells", "of", "CHD", "are", "mostly", "found", "surrounded", "by", "T", "cells", "expressing", "CD40L", ",", "consistent", "with", "the", "observation", "that", "CD40", "signaling", "downregulates", "BCL-6", "expression", "."], "doc_id": "MEDLINE:98421363", "sent_id": "MEDLINE:98421363-6", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "BCL-6"}, {"start": 2, "end": 3, "entity_type": "protein", "text": "syn-1"}, {"start": 4, "end": 6, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 0, "end": 6, "entity_type": "cell_line", "text": "BCL-6 (-)/ syn-1 (+) tumor cells"}, {"start": 13, "end": 15, "entity_type": "cell_type", "text": "T cells"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "CD40L"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "CD40"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "BCL-6"}]}
{"tokens": ["These", "data", "indicate", "that", "tumor", "cells", "of", "NLPHD", "uniformly", "display", "a", "GC", "B-cell", "phenotype", ",", "whereas", "the", "phenotype", "of", "tumor", "cells", "of", "CHD", "appears", "to", "be", "modulated", "by", "the", "surrounding", "cellular", "background", ",", "particularly", "CD40L", "+", "reactive", "T", "cells", "."], "doc_id": "MEDLINE:98421363", "sent_id": "MEDLINE:98421363-7", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 19, "end": 21, "entity_type": "cell_type", "text": "tumor cells"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "CD40L"}, {"start": 37, "end": 39, "entity_type": "cell_type", "text": "T cells"}, {"start": 34, "end": 39, "entity_type": "cell_type", "text": "CD40L + reactive T cells"}]}
