{"tokens": ["These", "results", "show", "that", ",", "physiologically", ",", "high", "levels", "of", "nuclear", "of", "p50", ",", "p52", "and", "RelB", "are", "restricted", "to", "accessory", "cells", "of", "the", "immune", "system", ",", "which", "include", "FDC", "in", "GC", ",", "and", "DC", "and", "macrophages", "in", "the", "T", "cell", "zone", ",", "that", "specialized", "scavenger", "macrophages", "from", "GC", "do", "not", "have", "detectable", "levels", "of", "p52", "and", "RelB", ",", "whereas", "macrophages", "from", "the", "T", "cell", "area", ",", "known", "to", "present", "the", "antigen", "to", "T", "cells", ",", "do", "have", "both", "nuclear", "p52", "and", "RelB", ",", "and", "that", "in", "the", "T", "cell", "zone", ",", "p52", "and", "RelB", "are", "located", "in", "nuclei", "of", "both", "CD1a+", ",", "CD68+", "or", "both", ",", "cells", "APC", ",", "whereas", "p50", "is", "restricted", "to", "CD1a-", "and", "CD68- APC", "."], "doc_id": "MEDLINE:97080592", "sent_id": "MEDLINE:97080592-12", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "p50"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "p52"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "RelB"}, {"start": 20, "end": 22, "entity_type": "cell_type", "text": "accessory cells"}, {"start": 29, "end": 30, "entity_type": "cell_type", "text": "FDC"}, {"start": 34, "end": 35, "entity_type": "cell_type", "text": "DC"}, {"start": 45, "end": 47, "entity_type": "cell_type", "text": "scavenger macrophages"}, {"start": 48, "end": 49, "entity_type": "cell_type", "text": "GC"}, {"start": 55, "end": 56, "entity_type": "protein", "text": "p52"}, {"start": 57, "end": 58, "entity_type": "protein", "text": "RelB"}, {"start": 60, "end": 61, "entity_type": "cell_type", "text": "macrophages"}, {"start": 73, "end": 75, "entity_type": "cell_type", "text": "T cells"}, {"start": 80, "end": 81, "entity_type": "protein", "text": "p52"}, {"start": 82, "end": 83, "e