{"tokens": ["We", "found", "that", "GIG18", "was", "rapidly", "induced", "to", "comparable", "levels", "by", "both", "AR", "and", "GR", ",", "demonstrating", "that", "AR", "can", "indeed", "function", "as", "a", "transcriptional", "activator", "in", "S49", "cells", "and", ",", "moreover", ",", "that", "GIG18", "induction", "may", "be", "a", "marker", "of", "early", "apoptotic", "events", "in", "steroid-treated", "cells", "."], "doc_id": "MEDLINE:97000328", "sent_id": "MEDLINE:97000328-8", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "DNA", "text": "GIG18"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "AR"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "GR"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "AR"}, {"start": 27, "end": 29, "entity_type": "cell_line", "text": "S49 cells"}, {"start": 34, "end": 35, "entity_type": "DNA", "text": "GIG18"}]}
