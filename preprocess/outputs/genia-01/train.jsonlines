{"tokens": ["In", "both", "cases", ",", "induction", "of", "TNF-alpha", "gene", "transcription", "can", "be", "blocked", "by", "the", "immunosuppressants", "cyclosporin", "A", "and", "FK506", ",", "which", "suggested", "a", "role", "for", "the", "NFAT", "family", "of", "proteins", "in", "the", "regulation", "of", "the", "gene", "in", "B", "cells", "."], "doc_id": "MEDLINE:96413274", "sent_id": "MEDLINE:96413274-2", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "DNA", "text": "TNF-alpha gene"}, {"start": 26, "end": 28, "entity_type": "protein", "text": "NFAT family"}, {"start": 37, "end": 39, "entity_type": "cell_type", "text": "B cells"}]}
