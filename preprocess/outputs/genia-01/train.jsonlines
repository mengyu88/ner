{"tokens": ["Among", "these", "hypersensitive", "sites", ",", "two", "transcriptional", "control", "elements", "were", "found", ",", "one", "in", "the", "first", "intron", "of", "the", "GATA-3", "gene", "and", "the", "other", "between", "8.3", "and", "5.9", "kilobases", "5'", "from", "the", "GATA-3", "transcriptional", "initiation", "site", "."], "doc_id": "MEDLINE:99156941", "sent_id": "MEDLINE:99156941-4", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "DNA", "text": "hypersensitive sites"}, {"start": 6, "end": 9, "entity_type": "DNA", "text": "transcriptional control elements"}, {"start": 15, "end": 17, "entity_type": "DNA", "text": "first intron"}, {"start": 19, "end": 21, "entity_type": "DNA", "text": "GATA-3 gene"}, {"start": 24, "end": 29, "entity_type": "DNA", "text": "between 8.3 and 5.9 kilobases"}, {"start": 33, "end": 36, "entity_type": "DNA", "text": "transcriptional initiation site"}, {"start": 32, "end": 36, "entity_type": "DNA", "text": "GATA-3 transcriptional initiation site"}]}
