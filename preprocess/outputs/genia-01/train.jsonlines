{"tokens": ["We", "have", "developed", "a", "three-layer", "Percoll", "density", "gradient", "that", "allows", "separation", "of", "the", "different", "granules", "and", "vesicles", "from", "human", "neutrophils", ";", "in", "particular", ",", "it", "allows", "separation", "of", "specific", "and", "gelatinase", "granules", "."], "doc_id": "MEDLINE:94169380", "sent_id": "MEDLINE:94169380-3", "entity_mentions": [{"start": 18, "end": 20, "entity_type": "cell_type", "text": "human neutrophils"}]}
{"tokens": ["This", "allows", "us", "to", "characterize", "these", "two", "granule", "populations", "with", "regard", "to", "their", "content", "of", "membrane", "proteins", ",", "which", "become", "incorporated", "into", "the", "plasma", "membrane", "during", "exocytosis", "."], "doc_id": "MEDLINE:94169380", "sent_id": "MEDLINE:94169380-4", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "protein", "text": "membrane proteins"}]}
