{"tokens": ["Experimentally", "B", "cell", "progenitors", "do", "not", "tolerate", "constitutive", "expression", "of", "E2a-Pbx1", "which", "contrasts", "with", "transformation", "of", "several", "other", "cell", "types", "following", "its", "stable", "expression", "both", "in", "vitro", "and", "in", "vivo", "."], "doc_id": "MEDLINE:97349094", "sent_id": "MEDLINE:97349094-2", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "cell_type", "text": "B cell progenitors"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "E2a-Pbx1"}]}
{"tokens": ["To", "further", "investigate", "the", "effects", "of", "E2a-Pbx1", "on", "the", "B", "cell", "progenitors", ",", "we", "conditionally", "expressed", "E2a-Pbx1", "under", "control", "of", "a", "metal", "response", "element", "in", "hematopoietic", "precursor", "cell", "lines", "in", "vitro", "."], "doc_id": "MEDLINE:97349094", "sent_id": "MEDLINE:97349094-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "E2a-Pbx1"}, {"start": 9, "end": 12, "entity_type": "cell_type", "text": "B cell progenitors"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "E2a-Pbx1"}, {"start": 25, "end": 29, "entity_type": "cell_line", "text": "hematopoietic precursor cell lines"}]}
