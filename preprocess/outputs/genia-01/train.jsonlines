{"tokens": ["Functional", "IL-12", "is", "a", "heterodimer", "composed", "of", "two", "distinct", "subunits", "that", "are", "encoded", "by", "separate", "genes", "on", "different", "chromosomes", "."], "doc_id": "MEDLINE:97333610", "sent_id": "MEDLINE:97333610-5", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "IL-12"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "heterodimer"}]}
