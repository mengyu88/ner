{"tokens": ["To", "examine", "the", "potential", "effects", "of", "stress", "on", "TH1/TH2", "balance", ",", "we", "studied", "the", "ability", "of", "three", "prototype", "stress", "hormones", "-", "dexamethasone", "(", "a", "synthetic", "glucocorticoid", ")", "and", "the", "catecholamines", "norepinephrine", "and", "epinephrine", "-", "to", "alter", "the", "production", "of", "IL-12", "(", "p70", ")", "and", "IL-10", "induced", "by", "bacterial", "lipopolysaccharide", "(", "LPS", ")", "in", "human", "whole", "blood", "."], "doc_id": "MEDLINE:97058563", "sent_id": "MEDLINE:97058563-2", "entity_mentions": [{"start": 39, "end": 40, "entity_type": "protein", "text": "IL-12"}, {"start": 41, "end": 42, "entity_type": "protein", "text": "p70"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "IL-10"}]}
{"tokens": ["Dexamethasone", "inhibited", "LPS", "-induced", "bioactive", "IL-12", "production", "in", "a", "dose-dependent", "fashion", "and", "at", "physiologically", "relevant", "concentrations", ";", "it", "had", "no", "effect", "on", "IL-10", "secretion", "."], "doc_id": "MEDLINE:97058563", "sent_id": "MEDLINE:97058563-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "IL-12"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "IL-10"}]}
