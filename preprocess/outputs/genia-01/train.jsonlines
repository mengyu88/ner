{"tokens": ["In", "the", "current", "study", ",", "we", "undertook", "a", "biochemical", "analysis", "of", "IL-10", "receptor", "expression", "on", "freshly", "isolated", "B-CLL", "cells", "and", "characterized", "the", "functional", "responsiveness", "of", "IL-10", "binding", "to", "its", "constitutively", "expressed", "receptor", "."], "doc_id": "MEDLINE:97309442", "sent_id": "MEDLINE:97309442-5", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "protein", "text": "IL-10 receptor"}, {"start": 17, "end": 19, "entity_type": "cell_line", "text": "B-CLL cells"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "IL-10"}, {"start": 29, "end": 32, "entity_type": "protein", "text": "constitutively expressed receptor"}]}
{"tokens": ["We", "show", "that", "B-CLL", "cells", "bind", "IL-10", "with", "significant", "specificity", "and", "express", "between", "47", "and", "127", "IL-10", "receptor", "sites", "per", "cell", ",", "with", "a", "dissociation", "constant", "in", "the", "range", "of", "168", "to", "426", "x", "10(-12)", "mol/L", "."], "doc_id": "MEDLINE:97309442", "sent_id": "MEDLINE:97309442-6", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "cell_line", "text": "B-CLL cells"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "IL-10"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "IL-10 receptor"}]}
