{"tokens": ["Central", "to", "the", "bone-sparing", "effect", "of", "estrogen", "(", "E", "(", "2", ")", ")", "is", "its", "ability", "to", "block", "the", "monocytic", "production", "of", "the", "osteoclastogenic", "cytokine", "TNF-alpha", "(", "TNF", ")", "."], "doc_id": "MEDLINE:99380273", "sent_id": "MEDLINE:99380273-1", "entity_mentions": [{"start": 23, "end": 26, "entity_type": "protein", "text": "osteoclastogenic cytokine TNF-alpha"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "TNF"}]}
