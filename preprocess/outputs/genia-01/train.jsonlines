{"tokens": ["The", "induction", "of", "the", "AP-1", "transcription", "factor", "has", "been", "ascribed", "to", "the", "early", "events", "leading", "to", "T", "lymphocyte", "activation", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-1", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "AP-1"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "transcription factor"}]}
{"tokens": ["We", "have", "examined", "the", "possibility", "that", "stimulation", "of", "phospholipase", "D", "(", "PLD", ")", "may", "regulate", "activation", "of", "transcription", "factor", "AP-1", "in", "human", "T", "cells", "by", "transfecting", "human", "T", "lymphocyte", "Jurkat", "cells", "with", "a", "plasmid", "containing", "an", "AP-1", "enhancer", "element", "and", "a", "chloramphenicol", "acetyltransferase", "reporter", "gene", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-2", "entity_mentions": [{"start": 8, "end": 10, "entity_type": "protein", "text": "phospholipase D"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "PLD"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "AP-1"}, {"start": 17, "end": 20, "entity_type": "protein", "text": "transcription factor AP-1"}, {"start": 29, "end": 31, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 27, "end": 31, "entity_type": "cell_line", "text": "T lymphocyte Jurkat cells"}, {"start": 36, "end": 38, "entity_type": "DNA", "text": "AP-1 enhancer"}, {"start": 36, "end": 39, "entity_type": "DNA", "text": "AP-1 enhancer element"}, {"start": 41, "end": 43, "entity_type": "protein", "text": "chloramphenicol acetyltransferase"}, {"start": 41, "end": 45, "entity_type": "DNA", "text": "chloramphenicol acetyltransferase reporter gene"}]}
{"tokens": ["We", "have", "detected", "activatable", "PLD", "in", "Jurkat", "cells", ",", "and", "we", "have", "found", "that", "addition", "of", "phosphatidic", "acid", "(", "PA", ")", ",", "the", "physiologic", "product", "of", "PLD", "action", "on", "phospholipids", ",", "is", "rapidly", "incorporated", "into", "Jurkat", "cells", "and", "leads", "to", "activation", "of", "transcription", "factor", "AP-1", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-3", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "PLD"}, {"start": 6, "end": 8, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "PLD"}, {"start": 35, "end": 37, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 44, "end": 45, "entity_type": "protein", "text": "AP-1"}, {"start": 42, "end": 45, "entity_type": "protein", "text": "transcription factor AP-1"}]}
{"tokens": ["Treatment", "of", "Jurkat", "cells", "with", "anti-CD3", "mAb", "activated", "both", "PLD", "and", "transcription", "factor", "AP-1", "."], "doc_id": "MEDLINE:94358411", "sent_id": "MEDLINE:94358411-4", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "anti-CD3 mAb"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "PLD"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "AP-1"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "transcription factor AP-1"}]}
