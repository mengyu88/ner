{"tokens": ["In", "this", "report", ",", "we", "demonstrate", "that", "the", "T", "cell", "tropic", "strain", "of", "HIV", ",", "LAI", ",", "does", "not", "replicate", "in", "naive", "CD4", "T", "cells", "stimulated", "by", "cross-linking", "CD3", "and", "CD28", "."], "doc_id": "MEDLINE:97248268", "sent_id": "MEDLINE:97248268-1", "entity_mentions": [{"start": 21, "end": 25, "entity_type": "cell_type", "text": "naive CD4 T cells"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "CD3"}, {"start": 30, "end": 31, "entity_type": "protein", "text": "CD28"}]}
