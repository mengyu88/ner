{"tokens": ["Recently", "we", "reported", "that", "all-trans-retinoic", "acid", "(", "ATRA", ")", "is", "a", "potent", "and", "highly", "specific", "inducer", "of", "CD38", "expression", "in", "human", "promyelocytic", "leukemia", "cells", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-4", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "CD38"}, {"start": 20, "end": 24, "entity_type": "cell_type", "text": "human promyelocytic leukemia cells"}]}
{"tokens": ["Here", "we", "report", "that", "ATRA", "-induced", "expression", "of", "CD38", "antigen", "in", "myeloid", "cells", "is", "mediated", "through", "retinoic", "acid-alpha", "receptor", "(", "RAR", "alpha", ")", "."], "doc_id": "MEDLINE:94185011", "sent_id": "MEDLINE:94185011-5", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "CD38"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "CD38 antigen"}, {"start": 11, "end": 13, "entity_type": "cell_type", "text": "myeloid cells"}, {"start": 16, "end": 19, "entity_type": "protein", "text": "retinoic acid-alpha receptor"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "RAR alpha"}]}
