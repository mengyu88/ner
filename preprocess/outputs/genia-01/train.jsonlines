{"tokens": ["The", "amount", "of", "vimentin", "mRNA", "was", "also", "increased", "during", "recovery", "from", "stress", ",", "indicating", "that", "vimentin", "expression", "was", "not", "exclusively", "regulated", "at", "the", "protein", "level", "."], "doc_id": "MEDLINE:97196961", "sent_id": "MEDLINE:97196961-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "vimentin"}, {"start": 3, "end": 5, "entity_type": "RNA", "text": "vimentin mRNA"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "vimentin"}]}
