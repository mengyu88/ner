{"tokens": ["GR", "number", "in", "the", "patient", "'s", "transformed", "lymphocytes", "was", "approximately", "one", "half", "that", "of", "control", "cells", "with", "a", "approximately", "10-fold", "reduction", "in", "binding", "affinity", "for", "dexamethasone", "."], "doc_id": "MEDLINE:99120900", "sent_id": "MEDLINE:99120900-6", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "cell_line", "text": "transformed lymphocytes"}]}
