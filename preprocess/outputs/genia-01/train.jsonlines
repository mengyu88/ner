{"tokens": ["The", "induction", "of", "T", "cell", "proliferation", "requires", "signals", "from", "the", "TCR", "and", "a", "co-receptor", "molecule", ",", "such", "as", "CD28", ",", "that", "activate", "parallel", "and", "partially", "cross-reactive", "signaling", "pathways", "."], "doc_id": "MEDLINE:96322738", "sent_id": "MEDLINE:96322738-1", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "TCR"}, {"start": 13, "end": 15, "entity_type": "protein", "text": "co-receptor molecule"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "CD28"}]}
