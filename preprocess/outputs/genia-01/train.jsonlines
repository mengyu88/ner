{"tokens": ["The", "expression", "of", "p45", "megakaryocytic", "lineage", "cells", ",", "p45", "mRNA", "is", "transcribed", "only", "from", "aNF-E2", "promoter", "."], "doc_id": "MEDLINE:96216725", "sent_id": "MEDLINE:96216725-9", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "p45"}, {"start": 4, "end": 7, "entity_type": "cell_type", "text": "megakaryocytic lineage cells"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "p45"}, {"start": 8, "end": 10, "entity_type": "RNA", "text": "p45 mRNA"}, {"start": 14, "end": 16, "entity_type": "DNA", "text": "aNF-E2 promoter"}]}
{"tokens": ["The", "expression", "of", "p45", "mRNA", "in", "the", "neutrophils", "declined", "rapidly", "after", "transfer", "of", "the", "cells", "to", "in", "vitro", "culture", "and", "G-CSF", "could", "not", "sustain", "the", "expression", "from", "the", "down-regulation", ",", "suggesting", "the", "E2", "may", "also", "participate", "in", "the", "regulation", "of", "neutrophil-specific", "gene", "expression", "."], "doc_id": "MEDLINE:96216725", "sent_id": "MEDLINE:96216725-10", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "p45"}, {"start": 3, "end": 5, "entity_type": "RNA", "text": "p45 mRNA"}, {"start": 7, "end": 8, "entity_type": "cell_type", "text": "neutrophils"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "G-CSF"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "E2"}]}
{"tokens": ["Expression", "of", "c-fos", "and", "c-jun", "proteins", "and", "AP-1", "binding", "activity", "during", "cell", "cycle", "progression", "of", "HL60", "cells", "and", "phytohemagglutinin", "-stimulated", "lymphocytes", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-0", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "c-fos"}, {"start": 2, "end": 3, "entity_type": "DNA", "text": "c-fos"}, {"start": 4, "end": 5, "entity_type": "DNA", "text": "c-jun"}, {"start": 4, "end": 6, "entity_type": "protein", "text": "c-jun proteins"}, {"start": 2, "end": 6, "entity_type": "protein", "text": "c-fos and c-jun proteins"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "AP-1"}, {"start": 15, "end": 17, "entity_type": "cell_line", "text": "HL60 cells"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "phytohemagglutinin"}, {"start": 18, "end": 21, "entity_type": "cell_line", "text": "phytohemagglutinin -stimulated lymphocytes"}]}
{"tokens": ["The", "protein", "products", "of", "the", "c-fos", "(", "p62c-fos", ")", "and", "c-jun", "(", "p39c-jun", ")", "genes", "are", "members", "of", "the", "AP-1", "transcription", "factor", "family", "and", "are", "thought", "to", "play", "important", "roles", "in", "the", "regulation", "of", "gene", "expression", "during", "the", "cell", "cycle", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-1", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "c-fos"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "p62c-fos"}, {"start": 10, "end": 11, "entity_type": "DNA", "text": "c-jun"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "p39c-jun"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "AP-1"}, {"start": 19, "end": 23, "entity_type": "protein", "text": "AP-1 transcription factor family"}]}
{"tokens": ["Most", "studies", "on", "the", "expression", "of", "these", "proteins", "in", "relation", "to", "the", "cell", "cycle", "have", "been", "performed", "at", "the", "mRNA", "level", ",", "and", "therefore", "do", "not", "give", "direct", "information", "about", "the", "presence", "of", "the", "proteins", "during", "the", "cell", "cycle", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-2", "entity_mentions": []}
{"tokens": ["We", "have", "used", "Western", "blotting", "to", "investigate", "the", "presence", "of", "these", "proteins", "during", "the", "cell", "cycles", "of", "two", "different", "cellular", "systems", ":", "a", "continuously", "growing", "myeloid", "leukemic", "cell", "line", ",", "HL60", ",", "and", "normal", "cells", "stimulated", "into", "cycle", ",", "phyto- hemagglutinin", "(", "PHA", ")", "-stimulated", "normal", "human", "peripheral", "blood", "lymphocytes", "(", "PBL", ")", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-3", "entity_mentions": [{"start": 19, "end": 21, "entity_type": "cell_line", "text": "cellular systems"}, {"start": 23, "end": 29, "entity_type": "cell_line", "text": "continuously growing myeloid leukemic cell line"}, {"start": 30, "end": 31, "entity_type": "cell_line", "text": "HL60"}, {"start": 33, "end": 35, "entity_type": "cell_type", "text": "normal cells"}, {"start": 41, "end": 42, "entity_type": "protein", "text": "PHA"}, {"start": 39, "end": 49, "entity_type": "cell_line", "text": "phyto- hemagglutinin ( PHA ) -stimulated normal human peripheral blood lymphocytes"}, {"start": 50, "end": 51, "entity_type": "cell_type", "text": "PBL"}]}
{"tokens": ["The", "binding", "activity", "of", "transcription", "factor", "AP-1", ",", "which", "consists", "of", "dimers", "of", "Fos", "and", "Jun", "family", "proteins", ",", "was", "also", "studied", "using", "a", "gel", "shift", "assay", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-4", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["We", "found", "nuclear", "p62c-fos", ",", "p39c-jun", ",", "and", "AP-1", "binding", "activity", "throughout", "the", "cell", "cycle", "both", "in", "HL60", "cells", "and", "in", "PHA", "-stimulated", "PBL", ",", "and", "we", "postulate", "that", "these", "proteins", "are", "required", "throughout", "the", "cell", "cycle", "and", "not", "transiently", "in", "the", "G0", "to", "G1", "transition", "as", "previous", "mRNA", "studies", "have", "indicated", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-5", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "p62c-fos"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "p39c-jun"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "AP-1"}, {"start": 17, "end": 19, "entity_type": "cell_line", "text": "HL60 cells"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "PHA"}, {"start": 21, "end": 24, "entity_type": "cell_line", "text": "PHA -stimulated PBL"}]}
{"tokens": ["We", "demonstrated", "an", "uncoupling", "of", "AP-1", "binding", "activity", "from", "p62c-fos", ",", "and", "p39c-jun", "AP-1", "activity", "was", "expressed", "more", "strongly", "in", "the", "G1-", "and", "G2/M-", "phase", "enriched", "samples", "than", "in", "the", "S-phase", "enriched", "samples", "of", "HL60", "cells", ",", "while", "levels", "of", "nuclear", "p62c-fos", "and", "p39c-jun", "were", "constant", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-6", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "AP-1"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "p62c-fos"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "p39c-jun"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "AP-1"}, {"start": 34, "end": 36, "entity_type": "cell_line", "text": "HL60 cells"}]}
{"tokens": ["Nuclei", "of", "unstimulated", "PBL", "from", "different", "donors", "expressed", "p62c-fos", "and", "p39c-jun", ",", "but", "AP-1", "was", "not", "detected", "in", "the", "majority", "of", "samples", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-7", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_type", "text": "unstimulated PBL"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "p62c-fos"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "p39c-jun"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["Following", "PHA", "stimulation", "of", "PBL", ",", "the", "increase", "in", "AP-1", "activity", "was", "delayed", "with", "respect", "to", "the", "augmentation", "of", "p39c-jun", "expression", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-8", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "PHA"}, {"start": 4, "end": 5, "entity_type": "cell_type", "text": "PBL"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "AP-1"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "p39c-jun"}]}
{"tokens": ["We", "also", "observed", "that", "cytoplasmic", "p62c-fos", "and", "p39c-jun", "were", "present", "in", "HL60", "cells", "and", "PHA", "-stimulated", "PBL", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-9", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "cell_line", "text": "HL60 cells"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "PHA"}, {"start": 16, "end": 17, "entity_type": "cell_type", "text": "PBL"}, {"start": 14, "end": 17, "entity_type": "cell_line", "text": "PHA -stimulated PBL"}]}
{"tokens": ["However", ",", "no", "cytoplasmic", "p62c-fos", "was", "detected", "in", "unstimulated", "PBL", ",", "although", "in", "some", "cases", "cytoplasmic", "p39c-jun", "was", "detected", ",", "suggesting", "that", "subcellular", "compartmentalization", "of", "these", "proteins", "may", "occur", "under", "certain", "circumstances", "."], "doc_id": "MEDLINE:96195546", "sent_id": "MEDLINE:96195546-10", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "p62c-fos"}, {"start": 3, "end": 5, "entity_type": "protein", "text": "cytoplasmic p62c-fos"}, {"start": 8, "end": 10, "entity_type": "cell_type", "text": "unstimulated PBL"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "p39c-jun"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "cytoplasmic p39c-jun"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "proteins"}]}
{"tokens": ["Octamer", "binding", "factors", "and", "their", "coactivator", "can", "activate", "the", "murine", "PU.1", "(", "spi-1", ")", "promoter", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-0", "entity_mentions": [{"start": 0, "end": 3, "entity_type": "protein", "text": "Octamer binding factors"}, {"start": 5, "end": 6, "entity_type": "protein", "text": "coactivator"}, {"start": 9, "end": 15, "entity_type": "DNA", "text": "murine PU.1 ( spi-1 ) promoter"}]}
{"tokens": ["PU.1", "(", "spi-1", ")", ",", "a", "member", "of", "the", "Ets", "transcription", "factor", "family", ",", "is", "predominantly", "expressed", "in", "myeloid", "and", "B", "cells", ",", "activates", "many", "B", "cell", "and", "myeloid", "genes", ",", "and", "is", "critical", "for", "development", "of", "both", "of", "these", "lineages", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "PU.1"}, {"start": 2, "end": 3, "entity_type": "protein", "text": "spi-1"}, {"start": 9, "end": 13, "entity_type": "protein", "text": "Ets transcription factor family"}]}
{"tokens": ["Our", "previous", "studies", "(", "Chen", ",", "H.M.", ",", "Ray-Gallet", ",", "D.", ",", "Zhang", ",", "P.", ",", "Hetherington", ",", "C.J.", ",", "Gonzalez", ",", "D.A.", ",", "Zhang", ",", "D.-E.", ",", "Moreau-Gachelin", ",", "F.", ",", "and", "Tenen", ",", "D.G.", "(", "1995", ")", "Oncogene", "11", ",", "1549-1560", ")", "demonstrate", "that", "the", "PU.1", "promoter", "directs", "cell", "type-specific", "reporter", "gene", "expression", "in", "myeloid", "cell", "lines", ",", "and", "that", "PU.1", "activates", "its", "own", "promoter", "in", "an", "autoregulatory", "loop", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-2", "entity_mentions": [{"start": 47, "end": 48, "entity_type": "protein", "text": "PU.1"}, {"start": 47, "end": 49, "entity_type": "DNA", "text": "PU.1 promoter"}, {"start": 50, "end": 54, "entity_type": "DNA", "text": "cell type-specific reporter gene"}, {"start": 62, "end": 63, "entity_type": "protein", "text": "PU.1"}]}
{"tokens": ["Here", "we", "show", "that", "the", "murine", "PU.1", "promoter", "is", "also", "specifically", "and", "highly", "functional", "in", "B", "cell", "lines", "as", "well", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "PU.1"}, {"start": 6, "end": 8, "entity_type": "DNA", "text": "PU.1 promoter"}, {"start": 5, "end": 8, "entity_type": "DNA", "text": "murine PU.1 promoter"}, {"start": 15, "end": 18, "entity_type": "cell_line", "text": "B cell lines"}]}
{"tokens": ["Oct-1", "and", "Oct-2", "can", "bind", "specifically", "to", "a", "site", "at", "base", "pair", "-55", "in", "vitro", ",", "and", "this", "site", "is", "specifically", "protected", "in", "B", "cells", "in", "vivo", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Oct-1"}, {"start": 2, "end": 3, "entity_type": "protein", "text": "Oct-2"}, {"start": 23, "end": 25, "entity_type": "cell_type", "text": "B cells"}]}
{"tokens": ["We", "also", "demonstrate", "that", "two", "other", "sites", "contribute", "to", "promoter", "activity", "in", "B", "cells", ";", "an", "Sp1", "binding", "site", "adjacent", "to", "the", "octamer", "site", ",", "and", "the", "PU.1", "autoregulatory", "site", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-5", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "cell_type", "text": "B cells"}, {"start": 16, "end": 19, "entity_type": "DNA", "text": "Sp1 binding site"}, {"start": 22, "end": 24, "entity_type": "DNA", "text": "octamer site"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "PU.1"}, {"start": 27, "end": 30, "entity_type": "DNA", "text": "PU.1 autoregulatory site"}]}
{"tokens": ["Finally", ",", "we", "show", "that", "the", "B", "cell", "coactivator", "OBF-1/Bob1/OCA-B", "is", "only", "expressed", "in", "B", "cells", "and", "not", "in", "myeloid", "cells", ",", "and", "that", "OBF-1/Bob1/OCA-B", "can", "transactivate", "the", "PU.1", "promoter", "in", "HeLa", "and", "myeloid", "cells", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-6", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "coactivator"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "OBF-1/Bob1/OCA-B"}, {"start": 14, "end": 16, "entity_type": "cell_type", "text": "B cells"}, {"start": 19, "end": 21, "entity_type": "cell_type", "text": "myeloid cells"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "OBF-1/Bob1/OCA-B"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "PU.1"}, {"start": 28, "end": 30, "entity_type": "DNA", "text": "PU.1 promoter"}, {"start": 31, "end": 32, "entity_type": "cell_line", "text": "HeLa"}, {"start": 33, "end": 35, "entity_type": "cell_type", "text": "myeloid cells"}]}
{"tokens": ["This", "B", "cell", "restricted", "coactivator", "may", "be", "responsible", "for", "the", "B", "cell", "specific", "expression", "of", "PU.1", "mediated", "by", "the", "octamer", "site", "."], "doc_id": "MEDLINE:96279101", "sent_id": "MEDLINE:96279101-7", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "coactivator"}, {"start": 1, "end": 5, "entity_type": "protein", "text": "B cell restricted coactivator"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "PU.1"}, {"start": 19, "end": 21, "entity_type": "DNA", "text": "octamer site"}]}
{"tokens": ["Inhibition", "of", "p105", "processing", "by", "NF-kappaB", "proteins", "in", "transiently", "transfected", "cells", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-0", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "p105"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "NF-kappaB proteins"}, {"start": 8, "end": 11, "entity_type": "cell_line", "text": "transiently transfected cells"}]}
{"tokens": ["Regulation", "of", "the", "transcription", "factor", "NF-kappaB", "involves", "proteasome-mediated", "processing", "of", "the", "NF-kappaB1", "p105", "precursor", "protein", ",", "which", "generates", "the", "p50", "subunit", "of", "NF-kappaB", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-1", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "p105"}, {"start": 11, "end": 15, "entity_type": "protein", "text": "NF-kappaB1 p105 precursor protein"}, {"start": 19, "end": 21, "entity_type": "protein", "text": "p50 subunit"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "NF-kappaB"}]}
{"tokens": ["The", "processing", "of", "p105", "occurs", "constitutively", "in", "vivo", "but", "can", "be", "markedly", "enhanced", "by", "various", "cellular", "activation", "agents", ",", "although", "the", "underlying", "regulatory", "mechanism", "is", "not", "yet", "clear", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-2", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "p105"}]}
{"tokens": ["In", "the", "present", "study", ",", "we", "demonstrate", "that", "signal-mediated", "induction", "of", "p105", "processing", "in", "human", "T", "cells", "is", "associated", "with", "de", "novo", "synthesis", "of", "this", "precursor", "protein", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-3", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "p105"}, {"start": 14, "end": 17, "entity_type": "cell_type", "text": "human T cells"}, {"start": 25, "end": 27, "entity_type": "protein", "text": "precursor protein"}]}
{"tokens": ["Transient", "transfection", "studies", "performed", "in", "COS7", "cells", "revealed", "that", "the", "newly", "synthesized", "p105", "protein", "appears", "to", "be", "more", "rapidly", "processed", "compared", "to", "its", "accumulated", "form", "that", "is", "already", "associated", "with", "the", "processed", "product", "p50", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-4", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "cell_line", "text": "COS7 cells"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "p105"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "p50"}]}
{"tokens": ["Interestingly", ",", "the", "processing", "rate", "of", "p105", "is", "markedly", "inhibited", "in", "cells", "co-transfected", "with", "p50", "or", "other", "NF-kappaB", "subunits", ",", "including", "RelA", "and", "c-Rel", ",", "that", "physically", "interact", "with", "p105", "."], "doc_id": "MEDLINE:96239599", "sent_id": "MEDLINE:96239599-5", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "p105"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "p50"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 17, "end": 19, "entity_type": "protein", "text": "NF-kappaB subunits"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "RelA"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "c-Rel"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "p105"}]}
