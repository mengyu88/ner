{"tokens": ["By", "examining", "in", "vitro-differentiated", "embryonic", "stem", "cells", ",", "we", "showed", "previously", "that", "in", "the", "absence", "of", "GATA-1", ",", "committed", "erythroid", "precursors", "fail", "to", "complete", "maturation", "and", "instead", "undergo", "apoptosis", "."], "doc_id": "MEDLINE:99310627", "sent_id": "MEDLINE:99310627-2", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "cell_line", "text": "vitro-differentiated embryonic stem cells"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "GATA-1"}, {"start": 18, "end": 21, "entity_type": "cell_line", "text": "committed erythroid precursors"}]}
