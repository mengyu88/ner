{"tokens": ["We", "have", "shown", "that", "1-(5-chloronaphthalene-1-sulfonyl)-1H-hexahydro-1,4-diazepine", "hydrochloride", "(", "ML-9", ")", ",", "an", "inhibitor", "of", "myosin", "light", "chain", "kinase", ",", "induces", "differentiation", "of", "monocytoid", "leukemia", "cell", "lines", "U937", "and", "THP-1", "but", "not", "of", "myeloblastic", "leukemic", "ML-1", "cell", "or", "erythroleukemia", "K562", "cells", "."], "doc_id": "MEDLINE:96221559", "sent_id": "MEDLINE:96221559-2", "entity_mentions": [{"start": 13, "end": 17, "entity_type": "protein", "text": "myosin light chain kinase"}, {"start": 21, "end": 25, "entity_type": "cell_line", "text": "monocytoid leukemia cell lines"}, {"start": 25, "end": 26, "entity_type": "cell_line", "text": "U937"}, {"start": 27, "end": 28, "entity_type": "cell_line", "text": "THP-1"}, {"start": 31, "end": 35, "entity_type": "cell_line", "text": "myeloblastic leukemic ML-1 cell"}, {"start": 36, "end": 39, "entity_type": "cell_line", "text": "erythroleukemia K562 cells"}]}
{"tokens": ["In", "the", "present", "study", ",", "we", "further", "analyzed", "the", "effect", "of", "ML-9", "in", "comparison", "with", "that", "of", "1", "alpha, 25-dihydroxyvitamin", "D3", "(", "VD3", ")", "a", "typical", "inducer", "of", "monocytic", "differentiation", "."], "doc_id": "MEDLINE:96221559", "sent_id": "MEDLINE:96221559-3", "entity_mentions": []}
{"tokens": ["ML-9", "induced", "nitroblue", "tetrazolium", "(", "NBT", ")", "-reducing", "activity", "of", "U937", "cell", "more", "rapidly", "than", "VD3", ":", "This", "differentiation", "marker", "was", "induced", "significantly", "after", "incubation", "with", "ML-9", "and", "VD3", "for", "4", "hours", "and", "1", "day", ",", "respectively", "."], "doc_id": "MEDLINE:96221559", "sent_id": "MEDLINE:96221559-4", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "cell_line", "text": "U937 cell"}]}
{"tokens": ["ML-9", "also", "induced", "alpha-naphthyl", "acetate", "esterase", "(", "ANAE", ")", "activity", ",", "another", "monocytic", "differentiation", "marker", ",", "more", "rapidly", "than", "VD3", "."], "doc_id": "MEDLINE:96221559", "sent_id": "MEDLINE:96221559-5", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "protein", "text": "alpha-naphthyl acetate esterase"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "ANAE"}]}
