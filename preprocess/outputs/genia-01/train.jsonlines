{"tokens": ["These", "observations", "provide", "additional", "evidence", "that", "oxLDL", "is", "a", "potent", "modulator", "of", "gene", "expression", "and", "suggest", "that", "(", "dys", ")", "regulation", "of", "NF-kappa", "B", "/Rel", "is", "likely", "to", "play", "an", "important", "role", "in", "atherogenesis", "."], "doc_id": "MEDLINE:98012705", "sent_id": "MEDLINE:98012705-7", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "oxLDL"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 22, "end": 25, "entity_type": "protein", "text": "NF-kappa B /Rel"}]}
