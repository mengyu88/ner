{"tokens": ["A", "fusion", "between", "these", "15", "amino", "acids", "and", "the", "GAL4", "DNA", "binding", "domain", "was", "capable", "of", "transactivating", "reporters", "driven", "by", "the", "GAL4", "DNA", "binding", "site", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-4", "entity_mentions": [{"start": 9, "end": 13, "entity_type": "protein", "text": "GAL4 DNA binding domain"}, {"start": 21, "end": 25, "entity_type": "DNA", "text": "GAL4 DNA binding site"}]}
{"tokens": ["Interestingly", ",", "this", "15-amino", "acid", "transactivation", "sequence", "is", "well", "conserved", "in", "NFAT", "family", "proteins", ",", "although", "the", "sequences", "contiguous", "to", "the", "carboxyl-terminal", "regions", "of", "the", "NFAT", "family", "are", "much", "less", "conserved", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-5", "entity_mentions": [{"start": 3, "end": 7, "entity_type": "protein", "text": "15-amino acid transactivation sequence"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "NFAT family"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "NFAT family proteins"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "carboxyl-terminal regions"}, {"start": 25, "end": 27, "entity_type": "protein", "text": "NFAT family"}]}
{"tokens": ["We", "also", "report", "three", "additional", "isoforms", "of", "NFATx", ",", "designated", "NFATx2", ",", "NFATx3", ",", "and", "NFATx4", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-6", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "NFATx"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "NFATx2"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "NFATx3"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "NFATx4"}]}
{"tokens": ["This", "transactivation", "sequence", "is", "altered", "by", "tissue-specific", "alternative", "splicing", "in", "newly", "isolated", "NFATx", "isoforms", ",", "resulting", "in", "lower", "transactivation", "activity", "in", "Jurkat", "T", "cells", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-7", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "NFATx"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "NFATx isoforms"}, {"start": 21, "end": 24, "entity_type": "cell_line", "text": "Jurkat T cells"}]}
{"tokens": ["NFATx1", "is", "expressed", "predominantly", "in", "the", "thymus", "and", "peripheral", "blood", "leukocyte", ",", "while", "the", "skeletal", "muscle", "expressed", "primarily", "NFATx2", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-8", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "NFATx1"}, {"start": 8, "end": 11, "entity_type": "cell_type", "text": "peripheral blood leukocyte"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "NFATx2"}]}
{"tokens": ["In", "Jurkat", "cells", ",", "transcription", "from", "the", "NFAT", "site", "of", "the", "IL-2", "promoter", "is", "activated", "strongly", "by", "NFATx1", "but", "only", "weakly", "by", "NFATx2", "."], "doc_id": "MEDLINE:98430664", "sent_id": "MEDLINE:98430664-9", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "Jurkat cells"}, {"start": 7, "end": 9, "entity_type": "DNA", "text": "NFAT site"}, {"start": 11, "end": 13, "entity_type": "DNA", "text": "IL-2 promoter"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "NFATx1"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "NFATx2"}]}
