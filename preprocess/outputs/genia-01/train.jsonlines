{"tokens": ["In", "this", "report", ",", "we", "have", "analyzed", "the", "response", "of", "the", "hematopoietic", "precursor", "cell", "line", "32Dcl3", ",", "expressing", "either", "the", "normal", "protein", "MDS1/EVI1", "or", "the", "fusion", "protein", "AML1/MDS1/EVI1", ",", "to", "factors", "that", "control", "cell", "differentiation", "or", "cell", "replication", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-5", "entity_mentions": [{"start": 11, "end": 16, "entity_type": "cell_line", "text": "hematopoietic precursor cell line 32Dcl3"}, {"start": 22, "end": 23, "entity_type": "DNA", "text": "MDS1/EVI1"}, {"start": 20, "end": 23, "entity_type": "protein", "text": "normal protein MDS1/EVI1"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "AML1/MDS1/EVI1"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "fusion protein AML1/MDS1/EVI1"}]}
{"tokens": ["The", "32Dcl3", "cells", "are", "IL-3", "-dependent", "for", "growth", "and", "they", "differentiate", "into", "granulocytes", "when", "exposed", "to", "G-CSF", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-6", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "32Dcl3 cells"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "IL-3"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "G-CSF"}]}
{"tokens": ["They", "are", "growth-inhibited", "by", "TGF-beta1", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-7", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "TGF-beta1"}]}
{"tokens": ["We", "show", "that", "whereas", "the", "expression", "of", "MDS1/EVI1", "has", "no", "effect", "on", "granulocytic", "differentiation", "induced", "by", "G-CSF", ",", "expression", "of", "AML1/MDS1/EVI1", "blocks", "differentiation", "resulting", "in", "cell", "death", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-8", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "DNA", "text": "MDS1/EVI1"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "G-CSF"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "AML1/MDS1/EVI1"}]}
{"tokens": ["This", "effect", "is", "similar", "to", "that", "previously", "described", "by", "others", "for", "32Dcl3", "cells", "that", "express", "transgenic", "Evil", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-9", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "cell_line", "text": "32Dcl3 cells"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "transgenic Evil"}]}
{"tokens": ["Furthermore", ",", "we", "show", "that", "whereas", "the", "expression", "of", "the", "fusion", "protein", "AML1/MDS1/EVI1", "completely", "abrogates", "the", "growth-inhibitory", "effect", "of", "TGF-beta1", "and", "allows", "32Dcl3", "cells", "to", "proliferate", ",", "expression", "of", "the", "normal", "protein", "MDS1/EVI1", "has", "the", "opposite", "effect", ",", "and", "it", "strengthens", "the", "response", "of", "cells", "to", "the", "growth-inhibitory", "effect", "of", "TGF-beta1", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-10", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "AML1/MDS1/EVI1"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "TGF-beta1"}, {"start": 22, "end": 24, "entity_type": "cell_line", "text": "32Dcl3 cells"}, {"start": 32, "end": 33, "entity_type": "DNA", "text": "MDS1/EVI1"}, {"start": 50, "end": 51, "entity_type": "protein", "text": "TGF-beta1"}]}
{"tokens": ["By", "using", "the", "yeast", "two-hybrid", "system", ",", "we", "also", "show", "that", "EVI1", "(", "contained", "in", "its", "entirety", "in", "MDS1/EVI1", "and", "AML1/MDS1/EVI1", ")", "physically", "interacts", "with", "SMAD3", ",", "which", "is", "an", "intracellular", "mediator", "of", "TGF-beta1", "signaling", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-11", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "EVI1"}, {"start": 18, "end": 19, "entity_type": "DNA", "text": "MDS1/EVI1"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "AML1/MDS1/EVI1"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "SMAD3"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "TGF-beta1"}]}
{"tokens": ["Finally", ",", "we", "have", "correlated", "the", "response", "of", "the", "cells", "to", "G-CSF", "or", "TGF-beta1", "with", "the", "ability", "of", "the", "normal", "and", "fusion", "proteins", "to", "activate", "or", "repress", "promoters", "which", "they", "can", "directly", "regulate", "by", "binding", "to", "the", "promoter", "site", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-12", "entity_mentions": [{"start": 11, "end": 12, "entity_type": "protein", "text": "G-CSF"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "TGF-beta1"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "fusion proteins"}, {"start": 37, "end": 39, "entity_type": "DNA", "text": "promoter site"}]}
{"tokens": ["We", "propose", "that", "mutations", "of", "MDS1/EVI1", "either", "by", "gene", "truncation", "resulting", "in", "the", "transcription", "repressor", "EVI1", "or", "by", "gene", "fusion", "to", "AML1", "lead", "to", "an", "altered", "cellular", "response", "to", "growth", "and", "differentiation", "factors", "that", "could", "result", "in", "leukemic", "transformation", "."], "doc_id": "MEDLINE:99184529", "sent_id": "MEDLINE:99184529-13", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "MDS1/EVI1"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "EVI1"}, {"start": 13, "end": 16, "entity_type": "protein", "text": "transcription repressor EVI1"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "AML1"}, {"start": 31, "end": 33, "entity_type": "protein", "text": "differentiation factors"}]}
