{"tokens": ["A", "role", "for", "changes", "in", "immunophilins", ",", "causing", "glucocorticoid", "resistance", "in", "neotropical", "primates", ",", "is", "supported", "by", "the", "following", ":", "the", "changes", "in", "FKBP51", "and", "FKBP52", "were", "observed", "in", "cells", "from", "other", "neotropical", "primates", "with", "glucocorticoid", "resistance", ";", "the", "elevated", "level", "of", "FKBP51", "was", "reflected", "in", "an", "abundance", "of", "FKBP51", "in", "heat", "shock", "protein", "90", "complexes", "in", "SML", ";", "when", "cytosols", "of", "SML", "and", "L929", "cells", "were", "mixed", ",", "the", "decrease", "in", "GR", "binding", "was", "associated", "with", "incorporation", "of", "FKBP51", "into", "GR", "heterocomplexes", ";", "the", "effect", "of", "SML", "cytosol", "on", "GR", "binding", "was", "reproduced", "with", "cytosol", "from", "COS", "cells", "expressing", "squirrel", "monkey", "FKBP51", ";", "and", "both", "the", "effect", "of", "SML", "cytosol", "on", "GR", "binding", "and", "the", "incorporation", "of", "FKBP51", "into", "GR", "heterocomplexes", "were", "blocked", "by", "FK506", "."], "doc_id": "MEDLINE:99145033", "sent_id": "MEDLINE:99145033-6", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "immunophilins"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "FKBP51"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "FKBP52"}, {"start": 42, "end": 43, "entity_type": "protein", "text": "FKBP51"}, {"start": 49, "end": 50, "entity_type": "protein", "text": "FKBP51"}, {"start": 51, "end": 56, "entity_type": "protein", "text": "heat shock protein 90 complexes"}, {"start": 57, "end": 58, "entity_type": "cell_type", "text": "SML"}, {"start": 62, "end": 63, "entity_type": "cell_type", "text": "SML"}, {"start": 64, "end": 66, "entity_type": "cell_line", "text": "L929 cells"}, {"start": 79, "end": 80, "entity_type": "protein", "text": "FKBP51"}, {"start": 81, "end": 83, "entit