{"tokens": ["To", "this", "aim", ",", "allergen-specific", "CD4+", "T", "cell", "clones", "(", "TCC", ")", "were", "generated", "from", "the", "peripheral", "blood", "of", "three", "atopic", "patients", ",", "and", "their", "cytokine", "profiles", "were", "analyzed", "."], "doc_id": "MEDLINE:97064186", "sent_id": "MEDLINE:97064186-3", "entity_mentions": [{"start": 4, "end": 9, "entity_type": "cell_line", "text": "allergen-specific CD4+ T cell clones"}, {"start": 10, "end": 11, "entity_type": "cell_line", "text": "TCC"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "cytokine"}]}
