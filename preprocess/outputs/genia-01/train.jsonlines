{"tokens": ["Differences", "in", "phosphorylation", "of", "the", "IL-2R", "associated", "JAK/STAT", "proteins", "between", "HTLV-I(+)", ",", "IL-2-independent", "and", "IL-2-dependent", "cell", "lines", "and", "uncultured", "leukemic", "cells", "from", "patients", "with", "adult", "T-cell", "lymphoma/leukemia", "."], "doc_id": "MEDLINE:99244330", "sent_id": "MEDLINE:99244330-0", "entity_mentions": [{"start": 5, "end": 9, "entity_type": "protein", "text": "IL-2R associated JAK/STAT proteins"}, {"start": 18, "end": 21, "entity_type": "cell_type", "text": "uncultured leukemic cells"}]}
