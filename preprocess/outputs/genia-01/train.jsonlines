{"tokens": ["An", "alternative", "possibility", "is", "that", "in", "the", "absence", "of", "gamma(c)", ",", "the", "IL-4R", "alpha", "chain", "is", "able", "to", "transduce", "signals", "by", "homodimerization", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-3", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "gamma(c)"}, {"start": 12, "end": 15, "entity_type": "protein", "text": "IL-4R alpha chain"}]}
{"tokens": ["To", "test", "this", "latter", "possibility", ",", "a", "chimeric", "receptor", "containing", "the", "extracellular", "domain", "of", "c-kit", "(", "the", "stem", "cell", "factor", "(", "SCF", ")", "receptor", ")", "and", "the", "cytoplasmic", "and", "transmembrane", "domains", "of", "the", "IL-4R", "alpha", "chain", "was", "generated", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-4", "entity_mentions": [{"start": 7, "end": 9, "entity_type": "protein", "text": "chimeric receptor"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "extracellular domain"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "c-kit"}, {"start": 17, "end": 24, "entity_type": "protein", "text": "stem cell factor ( SCF ) receptor"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "IL-4R"}, {"start": 33, "end": 36, "entity_type": "protein", "text": "IL-4R alpha chain"}]}
{"tokens": ["Treatment", "of", "cells", "expressing", "the", "chimeric", "receptor", "kit/IL-4R", "alpha", "with", "SCF", "induces", "activation", "of", "the", "IL-4R", "alpha-associated", "kinase", "JAK-1", "and", "the", "transcription", "factor", "STAT6", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-5", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "chimeric receptor"}, {"start": 7, "end": 9, "entity_type": "protein", "text": "kit/IL-4R alpha"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "SCF"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IL-4R"}, {"start": 15, "end": 18, "entity_type": "protein", "text": "IL-4R alpha-associated kinase"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "JAK-1"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "transcription factor"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "STAT6"}]}
{"tokens": ["However", ",", "tyrosine", "phosphorylation", "of", "JAK-3", ",", "which", "associates", "with", "gamma(c)", ",", "is", "not", "induced", "by", "SCF", "in", "these", "cells", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-6", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "JAK-3"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "gamma(c)"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "SCF"}]}
{"tokens": ["SCF", "-mediated", "ligation", "of", "kit/IL-4R", "alpha", "is", "sufficient", "to", "elicit", "IL-4", "-specific", "gene", "expression", ",", "including", "up-regulation", "of", "CD23", "and", "synthesis", "of", "germ-line", "epsilon", "transcripts", "."], "doc_id": "MEDLINE:97334241", "sent_id": "MEDLINE:97334241-7", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "SCF"}, {"start": 4, "end": 6, "entity_type": "protein", "text": "kit/IL-4R alpha"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-4"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "CD23"}, {"start": 22, "end": 25, "entity_type": "RNA", "text": "germ-line epsilon transcripts"}]}
