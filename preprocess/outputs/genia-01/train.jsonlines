{"tokens": ["Within", "this", "DNA", "fragment", ",", "there", "were", "two", "novel", "9-bp", "motifs", "(", "-90/-82", "and", "-40/-32", ")", "with", "high", "homology", "to", "the", "nuclear", "factor-IL6", "(", "NF-IL6", ")", "binding", "site", "."], "doc_id": "MEDLINE:93268332", "sent_id": "MEDLINE:93268332-4", "entity_mentions": [{"start": 9, "end": 11, "entity_type": "DNA", "text": "9-bp motifs"}, {"start": 21, "end": 23, "entity_type": "protein", "text": "nuclear factor-IL6"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "NF-IL6"}, {"start": 21, "end": 28, "entity_type": "DNA", "text": "nuclear factor-IL6 ( NF-IL6 ) binding site"}]}
{"tokens": ["Site-directed", "mutagenesis", "demonstrated", "that", "the", "two", "NF-IL-6", "motifs", "could", "be", "independently", "activated", "by", "LAM", ",", "LPS", ",", "or", "TNF-alpha", "and", "that", "they", "acted", "in", "an", "orientation-independent", "manner", "."], "doc_id": "MEDLINE:93268332", "sent_id": "MEDLINE:93268332-5", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "DNA", "text": "NF-IL-6 motifs"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "TNF-alpha"}]}
