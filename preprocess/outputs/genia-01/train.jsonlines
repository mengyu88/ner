{"tokens": ["To", "elucidate", "the", "contributions", "of", "GATA-1", "to", "definitive", "hematopoiesis", "in", "vivo", ",", "we", "have", "examined", "adult", "mice", "that", "were", "rendered", "genetically", "defective", "in", "GATA-1", "synthesis", "(", "Takahashi", "et", "al", ",", "J", "Biol", "Chem", "272", ":", "12611", ",", "1997", ")", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-1", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "GATA-1"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "GATA-1"}]}
{"tokens": ["Because", "the", "GATA-1", "gene", "is", "located", "on", "the", "X", "chromosome", ",", "which", "is", "randomly", "inactivated", "in", "every", "cell", ",", "heterozygous", "females", "can", "bear", "either", "an", "active", "wild-type", "or", "mutant", "(", "referred", "to", "as", "GATA-1.05", ")", "GATA-1", "allele", ",", "consequently", "leading", "to", "variable", "anemic", "severity", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-2", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "GATA-1"}, {"start": 2, "end": 4, "entity_type": "DNA", "text": "GATA-1 gene"}, {"start": 8, "end": 10, "entity_type": "DNA", "text": "X chromosome"}, {"start": 33, "end": 34, "entity_type": "DNA", "text": "GATA-1.05"}, {"start": 35, "end": 36, "entity_type": "protein", "text": "GATA-1"}]}
{"tokens": ["These", "heterozygous", "mutant", "mice", "usually", "developed", "normally", ",", "but", "they", "began", "to", "die", "after", "5", "months", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-3", "entity_mentions": []}
{"tokens": ["These", "affected", "animals", "displayed", "marked", "splenomegaly", ",", "anemia", ",", "and", "thrombocytopenia", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-4", "entity_mentions": []}
{"tokens": ["Proerythroblasts", "and", "megakaryocytes", "massively", "accumulated", "in", "the", "spleens", "of", "the", "heterozygotes", ",", "and", "we", "showed", "that", "the", "neomycin", "resistance", "gene", "(", "which", "is", "the", "positive", "selection", "marker", "in", "ES", "cells", ")", "was", "expressed", "profusely", "in", "the", "abnormally", "abundant", "cells", "generated", "in", "the", "GATA-1.05", "mutant", "females", "."], "doc_id": "MEDLINE:98322148", "sent_id": "MEDLINE:98322148-5", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "cell_type", "text": "Proerythroblasts"}, {"start": 2, "end": 3, "entity_type": "cell_type", "text": "megakaryocytes"}, {"start": 17, "end": 20, "entity_type": "DNA", "text": "neomycin resistance gene"}, {"start": 28, "end": 30, "entity_type": "cell_type", "text": "ES cells"}, {"start": 42, "end": 43, "entity_type": "protein", "text": "GATA-1.05"}]}
