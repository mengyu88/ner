{"tokens": ["The", "association", "of", "specific", "HLA-DQ", "alleles", "with", "autoimmunity", "is", "correlated", "with", "discrete", "polymorphisms", "in", "the", "HLA-DQ", "sequence", "that", "are", "localized", "within", "sites", "suitable", "for", "peptide", "recognition", "."], "doc_id": "MEDLINE:96228347", "sent_id": "MEDLINE:96228347-1", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "DNA", "text": "HLA-DQ alleles"}, {"start": 15, "end": 17, "entity_type": "DNA", "text": "HLA-DQ sequence"}]}
{"tokens": ["The", "polymorphism", "at", "residue", "57", "of", "the", "DQB1", "polypeptide", "is", "of", "particular", "interest", "since", "it", "may", "play", "a", "major", "structural", "role", "in", "the", "formation", "of", "a", "salt", "bridge", "structure", "at", "one", "end", "of", "the", "peptide-binding", "cleft", "of", "the", "DQ", "molecules", "."], "doc_id": "MEDLINE:96228347", "sent_id": "MEDLINE:96228347-2", "entity_mentions": [{"start": 26, "end": 29, "entity_type": "protein", "text": "salt bridge structure"}, {"start": 34, "end": 36, "entity_type": "protein", "text": "peptide-binding cleft"}]}
{"tokens": ["This", "polymorphism", "at", "residue", "57", "is", "a", "recurrent", "feature", "of", "HLA-DQ", "evolution", ",", "occurring", "in", "multiple", "distinct", "allelic", "families", ",", "which", "implies", "a", "functional", "selection", "for", "maintaining", "variation", "at", "this", "position", "in", "the", "class", "II", "molecule", "."], "doc_id": "MEDLINE:96228347", "sent_id": "MEDLINE:96228347-3", "entity_mentions": [{"start": 33, "end": 36, "entity_type": "protein", "text": "class II molecule"}]}
{"tokens": ["We", "directly", "tested", "the", "amino", "acid", "polymorphism", "at", "this", "site", "as", "a", "determinant", "for", "peptide", "binding", "and", "for", "antigen-specific", "T", "cell", "stimulation", "."], "doc_id": "MEDLINE:96228347", "sent_id": "MEDLINE:96228347-4", "entity_mentions": []}
{"tokens": ["We", "found", "that", "a", "single", "Ala", "-->", "Asp", "amino", "acid", "57", "substitution", "in", "an", "HLA-DQ3.2", "molecule", "regulated", "binding", "of", "an", "HSV-2", "VP-16-derived", "peptide", "."], "doc_id": "MEDLINE:96228347", "sent_id": "MEDLINE:96228347-5", "entity_mentions": []}
