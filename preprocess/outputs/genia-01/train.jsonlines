{"tokens": ["To", "evaluate", "the", "physiologic", "plausibility", "of", "these", "claims", ",", "we", "compared", "the", "abundance", "of", "the", "VDR", "mRNA", "in", "peripheral", "blood", "mononuclear", "cells", "(", "PBMCs", ")", "between", "different", "VDR", "genotypes", "using", "a", "quantitative", "reverse", "transcribed", "polymerase", "chain", "reaction-based", "method", "."], "doc_id": "MEDLINE:97289433", "sent_id": "MEDLINE:97289433-2", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "RNA", "text": "VDR mRNA"}, {"start": 18, "end": 22, "entity_type": "cell_type", "text": "peripheral blood mononuclear cells"}, {"start": 23, "end": 24, "entity_type": "cell_type", "text": "PBMCs"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "VDR"}, {"start": 27, "end": 29, "entity_type": "protein", "text": "VDR genotypes"}]}
