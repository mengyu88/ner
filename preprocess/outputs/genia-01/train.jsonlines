{"tokens": ["Here", "we", "report", "the", "induction", "of", "the", "synthesis", "and", "of", "the", "hydrolytic", "activity", "of", "phospholipase", "C", "gamma", "1", "(", "PLC", "gamma", "1", ")", "in", "human", "T", "lymphocytes", "by", "IFN-beta", "."], "doc_id": "MEDLINE:97468093", "sent_id": "MEDLINE:97468093-3", "entity_mentions": [{"start": 14, "end": 18, "entity_type": "protein", "text": "phospholipase C gamma 1"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "PLC gamma 1"}, {"start": 24, "end": 27, "entity_type": "cell_type", "text": "human T lymphocytes"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "IFN-beta"}]}
{"tokens": ["The", "increased", "level", "of", "PLC", "gamma", "1", "becomes", "evident", "after", "90", "min", "of", "IFN-beta", "treatment", "and", "is", "still", "detectable", "after", "24", "h", "."], "doc_id": "MEDLINE:97468093", "sent_id": "MEDLINE:97468093-4", "entity_mentions": [{"start": 4, "end": 7, "entity_type": "protein", "text": "PLC gamma 1"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "IFN-beta"}]}
{"tokens": ["Neither", "the", "PLC", "gamma", "1", "overexpression", "induced", "by", "IFN", "nor", "the", "increased", "hydrolytic", "activity", "of", "the", "enzyme", "appear", "to", "be", "affected", "by", "pretreatment", "of", "the", "cells", "with", "the", "protein", "tyrosine", "kinase", "inhibitor", "genistein", ",", "which", "is", "known", "to", "prevent", "the", "association", "of", "ISGF3", "components", "."], "doc_id": "MEDLINE:97468093", "sent_id": "MEDLINE:97468093-5", "entity_mentions": [{"start": 2, "end": 5, "entity_type": "protein", "text": "PLC gamma 1"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IFN"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "enzyme"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "tyrosine kinase"}, {"start": 42, "end": 43, "entity_type": "protein", "text": "ISGF3"}]}
