{"tokens": ["In", "the", "present", "study", ",", "structure/function", "analyses", "of", "the", "IL-7R", "complex", "using", "a", "chimeric", "receptor", "system", "demonstrated", "that", "gamma(c)", "is", "indeed", "critical", "for", "IL-7R", "function", "."], "doc_id": "MEDLINE:97158624", "sent_id": "MEDLINE:97158624-6", "entity_mentions": [{"start": 9, "end": 11, "entity_type": "protein", "text": "IL-7R complex"}, {"start": 13, "end": 15, "entity_type": "protein", "text": "chimeric receptor"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "gamma(c)"}, {"start": 23, "end": 24, "entity_type": "protein", "text": "IL-7R"}]}
