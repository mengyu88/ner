{"tokens": ["To", "evaluate", "this", "possibility", ",", "we", "examined", "in", "vitro", "the", "effects", "of", "two", "types", "of", "antioxidant", "molecules", "in", "terms", "of", "inhibition", "of", "HIV", "replication", "in", "monocytes", ",", "one", "of", "the", "main", "reservoirs", "of", "HIV", ",", "and", "also", "in", "terms", "of", "modulation", "of", "the", "immune", "competence", "as", "measured", "by", "PBMC", "proliferation", "."], "doc_id": "MEDLINE:94347465", "sent_id": "MEDLINE:94347465-2", "entity_mentions": [{"start": 25, "end": 26, "entity_type": "cell_type", "text": "monocytes"}, {"start": 48, "end": 49, "entity_type": "cell_type", "text": "PBMC"}]}
{"tokens": ["We", "tested", "the", "effects", "of", "BHA", ",", "a", "phenolic", ",", "lipid-soluble", ",", "chain-breaking", "antioxidant", ",", "and", "NAC", ",", "a", "known", "glutathione", "precursor", "with", "some", "direct", "free-radical", "scavenging", "properties", "as", "well", ",", "on", "the", "regulation", "of", "HIV", "-1", "expression", "in", "latently", "infected", "U1", "cells", "and", "in", "productively", "and", "chronically", "infected", "U937", "cells", "."], "doc_id": "MEDLINE:94347465", "sent_id": "MEDLINE:94347465-3", "entity_mentions": [{"start": 41, "end": 43, "entity_type": "cell_line", "text": "U1 cells"}, {"start": 49, "end": 51, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["Both", "antioxidants", "inhibited", "TNF", "-", "or", "PMA-", "induced", "NF-kappa", "B", "activity", "in", "U1", "cells", ",", "as", "well", "as", "the", "sustained", "NF-kappa", "B", "activity", "permanently", "induced", "by", "the", "virus", "itself", "in", "chronically", "HIV", "-infected", "U937", "cells", "."], "doc_id": "MEDLINE:94347465", "sent_id": "MEDLINE:94347465-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "TNF"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 12, "end": 14, "entity_type": "cell_line", "text": "U1 cells"}, {"start": 20, "end": 22, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 33, "end": 35, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["This", "resulted", "in", "only", "a", "partial", "inhibition", "of", "TNF", "-", "or", "PMA-", "induced", "HIV", "replication", "in", "U1", "cells", ",", "and", "no", "detectable", "effect", "on", "HIV", "replication", "in", "chronically", "infected", "U937", "cells", "."], "doc_id": "MEDLINE:94347465", "sent_id": "MEDLINE:94347465-5", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "TNF"}, {"start": 16, "end": 18, "entity_type": "cell_line", "text": "U1 cells"}, {"start": 29, "end": 31, "entity_type": "cell_line", "text": "U937 cells"}, {"start": 27, "end": 31, "entity_type": "cell_line", "text": "chronically infected U937 cells"}]}
