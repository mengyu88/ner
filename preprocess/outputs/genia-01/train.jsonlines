{"tokens": ["We", "propose", "that", "Th1", "development", "can", "be", "considered", "in", "two", "stages", ",", "capacitance", "and", "development", "."], "doc_id": "MEDLINE:99187612", "sent_id": "MEDLINE:99187612-4", "entity_mentions": []}
