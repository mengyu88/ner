{"tokens": ["Defective", "survival", "and", "activation", "of", "thymocytes", "in", "transgenic", "mice", "expressing", "a", "catalytically", "inactive", "form", "of", "Ca2+/calmodulin-dependent", "protein", "kinase", "IV", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-0", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "catalytically inactive form"}, {"start": 15, "end": 19, "entity_type": "protein", "text": "Ca2+/calmodulin-dependent protein kinase IV"}]}
{"tokens": ["We", "have", "generated", "transgenic", "mice", "that", "express", "a", "catalytically", "inactive", "form", "of", "Ca2+/calmodulin-dependent", "protein", "kinase", "IV", "(", "CaMKIV", ")", "specifically", "in", "thymic", "T", "cells", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-1", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "protein", "text": "catalytically inactive form"}, {"start": 12, "end": 16, "entity_type": "protein", "text": "Ca2+/calmodulin-dependent protein kinase IV"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "CaMKIV"}, {"start": 21, "end": 24, "entity_type": "cell_type", "text": "thymic T cells"}]}
{"tokens": ["The", "presence", "of", "this", "protein", "results", "in", "a", "markedly", "reduced", "thymic", "cellularity", ",", "although", "the", "distribution", "of", "the", "remaining", "cells", "is", "normal", "based", "on", "evaluation", "of", "the", "CD4", "and", "CD8", "cell", "surface", "antigens", "that", "are", "used", "to", "gauge", "T", "cell", "development", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-2", "entity_mentions": [{"start": 27, "end": 28, "entity_type": "protein", "text": "CD4"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "CD8"}, {"start": 30, "end": 33, "entity_type": "protein", "text": "cell surface antigens"}]}
{"tokens": ["Isolated", "thymic", "T", "cells", "from", "the", "transgenic", "mice", "also", "show", "a", "dramatically", "decreased", "survival", "rate", "when", "evaluated", "in", "culture", "under", "conditions", "that", "do", "not", "favor", "activation", "."], "doc_id": "MEDLINE:97315062", "sent_id": "MEDLINE:97315062-3", "entity_mentions": [{"start": 1, "end": 4, "entity_type": "cell_type", "text": "thymic T cells"}]}
