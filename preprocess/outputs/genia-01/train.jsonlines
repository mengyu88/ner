{"tokens": ["SOCS-3", "protein", "was", "detectable", "as", "early", "as", "30", "min", "following", "IL-2", "stimulation", ",", "while", "CIS", "was", "seen", "only", "at", "low", "levels", "after", "2", "h", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "SOCS-3"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IL-2"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "CIS"}]}
