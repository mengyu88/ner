{"tokens": ["We", "now", "show", "that", "IL-2", "regulation", "of", "STAT3", "proteins", "in", "T", "cells", "is", "a", "complex", "response", "involving", "activation", "of", "two", "forms", "of", "STAT3", ":", "90-kDa", "STAT3alpha", "and", "an", "83-kDa", "carboxyl-terminal", "truncated", "STAT3beta", "."], "doc_id": "MEDLINE:97450986", "sent_id": "MEDLINE:97450986-3", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "IL-2"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "STAT3"}, {"start": 7, "end": 9, "entity_type": "protein", "text": "STAT3 proteins"}, {"start": 10, "end": 12, "entity_type": "cell_type", "text": "T cells"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "STAT3"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "STAT3alpha"}, {"start": 31, "end": 32, "entity_type": "protein", "text": "STAT3beta"}, {"start": 28, "end": 32, "entity_type": "protein", "text": "83-kDa carboxyl-terminal truncated STAT3beta"}]}
{"tokens": ["The", "phosphorylation", "of", "STAT", "proteins", "on", "serine", "residues", "is", "also", "required", "for", "competent", "STAT", "transcription", "."], "doc_id": "MEDLINE:97450986", "sent_id": "MEDLINE:97450986-4", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "STAT proteins"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "STAT"}]}
