{"tokens": ["To", "test", "this", "hypothesis", ",", "we", "have", "been", "interested", "to", "determine", "which", ",", "if", "any", ",", "cell", "cycle", "entry", "events", "are", "affected", "by", "oxidative", "signalling", "."], "doc_id": "MEDLINE:97214626", "sent_id": "MEDLINE:97214626-2", "entity_mentions": []}
