{"tokens": ["The", "B", "cell", "NFAT", "complex", ",", "however", ",", "was", "not", "functional", ",", "since", "it", "failed", "to", "activate", "transcription", "from", "an", "NFAT", "-driven", "chloramphenicol", "acetyltransferase", "(", "CAT", ")", "construct", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-3", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "NFAT"}, {"start": 3, "end": 5, "entity_type": "protein", "text": "NFAT complex"}, {"start": 1, "end": 5, "entity_type": "protein", "text": "B cell NFAT complex"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "NFAT"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "chloramphenicol acetyltransferase"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "CAT"}, {"start": 20, "end": 28, "entity_type": "DNA", "text": "NFAT -driven chloramphenicol acetyltransferase ( CAT ) construct"}]}
{"tokens": ["Competition", "with", "an", "AP-1", "motif", "or", "with", "anti-Jun", "and", "anti-Fos", "antibodies", "abolished", "binding", "to", "the", "NFAT", "motif", "in", "both", "T", "and", "B", "cells", ",", "indicating", "that", "Jun", "and", "Fos", "are", "critical", "for", "NFAT", "complex", "formation", "in", "both", "cell", "types", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-4", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "DNA", "text": "AP-1 motif"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "anti-Jun"}, {"start": 9, "end": 11, "entity_type": "protein", "text": "anti-Fos antibodies"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "NFAT"}, {"start": 15, "end": 17, "entity_type": "DNA", "text": "NFAT motif"}, {"start": 32, "end": 33, "entity_type": "protein", "text": "NFAT"}, {"start": 32, "end": 34, "entity_type": "protein", "text": "NFAT complex"}]}
{"tokens": ["Purified", "recombinant", "Jun", "and", "Fos", "proteins", "failed", "to", "bind", "directly", "to", "the", "NFAT", "motif", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-5", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "NFAT"}, {"start": 12, "end": 14, "entity_type": "DNA", "text": "NFAT motif"}]}
{"tokens": ["However", ",", "when", "combined", "with", "unstimulated", "B", "or", "T", "cell", "extracts", ",", "full-length", ",", "but", "not", "truncated", ",", "Jun/Fos", "heterodimers", "were", "able", "to", "form", "an", "NFAT", "complex", ",", "indicating", "the", "presence", "of", "a", "constitutively", "expressed", "nuclear", "factor", "(", "s", ")", "in", "B", "and", "T", "cells", "necessary", "for", "the", "formation", "of", "the", "NFAT", "complex", "in", "both", "cell", "types", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-6", "entity_mentions": [{"start": 25, "end": 26, "entity_type": "protein", "text": "NFAT"}, {"start": 25, "end": 27, "entity_type": "protein", "text": "NFAT complex"}, {"start": 33, "end": 37, "entity_type": "protein", "text": "constitutively expressed nuclear factor"}, {"start": 51, "end": 52, "entity_type": "protein", "text": "NFAT"}, {"start": 51, "end": 53, "entity_type": "protein", "text": "NFAT complex"}]}
{"tokens": ["An", "NFAT", "oligonucleotide", "carrying", "mutations", "in", "the", "5'", "purine-rich", "part", "of", "the", "NFAT", "sequence", "failed", "to", "form", "a", "complex", "and", "to", "compete", "with", "the", "wild", "type", "motif", "for", "NFAT", "complex", "formation", "in", "both", "T", "and", "B", "cells", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-7", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "NFAT"}, {"start": 7, "end": 10, "entity_type": "DNA", "text": "5' purine-rich part"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "NFAT"}, {"start": 12, "end": 14, "entity_type": "DNA", "text": "NFAT sequence"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "NFAT"}, {"start": 28, "end": 30, "entity_type": "protein", "text": "NFAT complex"}]}
{"tokens": ["We", "therefore", "propose", "a", "model", "whereby", "a", "core", "NFAT", "complex", "consisting", "of", "Jun", ",", "Fos", ",", "and", "a", "constitutive", "nuclear", "factor", "is", "formed", "in", "both", "T", "and", "B", "cells", ",", "but", "an", "additional", "factor", "and/or", "post-translational", "modification", "of", "a", "factor", ",", "missing", "in", "B", "cells", ",", "might", "be", "required", "for", "transactivation", "by", "NFAT", "."], "doc_id": "MEDLINE:93300824", "sent_id": "MEDLINE:93300824-8", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "NFAT"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "NFAT complex"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "Jun"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "Fos"}, {"start": 18, "end": 21, "entity_type": "protein", "text": "constitutive nuclear factor"}, {"start": 43, "end": 45, "entity_type": "cell_type", "text": "B cells"}, {"start": 52, "end": 53, "entity_type": "protein", "text": "NFAT"}]}
{"tokens": ["Differential", "autoregulation", "of", "glucocorticoid", "receptor", "expression", "in", "human", "T-", "and", "B-", "cell", "lines", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-0", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "protein", "text": "glucocorticoid receptor"}]}
{"tokens": ["Regulation", "of", "glucocorticoid", "receptor", "(", "GR", ")", "expression", "by", "its", "cognate", "ligand", "was", "examined", "in", "the", "glucocorticoid-sensitive", "human", "leukemic", "T-cell", "line", "6TG1.1", "and", "in", "the", "human", "B-cell", "line", "IM-9", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-1", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 16, "end": 22, "entity_type": "cell_line", "text": "glucocorticoid-sensitive human leukemic T-cell line 6TG1.1"}, {"start": 25, "end": 29, "entity_type": "cell_line", "text": "human B-cell line IM-9"}]}
{"tokens": ["In", "contrast", "to", "the", "decrease", "in", "GR", "mRNA", "seen", "in", "IM-9", "cells", "after", "treatment", "with", "1", "microM", "dexamethasone", "for", "16-18", "h", ",", "treatment", "of", "6TG1.1", "cells", "resulted", "in", "an", "8-fold", "increase", "in", "GR", "mRNA", ",", "as", "determined", "by", "Northern", "blot", "and", "RNase", "protection", "analysis", ",", "with", "a", "corresponding", "3-", "to", "4-fold", "increase", "in", "GR", "protein", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-2", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "RNA", "text": "GR mRNA"}, {"start": 10, "end": 12, "entity_type": "cell_line", "text": "IM-9 cells"}, {"start": 24, "end": 26, "entity_type": "cell_line", "text": "6TG1.1 cells"}, {"start": 32, "end": 34, "entity_type": "RNA", "text": "GR mRNA"}, {"start": 41, "end": 42, "entity_type": "protein", "text": "RNase"}, {"start": 53, "end": 55, "entity_type": "protein", "text": "GR protein"}]}
{"tokens": ["Half-maximal", "induction", "of", "GR", "mRNA", "and", "protein", "in", "6TG1.1", "cells", "was", "observed", "between", "10-100", "nM", "dexamethasone", ",", "and", "inclusion", "of", "1", "microM", "RU", "38486", "completely", "blocked", "the", "effects", "of", "100", "nM", "dexamethasone", ",", "demonstrating", "that", "positive", "autoregulation", "of", "GR", "expression", "in", "6TG1.1", "cells", "is", "a", "receptor-mediated", "response", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-3", "entity_mentions": [{"start": 3, "end": 5, "entity_type": "RNA", "text": "GR mRNA"}, {"start": 8, "end": 10, "entity_type": "cell_line", "text": "6TG1.1 cells"}, {"start": 38, "end": 39, "entity_type": "protein", "text": "GR"}, {"start": 41, "end": 43, "entity_type": "cell_line", "text": "6TG1.1 cells"}]}
{"tokens": ["Positive", "autoregulation", "of", "GR", "expression", "was", "also", "observed", "in", "glucocorticoid-resistant", "CEM-C1", "cells", ",", "which", "contain", "functional", "GR", ",", "but", "whose", "growth", "is", "unaffected", "by", "glucocorticoids", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-4", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "GR"}, {"start": 9, "end": 12, "entity_type": "cell_line", "text": "glucocorticoid-resistant CEM-C1 cells"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "GR"}]}
{"tokens": ["Thus", ",", "positive", "autoregulation", "is", "neither", "a", "consequence", "nor", "the", "sole", "cause", "of", "growth", "arrest", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-5", "entity_mentions": []}
{"tokens": ["The", "degree", "of", "negative", "autoregulation", "in", "IM-9", "cells", "and", "positive", "autoregulation", "in", "6TG1.1", "cells", "was", "unaffected", "by", "inhibition", "of", "protein", "synthesis", "with", "cycloheximide", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-6", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "cell_line", "text": "IM-9 cells"}, {"start": 12, "end": 14, "entity_type": "cell_line", "text": "6TG1.1 cells"}]}
{"tokens": ["Measurement", "of", "GR", "mRNA", "turnover", "in", "6TG1.1", "cells", "treated", "with", "actinomycin-D", "revealed", "a", "half-life", "of", "2.5", "h", ",", "which", "was", "unaffected", "by", "dexamethasone", "treatment", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-7", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "RNA", "text": "GR mRNA"}, {"start": 6, "end": 8, "entity_type": "cell_line", "text": "6TG1.1 cells"}]}
{"tokens": ["A", "similar", "half-life", "was", "determined", "in", "IM-9", "cells", "and", "was", "also", "unaffected", "by", "steroid", "treatment", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-8", "entity_mentions": [{"start": 6, "end": 8, "entity_type": "cell_line", "text": "IM-9 cells"}]}
{"tokens": ["These", "results", "are", "consistent", "with", "the", "interpretation", "that", "glucocorticoid", "-mediated", "autoregulation", "of", "GR", "expression", "is", "a", "tissue-specific", "primary", "transcriptional", "response", "."], "doc_id": "MEDLINE:93307152", "sent_id": "MEDLINE:93307152-9", "entity_mentions": []}
{"tokens": ["Induction", "of", "CD8", "antigen", "and", "suppressor", "activity", "by", "glucocorticoids", "in", "a", "CEM", "human", "leukemic", "cell", "clone", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-0", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "protein", "text": "CD8 antigen"}, {"start": 11, "end": 16, "entity_type": "cell_line", "text": "CEM human leukemic cell clone"}]}
{"tokens": ["The", "relationship", "between", "glucocorticoid", "effect", "and", "regulation", "of", "cell", "surface", "antigens", "was", "investigated", "in", "two", "models", "of", "leukemic", "cell", "lines", ",", "CEM", "C7", "denoted", "(", "r+", ",", "ly+", ")", "and", "CEM", "C1", "(", "r+", ",", "ly-", ")", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-1", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "protein", "text": "cell surface antigens"}, {"start": 17, "end": 20, "entity_type": "cell_line", "text": "leukemic cell lines"}, {"start": 21, "end": 23, "entity_type": "cell_line", "text": "CEM C7"}, {"start": 30, "end": 32, "entity_type": "cell_line", "text": "CEM C1"}]}
{"tokens": ["The", "reactivity", "of", "murine", "monoclonal", "antibodies", ",", "anti-CD4-FITC", ",", "anti-CD8-FITC", ",", "anti-CD2-FITC", "and", "anti-calla-FITC", ",", "were", "analyzed", "using", "flow", "cytometry", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-2", "entity_mentions": [{"start": 3, "end": 6, "entity_type": "protein", "text": "murine monoclonal antibodies"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "anti-CD4-FITC"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "anti-CD8-FITC"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "anti-CD2-FITC"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "anti-calla-FITC"}]}
{"tokens": ["The", "suppressor", "function", "was", "determined", "using", "[3H]thymidine", "incorporation", "into", "phytohemagglutinin", "-activated", "peripheral", "blood", "lymphocytes", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-3", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "phytohemagglutinin"}, {"start": 9, "end": 14, "entity_type": "cell_line", "text": "phytohemagglutinin -activated peripheral blood lymphocytes"}]}
{"tokens": ["Dexamethasone", "treatment", "of", "a", "human", "leukemic", "cell", "clone", "CEM", "C7", "caused", "an", "increase", "in", "a", "subset", "of", "cells", "expressing", "the", "surface", "antigen", "CD8", ",", "which", "is", "present", "on", "suppressor", "and", "cytotoxic", "T-lymphocytes", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-4", "entity_mentions": [{"start": 4, "end": 10, "entity_type": "cell_line", "text": "human leukemic cell clone CEM C7"}, {"start": 20, "end": 23, "entity_type": "protein", "text": "surface antigen CD8"}, {"start": 30, "end": 32, "entity_type": "cell_type", "text": "cytotoxic T-lymphocytes"}]}
{"tokens": ["By", "comparison", ",", "there", "was", "no", "modification", "of", "the", "expression", "of", "CD4", "antigen", ",", "which", "is", "expressed", "at", "high", "levels", "in", "these", "cells", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-5", "entity_mentions": [{"start": 11, "end": 13, "entity_type": "protein", "text": "CD4 antigen"}]}
{"tokens": ["After", "two", "days", "of", "treatment", "with", "5", "x", "10", "(", "-8", ")", "M", "dexamethasone", ",", "CEM", "C7", "cells", "showed", "a", "two-fold", "increase", "in", "suppressor", "activity", "compared", "to", "untreated", "cells", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-6", "entity_mentions": [{"start": 15, "end": 18, "entity_type": "cell_line", "text": "CEM C7 cells"}]}
{"tokens": ["In", "contrast", ",", "there", "was", "no", "regulation", "by", "glucocorticoids", "of", "either", "the", "CD8", "or", "CD4", "antigens", "in", "the", "leukemic", "clone", "CEM", "C1", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-7", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "CD8"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "CD4 antigens"}, {"start": 18, "end": 22, "entity_type": "cell_line", "text": "leukemic clone CEM C1"}]}
{"tokens": ["Furthermore", ",", "no", "modification", "of", "the", "suppressor", "function", "in", "CEM", "C1", "cells", "by", "dexamethasone", "was", "observed", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-8", "entity_mentions": [{"start": 9, "end": 12, "entity_type": "cell_line", "text": "CEM C1 cells"}]}
{"tokens": ["In", "the", "human", "leukemic", "cells", "studied", "here", ",", "the", "ability", "to", "induce", "CD8", "antigen", "expression", "in", "a", "CD4+", "cells", "correlates", "with", "the", "ability", "to", "induce", "cell", "lysis", "in", "a", "glucocorticoid", "receptor", "positive", "cell", "population", "."], "doc_id": "MEDLINE:93280865", "sent_id": "MEDLINE:93280865-9", "entity_mentions": [{"start": 12, "end": 14, "entity_type": "protein", "text": "CD8 antigen"}, {"start": 17, "end": 19, "entity_type": "cell_line", "text": "CD4+ cells"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 29, "end": 34, "entity_type": "cell_line", "text": "glucocorticoid receptor positive cell population"}]}
{"tokens": ["Adenovirus", "E1A", "inhibits", "IFN", "-induced", "resistance", "to", "cytolysis", "by", "natural", "killer", "cells", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-0", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "IFN"}, {"start": 9, "end": 12, "entity_type": "cell_type", "text": "natural killer cells"}]}
{"tokens": ["Infection", "of", "target", "cells", "with", "cytopathic", "viruses", "inhibits", "IFN", "induction", "of", "cytolytic", "resistance", "to", "NK", "cell-mediated", "cytolysis", "[", "IFN", "-mediated", "cytoprotection", "(", "IFN", "-MCP", ")", "]", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-1", "entity_mentions": [{"start": 2, "end": 4, "entity_type": "cell_type", "text": "target cells"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IFN"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "IFN"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "IFN"}]}
{"tokens": ["It", "has", "been", "thought", "that", "the", "virally", "induced", "inhibition", "of", "IFN", "-MCP", "is", "secondary", "to", "the", "shutdown", "of", "cellular", "macromolecular", "synthesis", "that", "accompanies", "cytopathic", "virus", "infections", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-2", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "IFN"}]}
{"tokens": ["Group", "C", ",", "adenovirus", "serotype", "5", "(", "Ad5", ")", "infection", "inhibits", "both", "IFN", "-MCP", "and", "cellular", "protein", "synthesis", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-3", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "IFN"}, {"start": 15, "end": 17, "entity_type": "protein", "text": "cellular protein"}]}
{"tokens": ["This", "study", "determined", "if", "the", "Ad5-induced", "inhibition", "of", "IFN", "-MCP", "was", "independent", "of", "adenovirus", "(", "Ad", ")", "infection", "and", "secondary", "only", "to", "the", "expression", "of", "the", "Ad", "early", "region", "1A", "gene", "(", "E1A", ")", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-4", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "IFN"}, {"start": 26, "end": 31, "entity_type": "DNA", "text": "Ad early region 1A gene"}, {"start": 32, "end": 33, "entity_type": "DNA", "text": "E1A"}]}
{"tokens": ["To", "test", "this", "hypothesis", ",", "4-h", "NK", "cytolysis", "assays", "were", "performed", "on", "IFN-gamma-treated", "human", "cells", "infected", "with", "an", "Ad5", "E1A", "deletion", "mutant", ",", "dl343", ",", "or", "transfected", "with", "the", "Ad5", "E1A", "gene", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-5", "entity_mentions": [{"start": 12, "end": 15, "entity_type": "cell_line", "text": "IFN-gamma-treated human cells"}, {"start": 19, "end": 20, "entity_type": "DNA", "text": "E1A"}, {"start": 30, "end": 31, "entity_type": "DNA", "text": "E1A"}, {"start": 29, "end": 32, "entity_type": "DNA", "text": "Ad5 E1A gene"}]}
{"tokens": ["IFN", "-MCP", "was", "not", "inhibited", "by", "infection", "with", "dl343", ",", "despite", "the", "production", "of", "large", "amounts", "of", "both", "early", "(", "E1B", ",", "p55", ")", "and", "late", "(", "hexon", ")", "Ad", "proteins", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-6", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "IFN"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "E1B"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "p55"}, {"start": 27, "end": 28, "entity_type": "protein", "text": "hexon"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "Ad proteins"}]}
{"tokens": ["In", "contrast", "to", "E1A", "-negative", ",", "parental", "cell", "lines", ",", "IFN", "-MCP", "was", "blocked", "in", "Ad5", "E1A", "-transfected", "epithelial", "and", "fibroblastic", "cell", "lines", "."], "doc_id": "MEDLINE:93246644", "sent_id": "MEDLINE:93246644-7", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "DNA", "text": "E1A"}, {"start": 3, "end": 9, "entity_type": "cell_line", "text": "E1A -negative , parental cell lines"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "IFN"}, {"start": 16, "end": 17, "entity_type": "DNA", "text": "E1A"}, {"start": 16, "end": 19, "entity_type": "cell_line", "text": "E1A -transfected epithelial"}, {"start": 20, "end": 23, "entity_type": "cell_line", "text": "fibroblastic cell lines"}]}
