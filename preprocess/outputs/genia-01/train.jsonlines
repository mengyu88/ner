{"tokens": ["The", "aim", "of", "the", "present", "study", "was", "to", "compare", "the", "expression", "of", "mRNA", "for", "glucocorticoid", "receptor", "in", "human", "blood", "monocytes", "obtained", "from", "seven", "unstable", "untreated", "asthmatic", "patients", "who", "were", "subsequently", "treated", "with", "high", "doses", "of", "parenteral", "corticosteroid", "(", "methyl", "prednisolone", "120", "mg/day", ")", "for", "10", "days", "."], "doc_id": "MEDLINE:96152682", "sent_id": "MEDLINE:96152682-3", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "RNA", "text": "mRNA"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 17, "end": 20, "entity_type": "cell_type", "text": "human blood monocytes"}]}
{"tokens": ["mRNA", "expression", "was", "identified", "after", "RNA", "extraction", "using", "RNAzol", "and", "analysed", "after", "reverse", "transcriptase", ",", "by", "polymerase", "chain", "reaction", "using", "a", "semiquantitative", "competitive", "hybridization", "assay", "."], "doc_id": "MEDLINE:96152682", "sent_id": "MEDLINE:96152682-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "RNA", "text": "mRNA"}, {"start": 12, "end": 14, "entity_type": "protein", "text": "reverse transcriptase"}]}
{"tokens": ["All", "asthmatic", "patients", "showed", "an", "improvement", "in", "their", "FEV1", "values", "after", "corticosteroid", "treatment", "(", "per", "cent", "of", "predicted", "value", "68.28", "+/-", "4.93", "versus", "95.57", "+/-", "6.41", ",", "P", "<", "0.02", ")", ",", "and", "a", "significant", "decrease", "for", "glucocorticoid", "receptor", "mRNA", "expression", "(", "P", "<", "0.02", ")", "was", "observed", "in", "their", "monocytes", "."], "doc_id": "MEDLINE:96152682", "sent_id": "MEDLINE:96152682-5", "entity_mentions": [{"start": 37, "end": 39, "entity_type": "protein", "text": "glucocorticoid receptor"}, {"start": 39, "end": 40, "entity_type": "RNA", "text": "mRNA"}]}
