{"tokens": ["Histamine", "transiently", "increased", "cAMP", "and", "c-fos", "expression", "through", "H2", "receptors", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-2", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "DNA", "text": "c-fos"}, {"start": 8, "end": 10, "entity_type": "protein", "text": "H2 receptors"}]}
{"tokens": ["Dibutyryl", "cAMP", "also", "increased", "c-fos", "mRNA", "and", "protein", ",", "and", "levels", "remained", "elevated", "even", "after", "12", "hr", "of", "treatment", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-3", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "DNA", "text": "c-fos"}, {"start": 4, "end": 6, "entity_type": "RNA", "text": "c-fos mRNA"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "protein"}]}
{"tokens": ["Dose-dependence", "studies", "using", "histamine", "and", "dimaprit", "showed", "that", "the", "EC50", "values", "for", "cAMP", "production", "and", "c-fos", "increase", "were", "similar", ",", "suggesting", "that", "cAMP", "might", "be", "involved", "in", "c-fos", "induction", "via", "H2", "receptors", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-4", "entity_mentions": [{"start": 15, "end": 16, "entity_type": "DNA", "text": "c-fos"}, {"start": 27, "end": 28, "entity_type": "DNA", "text": "c-fos"}, {"start": 30, "end": 32, "entity_type": "protein", "text": "H2 receptors"}]}
{"tokens": ["Furthermore", ",", "studies", "carried", "out", "using", "H7", ",", "a", "protein", "kinase", "A", "/protein", "kinase", "C", "inhibitor", ",", "blocked", "c-fos", "induction", ",", "whereas", "no", "effect", "was", "observed", "with", "bisindolylmaleimide", ",", "a", "specific", "protein", "kinase", "C", "inhibitor", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-5", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "H7"}, {"start": 9, "end": 12, "entity_type": "protein", "text": "protein kinase A"}, {"start": 12, "end": 15, "entity_type": "protein", "text": "/protein kinase C"}, {"start": 9, "end": 16, "entity_type": "protein", "text": "protein kinase A /protein kinase C inhibitor"}, {"start": 18, "end": 19, "entity_type": "DNA", "text": "c-fos"}, {"start": 31, "end": 34, "entity_type": "protein", "text": "protein kinase C"}]}
