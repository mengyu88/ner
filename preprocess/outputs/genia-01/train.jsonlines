{"tokens": ["Previously", "we", "reported", "that", "3-deazaadenosine", "(", "DZA", ")", ",", "a", "potent", "inhibitor", "and", "substrate", "for", "S-adenosylhomocysteine", "hydrolase", "inhibits", "bacterial", "lipopolysaccharide-induced", "transcription", "of", "tumor", "necrosis", "factor-alpha", "and", "interleukin-1beta", "in", "mouse", "macrophage", "RAW", "264.7", "cells", "."], "doc_id": "MEDLINE:99315834", "sent_id": "MEDLINE:99315834-2", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "protein", "text": "S-adenosylhomocysteine hydrolase"}, {"start": 22, "end": 25, "entity_type": "protein", "text": "tumor necrosis factor-alpha"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "interleukin-1beta"}, {"start": 28, "end": 33, "entity_type": "cell_line", "text": "mouse macrophage RAW 264.7 cells"}]}
