{"tokens": ["The", "present", "study", "examines", "the", "mechanisms", "involved", "in", "LPS", "-mediated", "induction", "of", "HIV", "expression", "in", "U1", "cells", ",", "a", "promonocytic", "cell", "line", "chronically", "infected", "with", "HIV", "."], "doc_id": "MEDLINE:96194562", "sent_id": "MEDLINE:96194562-3", "entity_mentions": [{"start": 15, "end": 17, "entity_type": "cell_line", "text": "U1 cells"}, {"start": 19, "end": 22, "entity_type": "cell_line", "text": "promonocytic cell line"}]}
