{"tokens": ["Transient", "transfection", "studies", "in", "HeLa", "cells", ",", "an", "E", "(", "2", ")", "receptor-negative", "line", ",", "suggest", "that", "E", "(", "2", ")", "inhibits", "TNF", "gene", "expression", "through", "an", "effect", "mediated", "by", "estrogen", "receptor", "beta", "(", "ERbeta", ")", "."], "doc_id": "MEDLINE:99380273", "sent_id": "MEDLINE:99380273-3", "entity_mentions": [{"start": 4, "end": 6, "entity_type": "cell_line", "text": "HeLa cells"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "TNF"}, {"start": 30, "end": 33, "entity_type": "protein", "text": "estrogen receptor beta"}, {"start": 34, "end": 35, "entity_type": "protein", "text": "ERbeta"}]}
{"tokens": ["We", "also", "report", "that", "in", "RAW", "264.7", "cells", ",", "an", "E", "(", "2", ")", "receptor-positive", "murine", "monocytic", "line", ",", "E", "(", "2", ")", "downregulates", "cytokine-induced", "TNF", "gene", "expression", "by", "decreasing", "the", "activity", "of", "the", "Jun", "NH(2)-terminal", "kinase", "(", "JNK", ")", "."], "doc_id": "MEDLINE:99380273", "sent_id": "MEDLINE:99380273-4", "entity_mentions": [{"start": 5, "end": 8, "entity_type": "cell_line", "text": "RAW 264.7 cells"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "TNF"}, {"start": 34, "end": 37, "entity_type": "protein", "text": "Jun NH(2)-terminal kinase"}, {"start": 38, "end": 39, "entity_type": "protein", "text": "JNK"}]}
{"tokens": ["The", "resulting", "diminished", "phosphorylation", "of", "c-Jun", "and", "JunD", "at", "their", "NH(2)-termini", "decreases", "the", "ability", "of", "these", "nuclear", "proteins", "to", "autostimulate", "the", "expression", "of", "the", "c-Jun", "and", "JunD", "genes", ",", "thus", "leading", "to", "lower", "production", "of", "c-Jun", "and", "JunD", "."], "doc_id": "MEDLINE:99380273", "sent_id": "MEDLINE:99380273-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "c-Jun"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "JunD"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "NH(2)-termini"}, {"start": 35, "end": 36, "entity_type": "protein", "text": "c-Jun"}, {"start": 37, "end": 38, "entity_type": "protein", "text": "JunD"}]}
{"tokens": ["The", "consequent", "decrease", "in", "the", "nuclear", "levels", "of", "c-Jun", "and", "JunD", "leads", "to", "diminished", "binding", "of", "c-Jun", "/c-Fos", "and", "JunD", "/c-Fos", "heterodimers", "to", "the", "AP-1", "consensus", "sequence", "in", "the", "TNF", "promoter", "and", ",", "thus", ",", "to", "decreased", "transactivation", "of", "the", "TNF", "gene", "."], "doc_id": "MEDLINE:99380273", "sent_id": "MEDLINE:99380273-6", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "c-Jun"}, {"start": 10, "end": 11, "entity_type": "protein", "text": "JunD"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "c-Jun"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "c-Jun /c-Fos"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "JunD"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "JunD /c-Fos heterodimers"}, {"start": 24, "end": 27, "entity_type": "DNA", "text": "AP-1 consensus sequence"}, {"start": 29, "end": 30, "entity_type": "protein", "text": "TNF"}, {"start": 29, "end": 31, "entity_type": "DNA", "text": "TNF promoter"}, {"start": 40, "end": 41, "entity_type": "protein", "text": "TNF"}, {"start": 40, "end": 42, "entity_type": "DNA", "text": "TNF gene"}]}
