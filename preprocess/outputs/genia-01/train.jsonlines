{"tokens": ["Nevertheless", ",", "dibutyryl", "cAMP", "induced", "a", "down-regulation", "of", "the", "levels", "of", "this", "proto-oncogene", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-7", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "DNA", "text": "proto-oncogene"}]}
{"tokens": ["In", "addition", ",", "dibutyryl", "cAMP", "inhibited", "cell", "growth", "in", "a", "dose-dependent", "manner", ",", "whereas", "histamine", "failed", "to", "affect", "proliferation", "and", "differentiation", "of", "U937", "cells", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-8", "entity_mentions": [{"start": 22, "end": 24, "entity_type": "cell_line", "text": "U937 cells"}]}
{"tokens": ["Cells", "pretreated", "with", "dimaprit", "showed", "a", "decrease", "in", "the", "cAMP", "response", "to", "subsequent", "addition", "of", "H2", "agonists", ",", "whereas", "the", "cAMP", "response", "to", "prostaglandin", "E2", "remained", "unaltered", "."], "doc_id": "MEDLINE:97330829", "sent_id": "MEDLINE:97330829-9", "entity_mentions": []}
