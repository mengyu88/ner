{"tokens": ["Here", ",", "we", "show", "that", "CD3", "ligation", "by", "mAb", "and", "Staphylococcal", "enterotoxin", "(", "SE", ")", "induce", "a", "rapid", ",", "gradually", "accumulating", ",", "long-lasting", "tyrosine", ",", "and", "serine", "phosphorylation", "of", "Stat3", "(", "but", "not", "Stat5", ")", "in", "allogen-specific", "human", "CD4+", "T", "cell", "lines", "."], "doc_id": "MEDLINE:99369970", "sent_id": "MEDLINE:99369970-2", "entity_mentions": [{"start": 29, "end": 30, "entity_type": "protein", "text": "Stat3"}, {"start": 33, "end": 34, "entity_type": "protein", "text": "Stat5"}, {"start": 36, "end": 42, "entity_type": "cell_line", "text": "allogen-specific human CD4+ T cell lines"}]}
{"tokens": ["In", "contrast", ",", "IL-2", "induces", "a", "rapid", "and", "transient", "tyrosine", "and", "serine", "phosphorylation", "of", "Stat3", "."], "doc_id": "MEDLINE:99369970", "sent_id": "MEDLINE:99369970-3", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "IL-2"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "Stat3"}]}
{"tokens": ["Compared", "with", "IL-2", ",", "CD3", "ligation", "induces", "a", "delayed", "Stat3", "binding", "to", "oligonucleotide", "probes", "from", "the", "ICAM-1", "and", "IL-2R", "alpha", "promoter", "."], "doc_id": "MEDLINE:99369970", "sent_id": "MEDLINE:99369970-4", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "IL-2"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "CD3"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "Stat3"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "ICAM-1"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "IL-2R alpha"}, {"start": 18, "end": 21, "entity_type": "DNA", "text": "IL-2R alpha promoter"}]}
{"tokens": ["CD3", "-mediated", "activation", "of", "Stat3", "is", "almost", "completely", "inhibited", "by", "a", "Src", "kinase", "inhibitor", "(", "PP1", ")", ",", "whereas", "IL-2", "-induced", "Stat3", "activation", "is", "unaffected", "."], "doc_id": "MEDLINE:99369970", "sent_id": "MEDLINE:99369970-5", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "CD3"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "Stat3"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "Src kinase inhibitor"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "PP1"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-2"}, {"start": 21, "end": 22, "entity_type": "protein", "text": "Stat3"}]}
