{"tokens": ["Specific", "glucocorticoid", "binding", "at", "different", "levels", "of", "human", "motor", "activity", "."], "doc_id": "MEDLINE:98379823", "sent_id": "MEDLINE:98379823-0", "entity_mentions": []}
{"tokens": ["We", "studied", "the", "number", "of", "glucocorticoid", "receptors", "and", "dissociation", "constant", "in", "isolated", "human", "lymphocytes", "as", "well", "as", "blood", "concentrations", "of", "hormones", "produced", "by", "the", "hypothalamic-hypophyseal-adrenocortical", "system", "in", "three", "experimental", "series", ":", "at", "normal", "(", "17", "subjects", ")", ",", "decreased", "(", "10", "subjects", ",", "a", "360-d", "head-down", "bed", "rest", ")", "and", "increased", "(", "8", "subjects", ",", "physical", "exercise", "on", "bicycle", "ergometer", ")", "levels", "of", "motor", "activity", "."], "doc_id": "MEDLINE:98379823", "sent_id": "MEDLINE:98379823-1", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "glucocorticoid receptors"}, {"start": 11, "end": 14, "entity_type": "cell_type", "text": "isolated human lymphocytes"}]}
{"tokens": ["In", "the", "first", "series", "we", "found", "that", "the", "number", "of", "glucocorticoid", "receptors", "and", "dissociation", "constant", "did", "not", "depend", "on", "the", "season", ",", "on", "the", "age", "of", "subjects", "nor", "on", "cortisol", "concentrations", "in", "blood", "."], "doc_id": "MEDLINE:98379823", "sent_id": "MEDLINE:98379823-2", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "protein", "text": "glucocorticoid receptors"}]}
{"tokens": ["In", "the", "second", "series", "we", "observed", "the", "following", ":", "at", "the", "end", "of", "the", "first", "month", "of", "bed", "rest", "the", "number", "of", "glucocorticoid", "receptors", "and", "receptor", "affinity", "significantly", "increased", ";", "at", "the", "beginning", "of", "the", "third", "month", "of", "bed", "rest", "specific", "glucocorticoid", "binding", "significantly", "decreased", "and", "circadian", "rhythms", "of", "adrenocorticotropin", "and", "cortisol", "in", "blood", "varied", "markedly", ";", "at", "the", "end", "of", "the", "sixth", "month", "of", "bed", "rest", "the", "number", "of", "glucocorticoid", "receptors", "returned", "to", "prebed", "rest", "levels", "and", "dissociation", "constant", "decreased", "."], "doc_id": "MEDLINE:98379823", "sent_id": "MEDLINE:98379823-3", "entity_mentions": [{"start": 22, "end": 24, "entity_type": "protein", "text": "glucocorticoid receptors"}, {"start": 70, "end": 72, "entity_type": "protein", "text": "glucocorticoid receptors"}]}
