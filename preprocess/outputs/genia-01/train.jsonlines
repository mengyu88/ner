{"tokens": ["However", ",", "PDTC", "failed", "to", "inhibit", "the", "endonuclease", "activity", "contained", "in", "the", "whole", "cell", "lysates", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-4", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "endonuclease"}]}
{"tokens": ["The", "inhibitory", "effect", "of", "PDTC", "was", "also", "observed", "in", "etoposide", "-", "and", "dexamethasone-induced", "apoptosis", "in", "human", "thymocytes", "at", "a", "concentration", "of", "1-10", "microM", "."], "doc_id": "MEDLINE:95077537", "sent_id": "MEDLINE:95077537-5", "entity_mentions": [{"start": 16, "end": 17, "entity_type": "cell_type", "text": "thymocytes"}, {"start": 15, "end": 17, "entity_type": "cell_type", "text": "human thymocytes"}]}
