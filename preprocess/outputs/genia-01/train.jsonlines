{"tokens": ["We", "report", "that", "both", "YY1", "and", "LSF", "participate", "in", "the", "formation", "of", "a", "complex", "that", "recognizes", "the", "initiation", "region", "of", "the", "HIV-1", "LTR", "."], "doc_id": "MEDLINE:98037648", "sent_id": "MEDLINE:98037648-5", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "YY1"}, {"start": 6, "end": 7, "entity_type": "protein", "text": "LSF"}, {"start": 21, "end": 23, "entity_type": "DNA", "text": "HIV-1 LTR"}]}
