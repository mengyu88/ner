{"tokens": ["In", "contrast", "to", "PU.1", ",", "significant", "levels", "of", "Spi-B", "mRNA", "and", "protein", "are", "found", "only", "in", "some", "B-cell", "lines", "and", "spleen", "but", "are", "not", "found", "in", "myeloid", "cell", "lines", ",", "neutrophils", ",", "or", "macrophages", "."], "doc_id": "MEDLINE:95261059", "sent_id": "MEDLINE:95261059-6", "entity_mentions": [{"start": 3, "end": 4, "entity_type": "protein", "text": "PU.1"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "Spi-B"}, {"start": 8, "end": 10, "entity_type": "RNA", "text": "Spi-B mRNA"}, {"start": 17, "end": 19, "entity_type": "cell_line", "text": "B-cell lines"}, {"start": 26, "end": 29, "entity_type": "cell_line", "text": "myeloid cell lines"}, {"start": 30, "end": 31, "entity_type": "cell_type", "text": "neutrophils"}, {"start": 33, "end": 34, "entity_type": "cell_type", "text": "macrophages"}]}
