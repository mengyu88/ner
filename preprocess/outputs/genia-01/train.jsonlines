{"tokens": ["We", "propose", "that", ",", "in", "resting", "cells", ",", "NFAT", "is", "targeted", "to", "a", "region", "of", "the", "calcineurin", "catalytic", "domain", "that", "does", "not", "overlap", "the", "calcineurin", "active", "site", "."], "doc_id": "MEDLINE:98395103", "sent_id": "MEDLINE:98395103-8", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "cell_type", "text": "resting cells"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "NFAT"}, {"start": 16, "end": 17, "entity_type": "protein", "text": "calcineurin"}, {"start": 16, "end": 19, "entity_type": "protein", "text": "calcineurin catalytic domain"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "calcineurin"}, {"start": 24, "end": 27, "entity_type": "protein", "text": "calcineurin active site"}]}
