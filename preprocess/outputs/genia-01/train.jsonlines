{"tokens": ["Stat3gamma", "is", "derived", "from", "Stat3alpha", "by", "limited", "proteolysis", "and", "lacks", "the", "carboxyl-terminal", "portion", "of", "Stat3alpha", "."], "doc_id": "MEDLINE:99039380", "sent_id": "MEDLINE:99039380-6", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Stat3gamma"}, {"start": 4, "end": 5, "entity_type": "protein", "text": "Stat3alpha"}, {"start": 11, "end": 13, "entity_type": "protein", "text": "carboxyl-terminal portion"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "Stat3alpha"}]}
