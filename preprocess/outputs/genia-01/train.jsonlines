{"tokens": ["Together", ",", "these", "results", "demonstrate", "that", "ER", "and", "PR", "can", "be", "activated", "by", "endogenous", "or", "exogenous", "ligands", "to", "induce", "a", "genetic", "response", "that", "impairs", "TNF-alpha", "-induced", "apoptosis", "in", "U937", "cells", "."], "doc_id": "MEDLINE:99242545", "sent_id": "MEDLINE:99242545-10", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "ER"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "PR"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "TNF-alpha"}, {"start": 28, "end": 30, "entity_type": "cell_line", "text": "U937 cells"}]}
