{"tokens": ["Ehrlichia", "chaffeensis", "is", "an", "obligatory", "intracellular", "bacterium", "that", "infects", "monocytes", "and", "macrophages", "and", "is", "the", "etiologic", "agent", "of", "human", "ehrlichiosis", "in", "the", "United", "States", "."], "doc_id": "MEDLINE:97342767", "sent_id": "MEDLINE:97342767-1", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "cell_type", "text": "monocytes"}, {"start": 11, "end": 12, "entity_type": "cell_type", "text": "macrophages"}]}
{"tokens": ["Our", "previous", "studies", "showed", "that", "the", "exposure", "of", "human", "monocytes", "to", "E.", "chaffeensis", "induces", "the", "expression", "of", "interleukin-1beta", "(", "IL-1beta", ")", ",", "IL-8", ",", "and", "IL-10", "genes", "in", "vitro", "but", "not", "the", "expression", "of", "tumor", "necrosis", "factor", "alpha", "(", "TNF-alpha", ")", "and", "IL-6", "mRNAs", "."], "doc_id": "MEDLINE:97342767", "sent_id": "MEDLINE:97342767-2", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "cell_type", "text": "monocytes"}, {"start": 8, "end": 10, "entity_type": "cell_type", "text": "human monocytes"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "interleukin-1beta"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "IL-1beta"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "IL-8"}, {"start": 25, "end": 26, "entity_type": "protein", "text": "IL-10"}, {"start": 25, "end": 27, "entity_type": "DNA", "text": "IL-10 genes"}]}
