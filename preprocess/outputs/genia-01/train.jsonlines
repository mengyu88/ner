{"tokens": ["Furthermore", ",", "Tax", "-induced", "transactivation", "of", "the", "bcl-x", "promoter", "was", "also", "diminished", "by", "the", "mutant", "IkappaBalpha", ",", "which", "specifically", "inhibits", "NF-kappaB", "activity", "."], "doc_id": "MEDLINE:99412310", "sent_id": "MEDLINE:99412310-8", "entity_mentions": [{"start": 2, "end": 3, "entity_type": "protein", "text": "Tax"}, {"start": 7, "end": 9, "entity_type": "DNA", "text": "bcl-x promoter"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "mutant IkappaBalpha"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "NF-kappaB"}]}
