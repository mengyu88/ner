{"tokens": ["The", "70", "kDa", "heat", "shock", "protein", "(", "Hsp70", ")", "is", "a", "highly", "conserved", ",", "ubiquitous", "protein", "involved", "in", "chaperoning", "proteins", "to", "various", "cellular", "organelles", "."], "doc_id": "MEDLINE:99107757", "sent_id": "MEDLINE:99107757-1", "entity_mentions": [{"start": 1, "end": 6, "entity_type": "protein", "text": "70 kDa heat shock protein"}, {"start": 7, "end": 8, "entity_type": "protein", "text": "Hsp70"}, {"start": 14, "end": 16, "entity_type": "protein", "text": "ubiquitous protein"}, {"start": 18, "end": 20, "entity_type": "protein", "text": "chaperoning proteins"}]}
{"tokens": ["Here", "we", "show", "that", "when", "added", "exogenously", "to", "cells", ",", "Hsp70", "is", "readily", "imported", "into", "both", "cytoplasmic", "and", "nuclear", "compartments", "in", "a", "cell-type-specific", "fashion", "."], "doc_id": "MEDLINE:99107757", "sent_id": "MEDLINE:99107757-2", "entity_mentions": [{"start": 10, "end": 11, "entity_type": "protein", "text": "Hsp70"}]}
