{"tokens": ["We", "have", "investigated", "an", "oxidoreductive", "regulatory", "pathway", "for", "the", "DNA", "binding", "activity", "of", "a", "pleiotropic", "cellular", "transcription", "factor", ",", "nuclear", "factor", "kappa", "B", "(", "NF", "kappa", "B", ")", ",", "has", "been", "investigated", "by", "using", "NF", "kappa", "B", "prepared", "from", "the", "nucleus", "and", "the", "cytosol", "of", "the", "primary", "human", "T", "lymphocytes", "."], "doc_id": "MEDLINE:93266597", "sent_id": "MEDLINE:93266597-2", "entity_mentions": [{"start": 14, "end": 18, "entity_type": "protein", "text": "pleiotropic cellular transcription factor"}, {"start": 19, "end": 23, "entity_type": "protein", "text": "nuclear factor kappa B"}, {"start": 24, "end": 27, "entity_type": "protein", "text": "NF kappa B"}, {"start": 34, "end": 37, "entity_type": "protein", "text": "NF kappa B"}, {"start": 46, "end": 50, "entity_type": "cell_type", "text": "primary human T lymphocytes"}]}
{"tokens": ["We", "show", "that", "a", "cellular", "reducing", "catalyst", "thioredoxin", "(", "Trx", ")", "plays", "a", "major", "role", "in", "activation", "of", "the", "DNA", "binding", "of", "NF", "kappa", "B", "in", "vitro", "and", "stimulation", "of", "transcription", "from", "the", "NF", "kappa", "B", "-dependent", "gene", "expression", "."], "doc_id": "MEDLINE:93266597", "sent_id": "MEDLINE:93266597-3", "entity_mentions": [{"start": 7, "end": 8, "entity_type": "protein", "text": "thioredoxin"}, {"start": 9, "end": 10, "entity_type": "protein", "text": "Trx"}, {"start": 22, "end": 25, "entity_type": "protein", "text": "NF kappa B"}, {"start": 33, "end": 36, "entity_type": "protein", "text": "NF kappa B"}]}
{"tokens": ["We", "demonstrate", "evidence", "suggesting", "that", "redox", "regulation", "of", "NF", "kappa", "B", "by", "Trx", "might", "be", "exerted", "at", "a", "step", "after", "dissociation", "of", "the", "inhibitory", "molecule", "I", "kappa", "B", ",", "a", "cytosolic-anchoring", "protein", "for", "NF", "kappa", "B", "."], "doc_id": "MEDLINE:93266597", "sent_id": "MEDLINE:93266597-4", "entity_mentions": [{"start": 8, "end": 11, "entity_type": "protein", "text": "NF kappa B"}, {"start": 12, "end": 13, "entity_type": "protein", "text": "Trx"}, {"start": 25, "end": 28, "entity_type": "protein", "text": "I kappa B"}, {"start": 30, "end": 32, "entity_type": "protein", "text": "cytosolic-anchoring protein"}, {"start": 33, "end": 36, "entity_type": "protein", "text": "NF kappa B"}]}
{"tokens": ["To", "examine", "the", "effect", "of", "Trx", "in", "intact", "cells", ",", "we", "performed", "transient", "assay", "with", "a", "chloramphenicol", "acetyltransferase", "-expressing", "plasmid", "under", "the", "control", "of", "human", "immunodeficiency", "virus", "(", "HIV", ")", "long", "terminal", "repeat", "and", "an", "effector", "plasmid", "expressing", "human", "Trx", "."], "doc_id": "MEDLINE:93266597", "sent_id": "MEDLINE:93266597-5", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "Trx"}, {"start": 16, "end": 18, "entity_type": "protein", "text": "chloramphenicol acetyltransferase"}, {"start": 16, "end": 20, "entity_type": "DNA", "text": "chloramphenicol acetyltransferase -expressing plasmid"}, {"start": 24, "end": 33, "entity_type": "DNA", "text": "human immunodeficiency virus ( HIV ) long terminal repeat"}, {"start": 35, "end": 37, "entity_type": "DNA", "text": "effector plasmid"}, {"start": 38, "end": 40, "entity_type": "protein", "text": "human Trx"}]}
{"tokens": ["The", "promoter", "activity", "from", "HIV", "long", "terminal", "repeat", "was", "greatly", "augmented", "by", "co-transfecting", "the", "Trx-expressing", "plasmid", ",", "whose", "effect", "was", "dependent", "on", "the", "NF", "kappa", "B", "-binding", "sites", "."], "doc_id": "MEDLINE:93266597", "sent_id": "MEDLINE:93266597-6", "entity_mentions": [{"start": 4, "end": 8, "entity_type": "DNA", "text": "HIV long terminal repeat"}, {"start": 14, "end": 16, "entity_type": "DNA", "text": "Trx-expressing plasmid"}, {"start": 23, "end": 26, "entity_type": "protein", "text": "NF kappa B"}]}
