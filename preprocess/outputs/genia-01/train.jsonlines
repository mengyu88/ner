{"tokens": ["Subcellular", "localization", "analysis", "in", "various", "cells", ",", "using", "a", "specific", "monoclonal", "antibody", "raised", "against", "SR-BP", ",", "demonstrated", "that", "this", "protein", "was", "associated", "with", "the", "nuclear", "envelope", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-9", "entity_mentions": [{"start": 9, "end": 12, "entity_type": "protein", "text": "specific monoclonal antibody"}, {"start": 14, "end": 15, "entity_type": "protein", "text": "SR-BP"}]}
{"tokens": ["When", "studying", "the", "binding", "of", "SR", "31747A", "on", "membranes", "from", "yeast", "expressing", "SR-BP", ",", "we", "found", "a", "pharmacological", "profile", "of", "sigma", "1", "receptors", ";", "binding", "was", "displaced", "by", "(+)-pentazocine", ",", "haloperidol", ",", "and", "(+)-SKF", "10,047", ",", "with", "(+)-SKF", "10, 047", "being", "a", "more", "potent", "competitor", "than", "(-)-SKF", "10,047", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-10", "entity_mentions": [{"start": 12, "end": 13, "entity_type": "protein", "text": "SR-BP"}, {"start": 20, "end": 23, "entity_type": "protein", "text": "sigma 1 receptors"}]}
{"tokens": ["Scatchard", "plot", "analysis", "revealed", "Kd", "values", "of", "7.1", "nM", "and", "0.15", "nM", "for", "(+)-pentazocine", "and", "SR", "31747A", ",", "respectively", ",", "indicating", "an", "affinity", "of", "SR-BP", "50-fold", "higher", "for", "SR", "31747A", "than", "for", "pentazocine", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-11", "entity_mentions": [{"start": 24, "end": 25, "entity_type": "protein", "text": "SR-BP"}]}
{"tokens": ["Additionally", ",", "we", "showed", "that", "pentazocine", ",", "a", "competitive", "inhibitor", "of", "SR", "31747A", "binding", ",", "also", "prevents", "the", "immunosuppressive", "effect", "of", "SR", "31747A", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-12", "entity_mentions": []}
{"tokens": ["Taken", "together", ",", "these", "findings", "strongly", "suggest", "that", "SR-BP", "represents", "the", "molecular", "target", "for", "SR", "31747A", "in", "mammalian", "tissues", ",", "which", "could", "be", "critical", "for", "T", "cell", "proliferation", "."], "doc_id": "MEDLINE:98001686", "sent_id": "MEDLINE:98001686-13", "entity_mentions": [{"start": 8, "end": 9, "entity_type": "protein", "text": "SR-BP"}]}
