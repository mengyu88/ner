{"tokens": ["Rel", "/NF-kappa", "B", "is", "a", "ubiquitous", "transcription", "factor", "that", "consists", "of", "multiple", "polypeptide", "subunits", ",", "and", "is", "subject", "to", "complex", "regulatory", "mechanisms", "that", "involve", "protein-protein", "interactions", ",", "phosphorylation", ",", "ubiquitination", ",", "proteolytic", "degradation", ",", "and", "nucleocytoplasmic", "translocation", "."], "doc_id": "MEDLINE:97445684", "sent_id": "MEDLINE:97445684-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Rel"}, {"start": 1, "end": 3, "entity_type": "protein", "text": "/NF-kappa B"}, {"start": 0, "end": 3, "entity_type": "protein", "text": "Rel /NF-kappa B"}, {"start": 6, "end": 8, "entity_type": "protein", "text": "transcription factor"}, {"start": 5, "end": 8, "entity_type": "protein", "text": "ubiquitous transcription factor"}, {"start": 11, "end": 14, "entity_type": "protein", "text": "multiple polypeptide subunits"}]}
{"tokens": ["The", "sophisticated", "control", "of", "Rel", "/NF-kappa", "B", "activity", "is", "not", "surprising", "since", "this", "transcription", "factor", "is", "involved", "in", "a", "wide", "array", "of", "cellular", "responses", "to", "extracellular", "cues", ",", "associated", "with", "growth", ",", "development", ",", "apoptosis", ",", "and", "pathogen", "invasion", "."], "doc_id": "MEDLINE:97445684", "sent_id": "MEDLINE:97445684-2", "entity_mentions": [{"start": 4, "end": 5, "entity_type": "protein", "text": "Rel"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "/NF-kappa B"}, {"start": 4, "end": 7, "entity_type": "protein", "text": "Rel /NF-kappa B"}, {"start": 13, "end": 15, "entity_type": "protein", "text": "transcription factor"}]}
{"tokens": ["Thus", ",", "it", "is", "not", "unexpected", "that", "this", "versatile", "cellular", "homeostatic", "switch", "would", "be", "affected", "by", "a", "variety", "of", "viral", "pathogens", ",", "which", "have", "evolved", "mechanisms", "to", "utilize", "various", "aspects", "of", "Rel", "/NF-kappa", "B", "activity", "to", "facilitate", "their", "replication", ",", "cell", "survival", "and", "possibly", "evasion", "of", "immune", "responses", "."], "doc_id": "MEDLINE:97445684", "sent_id": "MEDLINE:97445684-3", "entity_mentions": [{"start": 31, "end": 32, "entity_type": "protein", "text": "Rel"}, {"start": 32, "end": 34, "entity_type": "protein", "text": "/NF-kappa B"}, {"start": 31, "end": 34, "entity_type": "protein", "text": "Rel /NF-kappa B"}]}
{"tokens": ["This", "review", "will", "cover", "the", "molecular", "mechanisms", "that", "are", "utilized", "by", "mammalian", "oncogenic", "viruses", "to", "affect", "the", "activity", "of", "Rel/", "NF-kappa", "B", "transcription", "factors", "and", "the", "role", "of", "Rel", "/NF-kappa", "B", "in", "the", "regulation", "of", "viral", "gene", "expression", "and", "replication", "."], "doc_id": "MEDLINE:97445684", "sent_id": "MEDLINE:97445684-4", "entity_mentions": [{"start": 20, "end": 22, "entity_type": "protein", "text": "NF-kappa B"}, {"start": 19, "end": 22, "entity_type": "protein", "text": "Rel/ NF-kappa B"}, {"start": 22, "end": 24, "entity_type": "protein", "text": "transcription factors"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "Rel"}, {"start": 29, "end": 31, "entity_type": "protein", "text": "/NF-kappa B"}, {"start": 28, "end": 31, "entity_type": "protein", "text": "Rel /NF-kappa B"}]}
