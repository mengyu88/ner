{"tokens": ["Whereas", "GRalpha", "is", "a", "hormone-activated", "transcription", "factor", ",", "GRbeta", "does", "not", "bind", "glucocorticoids", "(", "GCs", ")", ",", "is", "transcriptionally", "inactive", ",", "and", "is", "a", "potential", "inhibitor", "of", "activated", "GRalpha", "."], "doc_id": "MEDLINE:99120900", "sent_id": "MEDLINE:99120900-2", "entity_mentions": [{"start": 1, "end": 2, "entity_type": "protein", "text": "GRalpha"}, {"start": 5, "end": 7, "entity_type": "protein", "text": "transcription factor"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "GRbeta"}, {"start": 28, "end": 29, "entity_type": "protein", "text": "GRalpha"}]}
