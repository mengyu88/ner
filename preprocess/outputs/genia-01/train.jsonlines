{"tokens": ["Moreover", ",", "the", "effects", "of", "IFN-gamma", "and", "LPS", "could", "be", "reproduced", "by", "priming", ",", "whereas", "IFN-beta", "and", "IL-4", "were", "required", "simultaneously", "with", "GC", "."], "doc_id": "MEDLINE:96413262", "sent_id": "MEDLINE:96413262-9", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "IFN-gamma"}, {"start": 15, "end": 16, "entity_type": "protein", "text": "IFN-beta"}, {"start": 17, "end": 18, "entity_type": "protein", "text": "IL-4"}]}
