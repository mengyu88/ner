{"tokens": ["Here", ",", "we", "report", "that", "PU.1", "mRNA", "is", "upregulated", "during", "myeloid", "differentiation", "of", "human", "purified", "CD34+", "cells", "and", "murine", "multipotential", "FDCP-mix", "A4", "cells", ",", "suggesting", "that", "PU.1", "is", "upregulated", "as", "an", "early", "event", "during", "differentiation", "of", "multipotential", "progenitor", "cells", "."], "doc_id": "MEDLINE:95261059", "sent_id": "MEDLINE:95261059-3", "entity_mentions": [{"start": 5, "end": 6, "entity_type": "protein", "text": "PU.1"}, {"start": 5, "end": 7, "entity_type": "RNA", "text": "PU.1 mRNA"}, {"start": 13, "end": 17, "entity_type": "cell_line", "text": "human purified CD34+ cells"}, {"start": 18, "end": 23, "entity_type": "cell_line", "text": "murine multipotential FDCP-mix A4 cells"}, {"start": 26, "end": 27, "entity_type": "protein", "text": "PU.1"}, {"start": 36, "end": 39, "entity_type": "cell_type", "text": "multipotential progenitor cells"}]}
{"tokens": ["PU.1", "expression", "is", "maintained", "at", "stable", "levels", "during", "differentiation", "of", "myeloid", "cell", "lines", "U937", "and", "HL-60", "to", "monocytic", "and", "neutrophilic", "cells", "."], "doc_id": "MEDLINE:95261059", "sent_id": "MEDLINE:95261059-4", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "PU.1"}, {"start": 10, "end": 13, "entity_type": "cell_line", "text": "myeloid cell lines"}, {"start": 13, "end": 14, "entity_type": "cell_line", "text": "U937"}, {"start": 15, "end": 16, "entity_type": "cell_line", "text": "HL-60"}]}
