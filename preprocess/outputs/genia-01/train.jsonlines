{"tokens": ["Heat-shock", "and", "cadmium", "chloride", "increase", "the", "vimentin", "mRNA", "and", "protein", "levels", "in", "U-937", "human", "promonocytic", "cells", "."], "doc_id": "MEDLINE:97196961", "sent_id": "MEDLINE:97196961-0", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Heat-shock"}, {"start": 12, "end": 16, "entity_type": "cell_line", "text": "U-937 human promonocytic cells"}]}
{"tokens": ["Heat-shock", "for", "2", "hours", "at", "42", "degrees", "C", ",", "or", "the", "administration", "for", "3", "hours", "of", "100", "or", "150", "microM", "cadmium", "chloride", ",", "inhibited", "the", "subsequent", "proliferation", "activity", ",", "induced", "the", "expression", "of", "functional", "differentiation", "markers", ",", "and", "caused", "an", "increase", "in", "the", "amount", "of", "the", "stress-responsive", "HSP70", "protein", "in", "U-937", "human", "promonocytic", "cells", "."], "doc_id": "MEDLINE:97196961", "sent_id": "MEDLINE:97196961-1", "entity_mentions": [{"start": 0, "end": 1, "entity_type": "protein", "text": "Heat-shock"}, {"start": 25, "end": 28, "entity_type": "cell_line", "text": "subsequent proliferation activity"}, {"start": 34, "end": 36, "entity_type": "protein", "text": "differentiation markers"}, {"start": 46, "end": 49, "entity_type": "protein", "text": "stress-responsive HSP70 protein"}, {"start": 50, "end": 54, "entity_type": "cell_line", "text": "U-937 human promonocytic cells"}]}
{"tokens": ["In", "addition", ",", "both", "heat", "and", "cadmium", "produced", "an", "increase", "in", "the", "amount", "of", "the", "intermediate", "filament", "protein", "vimentin", ",", "as", "determined", "by", "immunoblot", "and", "immunofluorescence", "assays", "."], "doc_id": "MEDLINE:97196961", "sent_id": "MEDLINE:97196961-2", "entity_mentions": [{"start": 15, "end": 18, "entity_type": "protein", "text": "intermediate filament protein"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "vimentin"}]}
