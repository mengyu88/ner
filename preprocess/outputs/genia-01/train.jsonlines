{"tokens": ["Members", "of", "the", "recently", "discovered", "SOCS/CIS/SSI", "family", "have", "been", "proposed", "as", "regulators", "of", "cytokine", "signaling", ",", "and", "while", "targets", "and", "mechanisms", "have", "been", "suggested", "for", "some", "family", "members", ",", "the", "precise", "role", "of", "these", "proteins", "remains", "to", "be", "defined", "."], "doc_id": "MEDLINE:99303791", "sent_id": "MEDLINE:99303791-1", "entity_mentions": [{"start": 5, "end": 7, "entity_type": "protein", "text": "SOCS/CIS/SSI family"}, {"start": 13, "end": 14, "entity_type": "protein", "text": "cytokine"}]}
