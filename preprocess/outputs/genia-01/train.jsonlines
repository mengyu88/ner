{"tokens": ["In", "the", "present", "study", "we", "focused", "on", "the", "pathophysiology", "of", "PIH", ",", "mainly", "on", "the", "role", "of", "mineralocorticoids", ",", "reversed", "blood", "pressure", "patterns", ",", "and", "the", "resulting", "necessity", "of", "continuous", "monitoring", "of", "the", "preeclamptic", "mother", "."], "doc_id": "MEDLINE:93244226", "sent_id": "MEDLINE:93244226-2", "entity_mentions": []}
