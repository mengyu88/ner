{"tokens": ["Thus", "CTL", "clones", "that", "recognized", "the", "viral", ",", "self", ",", "and", "bacterial", "peptides", "expressed", "a", "highly", "restricted", "alphabeta", "TCR", "phenotype", "."], "doc_id": "MEDLINE:99162595", "sent_id": "MEDLINE:99162595-3", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "CTL clones"}, {"start": 18, "end": 19, "entity_type": "protein", "text": "TCR"}]}
{"tokens": ["The", "CTL", "clones", "that", "recognized", "viral", "and", "self", "peptides", "were", "more", "oligoclonal", ",", "whereas", "clones", "that", "strictly", "recognized", "the", "viral", "peptide", "displayed", "a", "diverse", "TCR", "profile", "."], "doc_id": "MEDLINE:99162595", "sent_id": "MEDLINE:99162595-4", "entity_mentions": [{"start": 1, "end": 3, "entity_type": "cell_line", "text": "CTL clones"}, {"start": 24, "end": 25, "entity_type": "protein", "text": "TCR"}]}
{"tokens": ["Interestingly", ",", "the", "self", "and", "bacterial", "peptides", "equally", "were", "substantially", "less", "effective", "than", "the", "cognate", "viral", "peptide", "in", "sensitizing", "target", "cell", "lysis", ",", "and", "also", "resulted", "only", "in", "a", "weak", "reactivation", "of", "memory", "CTLs", "in", "limiting", "dilution", "assays", ",", "whereas", "the", "cognate", "peptide", "was", "highly", "immunogenic", "."], "doc_id": "MEDLINE:99162595", "sent_id": "MEDLINE:99162595-5", "entity_mentions": [{"start": 32, "end": 34, "entity_type": "cell_type", "text": "memory CTLs"}]}
{"tokens": ["The", "described", "crossreactions", "show", "that", "human", "antiviral", ",", "CD8(+)", "CTL", "responses", "can", "be", "shaped", "by", "peptide", "ligands", "derived", "from", "autoantigens", "and", "environmental", "bacterial", "antigens", ",", "thereby", "providing", "a", "firm", "structural", "basis", "for", "molecular", "mimicry", "involving", "class", "I-restricted", "CTLs", "in", "the", "pathogenesis", "of", "autoimmune", "disease", "."], "doc_id": "MEDLINE:99162595", "sent_id": "MEDLINE:99162595-6", "entity_mentions": [{"start": 36, "end": 38, "entity_type": "cell_line", "text": "I-restricted CTLs"}]}
