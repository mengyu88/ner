{"tokens": ["In", "this", "paper", ",", "the", "expression", "of", "this", "gene", "in", "blood", "cells", "was", "first", "investigated", "in", "fractions", "of", "nucleated", "cells", ",", "revealing", "predominant", "expression", "of", "the", "Ah", "receptor", "gene", "in", "the", "monocyte", "fraction", "."], "doc_id": "MEDLINE:95308691", "sent_id": "MEDLINE:95308691-2", "entity_mentions": [{"start": 10, "end": 12, "entity_type": "cell_type", "text": "blood cells"}, {"start": 18, "end": 20, "entity_type": "cell_type", "text": "nucleated cells"}, {"start": 26, "end": 28, "entity_type": "protein", "text": "Ah receptor"}, {"start": 26, "end": 29, "entity_type": "DNA", "text": "Ah receptor gene"}, {"start": 31, "end": 33, "entity_type": "cell_type", "text": "monocyte fraction"}]}
