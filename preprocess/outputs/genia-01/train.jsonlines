{"tokens": ["B-CLL", "cells", "do", "express", "receptors", "for", "interferon-alpha", "(", "IFN-alpha", ")", "and", "IFN-gamma", ",", "and", "activation", "of", "both", "has", "been", "shown", "to", "promote", "B-CLL", "survival", "in", "vitro", "by", "preventing", "apoptosis", "."], "doc_id": "MEDLINE:97309442", "sent_id": "MEDLINE:97309442-3", "entity_mentions": [{"start": 6, "end": 7, "entity_type": "protein", "text": "interferon-alpha"}, {"start": 8, "end": 9, "entity_type": "protein", "text": "IFN-alpha"}, {"start": 11, "end": 12, "entity_type": "protein", "text": "IFN-gamma"}]}
