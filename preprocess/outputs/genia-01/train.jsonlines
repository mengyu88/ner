{"tokens": ["This", "investigation", "was", "undertaken", "to", "determine", "the", "composition", "of", "StatG", "in", "mature", "normal", "human", "myeloid", "cells", ",", "i.e.", "polymorphonuclear", "neutrophilic", "granulocytes", "(", "PMN", ")", "."], "doc_id": "MEDLINE:99039380", "sent_id": "MEDLINE:99039380-4", "entity_mentions": [{"start": 9, "end": 10, "entity_type": "protein", "text": "StatG"}, {"start": 11, "end": 16, "entity_type": "cell_type", "text": "mature normal human myeloid cells"}, {"start": 18, "end": 21, "entity_type": "cell_type", "text": "polymorphonuclear neutrophilic granulocytes"}, {"start": 22, "end": 23, "entity_type": "cell_type", "text": "PMN"}]}
