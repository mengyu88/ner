{"tokens": ["Accordingly", ",", "electrophoretic", "mobility", "shift", "assays", "(", "EMSAs", ")", "indicated", "that", "pyrrolidine", "DTC", "(", "PDTC", ")", "prevented", "NF-kappaB", ",", "and", "NFAT", "DNA-binding", "activity", "in", "T", "cells", "stimulated", "with", "either", "phorbol", "myristate", "acetate", "plus", "ionophore", "or", "antibodies", "against", "the", "CD3-T-cell", "receptor", "complex", "and", "simultaneously", "activated", "the", "binding", "of", "AP-1", "."], "doc_id": "MEDLINE:98001571", "sent_id": "MEDLINE:98001571-5", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "NF-kappaB"}, {"start": 20, "end": 21, "entity_type": "protein", "text": "NFAT"}, {"start": 24, "end": 26, "entity_type": "cell_type", "text": "T cells"}, {"start": 38, "end": 41, "entity_type": "protein", "text": "CD3-T-cell receptor complex"}, {"start": 47, "end": 48, "entity_type": "protein", "text": "AP-1"}]}
{"tokens": ["Furthermore", ",", "PDTC", "differentially", "targeted", "both", "NFATp", "and", "NFATc", "family", "members", ",", "inhibiting", "the", "transactivation", "functions", "of", "NFATp", "and", "mRNA", "induction", "of", "NFATc", "."], "doc_id": "MEDLINE:98001571", "sent_id": "MEDLINE:98001571-6", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "NFATp"}, {"start": 22, "end": 23, "entity_type": "protein", "text": "NFATc"}]}
{"tokens": ["Strikingly", ",", "Western", "blotting", "and", "immunocytochemical", "experiments", "indicated", "that", "PDTC", "promoted", "a", "transient", "and", "rapid", "shuttling", "of", "NFATp", "and", "NFATc", ",", "leading", "to", "their", "accelerated", "export", "from", "the", "nucleus", "of", "activated", "T", "cells", "."], "doc_id": "MEDLINE:98001571", "sent_id": "MEDLINE:98001571-7", "entity_mentions": [{"start": 17, "end": 18, "entity_type": "protein", "text": "NFATp"}, {"start": 19, "end": 20, "entity_type": "protein", "text": "NFATc"}, {"start": 31, "end": 33, "entity_type": "cell_type", "text": "T cells"}, {"start": 30, "end": 33, "entity_type": "cell_type", "text": "activated T cells"}]}
{"tokens": ["We", "propose", "that", "the", "activation", "of", "an", "NFAT", "kinase", "by", "PDTC", "could", "be", "responsible", "for", "the", "rapid", "shuttling", "of", "the", "NFAT", ",", "therefore", "transiently", "converting", "the", "sustained", "transactivation", "of", "this", "transcription", "factor", "that", "occurs", "during", "lymphocyte", "activation", ",", "and", "show", "that", "c-Jun", "NH2-terminal", "kinase", "(", "JNK", ")", "can", "act", "by", "directly", "phosphorylating", "NFATp", "."], "doc_id": "MEDLINE:98001571", "sent_id": "MEDLINE:98001571-8", "entity_mentions": [{"start": 20, "end": 21, "entity_type": "protein", "text": "NFAT"}, {"start": 30, "end": 32, "entity_type": "protein", "text": "transcription factor"}, {"start": 41, "end": 44, "entity_type": "protein", "text": "c-Jun NH2-terminal kinase"}, {"start": 45, "end": 46, "entity_type": "protein", "text": "JNK"}, {"start": 52, "end": 53, "entity_type": "protein", "text": "NFATp"}]}
