{"tokens": ["In", "the", "present", "study", "we", "focused", "on", "the", "pathophysiology", "of", "PIH", ",", "mainly", "on", "the", "role", "of", "mineralocorticoids", ",", "reversed", "blood", "pressure", "patterns", ",", "and", "the", "resulting", "necessity", "of", "continuous", "monitoring", "of", "the", "preeclamptic", "mother", "."], "entity_mentions": []}
{"tokens": ["Problems", "of", "antihypertensive", "therapy", "are", "discussed", "and", "the", "first", "results", "of", "a", "pilot", "study", "with", "Urapidil", "are", "presented."], "entity_mentions": []}
{"tokens": ["To", "examine", "the", "role", "of", "mineralocorticoids", "in", "the", "pathophysiology", "of", "PIH", ",", "we", "studied", "plasma", "aldosterone", "and", "18-hydroxy-corticosterone", "(", "18-OH-B", ")", "levels", "in", "25", "women", "with", "PIH", "and", "in", "25", "healthy", "pregnant", "women", "."], "entity_mentions": []}
{"tokens": ["Furthermore,", "we", "evaluated", "the", "mineralocorticoid", "receptor", "(", "MR", ")", "count", "in", "mononuclear", "leukocytes", "in", "the", "2", "groups."], "entity_mentions": [{"start": 4, "end": 6, "entity_type": "PROTEIN"}, {"start": 11, "end": 13, "entity_type": "CELL_TYPE"}, {"start": 7, "end": 8, "entity_type": "PROTEIN"}]}
{"tokens": ["The", "MR-count", "was", "significantly", "decreased", "in", "the", "PIH", "-group."], "entity_mentions": []}
