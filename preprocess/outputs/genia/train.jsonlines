{"tokens": ["In", "the", "present", "study,", "we", "demonstrate", "that", "signal-mediated", "induction", "of", "p105", "processing", "in", "human", "T", "cells", "is", "associated", "with", "de", "novo", "synthesis", "of", "this", "precursor", "protein", "."], "entity_mentions": [{"start": 13, "end": 16, "entity_type": "CELL_TYPE"}, {"start": 10, "end": 11, "entity_type": "PROTEIN"}, {"start": 24, "end": 26, "entity_type": "PROTEIN"}]}
