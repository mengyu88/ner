{"tokens": ["These", "results", "cannot", "be", "explained", "by", "receptor", "down-regulation", "due", "to", "higher", "level", "of", "mineralocorticoids", "of", "the", "zona", "glomerulosa", "."], "entity_mentions": []}
{"tokens": ["Perhaps", "deoxycorticosterone", "or", "a", "hitherto", "unknown", "mineralocorticoid", "is", "responsible", "for", "the", "hypertension", "and", "altered", "MR", "-status", "."], "entity_mentions": [{"start": 14, "end": 15, "entity_type": "PROTEIN"}]}
